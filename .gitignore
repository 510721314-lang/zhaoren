# 临时云端测试工具与 smoke 入参
.tmp-cloud-runner/
sm*.json

# Trae skills 已入库(团队共享), 仅本地缓存类文件忽略
.trae/cache/

# IDE 临时文件
.idea/
.vscode/
.DS_Store

# 系统临时文件
Thumbs.db
desktop.ini
node_modules/

# 真机预览产物（每次 preview 都变更，不入库）
/preview-qr.png

# 本地备份目录
.backup-*/

# 微信小程序代码上传密钥（含管理员权限，严禁入库）
/KEY/

# Git Bundle 备份产物（不入仓库，由热备目录留存）
*.bundle
zhaoren_backup_*/

# 云端索引/tcb 临时产物（台账可由 dump-index-ledger 再生，actual 由 tcb-scan 再生）
.tmp-tcb/

# admin-web 前端构建产物（chunk 哈希每次变更；由 scripts/build-admin-web.ps1 生成，部署前构建，不入库）
/cloudfunctions/admin-web/public/*
!/cloudfunctions/admin-web/public/.gitkeep

# html 分享包（一次性会话产物，不入库）
.trae-html-share-packages/

# 本地私有环境变量（含本机绝对路径，不入仓库；.env.example 作为模板入库）
.env
.env.local

# MCP server 本地私有配置（含本机 CLI 绝对路径；.mcp.example.json 模板入库）
.mcp.json
