# 微信开发者工具 CLI 绝对路径（指向 cli.bat）
# Windows 常见位置：
#   C:\Users\<你的用户名>\Desktop\微信WEB开发者工具\cli.bat
#   C:\Program Files (x86)\Tencent\微信web开发者工具\cli.bat
# macOS: /Applications/wechatwebdevtools.app/Contents/MacOS/cli
WX_DEVTOOLS_CLI_PATH=

# 微信小程序项目根目录（project.config.json 所在目录）
# 默认 = 本项目根目录，可留空
WX_PROJECT_PATH=

# CLI auto 模式端口（automator.launch 时由 CLI 自动启动并监听此端口）
# 不要与本机其他服务冲突；留空则由 CLI 自动分配
WX_AUTO_PORT=9420

# 服务端口（仅当使用 automator.connect 连接已启动的 IDE 时需要）
# 在开发者工具 → 设置 → 安全设置 → 服务端口 中开启并查看
WX_SERVICE_PORT=
