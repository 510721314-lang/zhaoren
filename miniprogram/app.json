{
  "entryPagePath": "pages-v2/index/index",
  "pages": [
    "pages-v2/index/index",
    "pages-v2/square/square",
    "pages-v2/message/message",
    "pages-v2/profile/profile",
    "pages-v2/login/login",
    "pages-v2/publish/publish",
    "pages-v2/demand-detail/demand-detail",
    "pages-v2/nearby-list/nearby-list",
    "pages-v2/nearby-map/nearby-map",
    "pages-v2/partner-detail/partner-detail",
    "pages-v2/chat/chat",
    "pages-v2/pay/pay",
    "pages-v2/order-detail/order-detail",
    "pages-v2/workbench/workbench",
    "pages-v2/orders/orders",
    "pages-v2/my-demands/my-demands"
  ],
  "subPackages": [
    {
      "root": "pages-v2/admin",
      "name": "pkgAdmin",
      "pages": [
        "admin",
        "users",
        "partners",
        "demands",
        "orders",
        "finance",
        "config"
      ]
    },
    {
      "root": "pages-v2/agreement",
      "name": "pkgAgreement",
      "pages": [
        "agreement"
      ]
    },
    {
      "root": "pages-v2/privacy",
      "name": "pkgPrivacy",
      "pages": [
        "privacy"
      ]
    },
    {
      "root": "pages-v2/pkg-low",
      "name": "pkgLow",
      "pages": [
        "wallet/wallet",
        "credit/credit",
        "contacts/contacts",
        "notices/notices",
        "partner-apply/partner-apply",
        "partner-profile-edit/partner-profile-edit",
        "accept-config/accept-config",
        "activity-detail/activity-detail",
        "realname/realname",
        "safety/safety",
        "evaluate/evaluate",
        "exam/exam",
        "exam-status/exam-status"
      ]
    }
  ],
  "preloadRule": {
    "pages-v2/login/login": {
      "network": "all",
      "packages": [
        "pkgAgreement",
        "pkgPrivacy"
      ]
    },
    "pages-v2/profile/profile": {
      "network": "all",
      "packages": [
        "pkgLow"
      ]
    }
  },
  "window": {
    "navigationBarBackgroundColor": "#07C160",
    "navigationBarTitleText": "找人帮忙",
    "navigationBarTextStyle": "white",
    "backgroundColor": "#F6F7F9",
    "backgroundTextStyle": "dark"
  },
  "tabBar": {
    "custom": true,
    "color": "#9aa0a6",
    "selectedColor": "#07C160",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "white",
    "list": [
      { "pagePath": "pages-v2/index/index", "text": "首页" },
      { "pagePath": "pages-v2/square/square", "text": "广场" },
      { "pagePath": "pages-v2/message/message", "text": "消息" },
      { "pagePath": "pages-v2/profile/profile", "text": "我的" }
    ]
  },
  "permission": {
    "scope.userLocation": {
      "desc": "用于获取您的实际位置、履约距离提示及安全报备"
    }
  },
  "requiredPrivateInfos": [
    "getLocation",
    "chooseLocation"
  ],
  "style": "v2",
  "lazyCodeLoading": "requiredComponents",
  "sitemapLocation": "sitemap.json",
  "__usePrivacyCheck__": true,
  "usingComponents": {
    "night-mask": "/components/night-mask/index",
    "empty-state": "/components/empty-state/index",
    "bottom-sheet": "/components/bottom-sheet/index"
  }
}
