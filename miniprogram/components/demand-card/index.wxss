.dcard {
  background: var(--bg-card);
  border-radius: var(--r-lg);
  padding: 24rpx 28rpx;
  box-shadow: var(--shadow-card);
  margin-bottom: var(--card-gap);
}
.dcard__tags {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}
.dcard__title {
  margin-top: 12rpx;
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.dcard__desc {
  margin-top: 10rpx;
  font-size: var(--font-base);
  color: var(--text-3);
  line-height: 1.5;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.dcard__meta {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
}
.dcard__meta-item {
  font-size: var(--font-sm);
  color: var(--text-4);
  margin-right: 24rpx;
  margin-bottom: 4rpx;
}
.dcard__publisher {
  margin-top: 10rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--border-divider);
}
.dcard__pub-name {
  font-size: var(--font-sm);
  color: var(--text-4);
}
.dcard__bottom {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.dcard__price {
  display: flex;
  align-items: baseline;
}
.dcard__price-num {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--func-danger);
}
.dcard__price-num--gy {
  color: var(--func-success);
  font-size: var(--font-lg);
}
.dcard__price-unit {
  margin-left: 8rpx;
  font-size: var(--font-xs);
  color: var(--text-4);
}
.dcard__btn {
  margin: 0;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 32rpx;
  border-radius: 28rpx;
  background: var(--brand-primary);
  color: var(--text-invert);
  font-size: var(--font-sm);
  font-weight: 600;
}
.dcard__btn::after {
  border: none;
}
.dcard__btn.button-hover {
  background: var(--brand-primary-press);
}
.dcard__btn--gray,
.dcard__btn--gray[disabled] {
  background: var(--bg-segment);
  color: var(--text-5);
}
