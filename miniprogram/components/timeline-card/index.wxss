/* components/timeline-card · 订单动态时间线卡专属样式 */
/* 拆分阶段3 A0(2026-10-16): 自 order-detail.wxss L318-332 逐字迁入(用户书面批准);
   共用原语 .od__card/.od__card-title 留页面 wxss, 经 styleIsolation=apply-shared 对本组件生效; CSS 变量沿 DOM 树继承 */
.od__tl { position: relative; }
.od__tl-item { display: flex; align-items: flex-start; gap: 16rpx; padding: 14rpx 0; }
.od__tl-item:not(:last-child) { border-bottom: 1rpx solid var(--border-divider); }
.od__tl-dot { flex: 0 0 auto; width: 48rpx; height: 48rpx; line-height: 48rpx; text-align: center; border-radius: 50%; font-size: 26rpx; background: var(--bg-segment); }
.od__tl-dot--complaint, .od__tl-dot--no_show { background: var(--func-danger-light); }
.od__tl-dot--money { background: var(--func-success-light); }
.od__tl-dot--milestone { background: var(--func-warning-light); }
.od__tl-dot--status { background: var(--func-info-light); }
.od__tl-body { flex: 1 1 auto; min-width: 0; }
.od__tl-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12rpx; }
.od__tl-label { font-size: var(--font-md); color: var(--text-1); font-weight: 600; }
.od__tl-time { flex: 0 0 auto; font-size: var(--font-xs); color: var(--text-4); }
.od__tl-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8rpx; margin-top: 6rpx; }
.od__tl-who { font-size: var(--font-sm); color: var(--brand-primary); }
.od__tl-detail { font-size: var(--font-sm); color: var(--text-3); line-height: 1.5; }
