<block wx:if="{{type === 'card'}}">
  <view class="ui-sk-card" wx:for="{{rows}}" wx:key="index">
    <view wx:if="{{avatar}}" class="skeleton sk-circle"></view>
    <view class="ui-sk-col">
      <view class="skeleton sk-line"></view>
      <view class="skeleton sk-line-sm"></view>
    </view>
  </view>
</block>
<block wx:elif="{{type === 'circle'}}">
  <view class="ui-sk-row" wx:for="{{rows}}" wx:key="index">
    <view class="skeleton sk-circle"></view>
    <view class="ui-sk-col">
      <view class="skeleton sk-line"></view>
      <view class="skeleton sk-line-sm"></view>
    </view>
  </view>
</block>
<block wx:else>
  <view class="skeleton sk-line" wx:for="{{rows}}" wx:key="index"></view>
</block>