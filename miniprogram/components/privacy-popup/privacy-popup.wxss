.pp-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
  box-sizing: border-box;
}
.pp-dialog {
  width: 100%;
  max-width: 620rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx 36rpx 32rpx;
  box-sizing: border-box;
}
.pp-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1F2937;
  text-align: center;
  margin-bottom: 24rpx;
}
.pp-body {
  font-size: 28rpx;
  line-height: 1.7;
  color: #4B5563;
  margin-bottom: 36rpx;
}
.pp-link {
  color: #D4875A;
}
.pp-btns {
  display: flex;
  gap: 24rpx;
}
.pp-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 30rpx;
  border-radius: 42rpx;
  margin: 0;
  padding: 0;
}
.pp-btn::after { border: none; }
.pp-btn--ghost {
  background: #F3F4F6;
  color: #6B7280;
}
.pp-btn--primary {
  background: #D4875A;
  color: #FFFFFF;
}
