<view class="pp-mask" wx:if="{{show}}" catchtouchstart="noop" catchtouchmove="noop">
  <view class="pp-dialog">
    <view class="pp-title">隐私保护提示</view>
    <view class="pp-body">
      在你使用「找人帮忙」服务前，请阅读并同意
      <text class="pp-link" bindtap="openContract">《{{contractName}}》</text>
      。我们将依法收集和使用你的位置信息（用于发布地址留痕、履约距离提示与安全报备）、手机号等必要信息。
    </view>
    <view class="pp-btns">
      <button class="pp-btn pp-btn--ghost" bindtap="onDisagree">拒绝</button>
      <button
        class="pp-btn pp-btn--primary"
        id="pp-agree-btn"
        open-type="agreePrivacyAuthorization"
        bindagreeprivacyauthorization="onAgree"
      >同意</button>
    </view>
  </view>
</view>
