<!-- 里程碑4·文件1阶段4 ②b(2026-10-17, 用户确认推进): 自 pages-v2/order-detail/order-detail.wxml 逐字迁入
     机械改动仅两处: ①safety.checkins → 组件 property checkins; ②bindtap="onSos"/"onSafety" → bindtap="onSos"/"onSafety"(triggerEvent 上抛)
     卡体 wx:if(履约中 S2/S3/S3_5/S4) 由页面外层 wx:if 承担, 保「非履约中不实例化」 -->
<view class="od__card">
  <view class="od__card-title">🛡️ 安全中心</view>
  <view class="od__safety-grid">
    <button class="od__sos-btn" bindtap="onSos" hover-class="btn-press">🆘 紧急求助</button>
    <button class="od__report-btn" bindtap="onSafety" hover-class="btn-press">📍 安全报备</button>
  </view>
  <view class="od__safety-desc">紧急求助将记录位置并通知平台；安全报备可向对方报平安</view>
  <view class="od__checkin-list" wx:if="{{checkins.length > 0}}">
    <view class="od__checkin-item" wx:for="{{checkins}}" wx:key="key">
      <text class="od__checkin-ic">✅</text>
      <text class="od__checkin-text">{{item.text}}</text>
      <text class="od__checkin-time">{{item.time}}</text>
    </view>
  </view>
</view>
