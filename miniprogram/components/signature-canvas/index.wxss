.sgc { position: relative; }
.sgc__canvas {
  width: 100%;
  height: 320rpx;
  background: var(--bg-card);
  border: 1rpx dashed var(--border-ghost);
  border-radius: var(--r-sm);
  box-sizing: border-box;
}
.sgc__hint {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  text-align: center;
  color: var(--text-disabled);
  font-size: 28rpx;
  pointer-events: none;
}
.sgc__status {
  margin-top: 8rpx;
  font-size: 24rpx;
  text-align: right;
}
.sgc__status--ok { color: var(--success, #22B573); }
.sgc__status--fail { color: var(--danger, #E5484D); }