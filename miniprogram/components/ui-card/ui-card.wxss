/* ui-card 通用卡片容器(与全局 token 对齐) */
.ui-card {
  margin-top: 20rpx;
  background: var(--bg-card);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-card);
  padding: 8rpx 28rpx;
}
.ui-card__head { padding: 24rpx 0 8rpx; display: flex; flex-direction: column; }
.ui-card__title { font-size: var(--font-md); font-weight: 600; color: var(--text-1); }
.ui-card__subtitle { margin-top: 4rpx; font-size: var(--font-xs); color: var(--text-4); }
