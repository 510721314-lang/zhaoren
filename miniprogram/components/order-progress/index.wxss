.op { padding: 8rpx 0; }
.op__axis {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  overflow-x: auto;
  padding: 8rpx 0;
}
.op__node {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  min-width: 88rpx;
}
.op__dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--bg-segment);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-xs);
  color: var(--text-5);
}
.op__dot.is-current {
  background: var(--brand-primary);
  color: var(--text-invert);
  box-shadow: 0 0 0 6rpx var(--brand-primary-light);
}
.op__node--done .op__dot { background: var(--func-success); color: var(--text-invert); }
.op__node--current .op__name { color: var(--brand-primary); font-weight: 600; }
.op__name {
  margin-top: 8rpx;
  font-size: var(--font-xs);
  color: var(--text-4);
  white-space: nowrap;
}
.op__node--done .op__name { color: var(--text-2); }
.op__line {
  flex: 1;
  height: 4rpx;
  background: var(--bg-segment);
  margin: 0 4rpx;
  min-width: 24rpx;
}
.op__line--done { background: var(--func-success); }
.op__line--current { background: var(--brand-primary); }

.op__branches {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}
.op__branch {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  /* 默认=灰显预告；命中态颜色由 ORDER_STATUS SSOT 内联注入 */
  background: var(--bg-segment);
  color: var(--text-4);
  font-size: var(--font-xs);
}
.op__branch.is-active { font-weight: 600; }
.op__branch-dot { margin-right: 6rpx; }
