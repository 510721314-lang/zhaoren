.cp {
  background: var(--bg-card);
  padding: 20rpx 24rpx;
  border-radius: var(--r-md);
}
.cp__bar {
  display: flex;
  gap: 8rpx;
}
.cp__seg {
  flex: 1;
  height: 8rpx;
  border-radius: 4rpx;
}
.cp__seg--done {
  background: var(--brand-primary);
}
.cp__seg--current {
  background: var(--func-warning);
}
.cp__seg--todo {
  background: var(--progress-todo);
}
.cp__steps {
  margin-top: 12rpx;
  display: flex;
  justify-content: space-between;
}
.cp__step {
  font-size: var(--font-xs);
  color: var(--text-5);
}
.cp__step--done {
  color: var(--brand-primary);
}
.cp__step--current {
  color: var(--func-warning);
}
.cp__count {
  margin-top: 8rpx;
  font-size: var(--font-xs);
  color: var(--text-4);
  text-align: center;
}
