.empty {
  text-align: center;
  padding: 120rpx 56rpx;
}
.empty__icon {
  font-size: var(--font-icon-lg);
  line-height: 1;
  margin-bottom: 24rpx;
}
.empty__title {
  font-size: var(--font-md);
  color: var(--text-3);
}
.empty__desc {
  margin-top: 12rpx;
  font-size: var(--font-sm);
  color: var(--text-5);
  line-height: 1.6;
}
.empty__btn {
  margin-top: 32rpx;
  display: inline-block;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 48rpx;
  border-radius: 32rpx;
  background: var(--brand-primary);
  color: var(--text-invert);
  font-size: var(--font-sm);
}
.empty__btn::after {
  border: none;
}
