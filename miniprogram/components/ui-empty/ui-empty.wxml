<view class="ui-empty">
  <view class="ui-empty__icon">{{icon || '📭'}}</view>
  <view class="ui-empty__title" wx:if="{{title}}">{{title}}</view>
  <view class="ui-empty__desc" wx:if="{{desc}}">{{desc}}</view>
  <view class="ui-empty__cta" wx:if="{{cta}}" hover-class="ui-empty__cta-press" catchtap="onCta">{{cta}}</view>
</view>