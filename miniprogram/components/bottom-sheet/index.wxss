/* @VERIFIED 2026-11-27 已真机验证：px→rpx 换算（保留 1px 物理边框与 env(safe-area-inset-bottom)），弹层视觉正常，iOS+Android 无异常，体验版 v1.6.33 */
.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.4);
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.25s ease;
  z-index: 999;
}
.sheet-mask--show {
  opacity: 1;
  visibility: visible;
}
.sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: var(--bg-card);
  border-radius: 32rpx 32rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.25s ease;
  z-index: 1000;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}
.sheet--show {
  transform: translateY(0);
}
.sheet__handle {
  width: 80rpx;
  height: 8rpx;
  background: var(--sheet-handle);
  border-radius: 4rpx;
  margin: 16rpx auto;
}
.sheet__header {
  padding: 16rpx 40rpx 24rpx;
  border-bottom: 1px solid var(--border-2);
}
.sheet__title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-1);
}
.sheet__body {
  flex: 1;
  overflow-y: auto;
  padding: 32rpx 40rpx;
}
.sheet__footer {
  padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1px solid var(--border-2);
}
