.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: var(--bg-mask);
  z-index: 300;
  visibility: hidden;
  transition: visibility 0.2s ease;
}
.sheet-mask--show {
  visibility: visible;
}
.sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-card);
  border-radius: var(--r-xl) var(--r-xl) 0 0;
  padding: 32rpx 28rpx calc(52rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.25s ease;
  max-height: 80vh;
  overflow-y: auto;
}
.sheet--show {
  transform: translateY(0);
}
.sheet__handle {
  width: 80rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--sheet-handle);
  margin: 0 auto 24rpx;
}
.sheet__header {
  text-align: center;
  margin-bottom: 24rpx;
}
.sheet__title {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--text-1);
}
.sheet__body {
  font-size: var(--font-md);
  color: var(--text-2);
}
.sheet__footer {
  margin-top: 28rpx;
}
