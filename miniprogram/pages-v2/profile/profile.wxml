<view class="v2 profile">
  <nav-bar title="我的" show-back="{{false}}"></nav-bar>

  <!-- U1 身份头部 -->
  <view class="pf__header">
    <view class="pf__avatar">
      <image wx:if="{{user.avatar}}" class="pf__avatar-img" src="{{user.avatar}}" mode="aspectFill" />
      <text wx:else>👤</text>
    </view>
    <view class="pf__head-info">
      <view class="pf__name-line">
        <text class="pf__name">{{user.nickname || '微信用户'}}</text>
        <text class="pf__badge" wx:if="{{user.is_realname_done}}">实名✓</text>
      </view>
      <view class="pf__phone">{{user.phone || '未绑定手机号'}}</view>
    </view>
  </view>

  <!-- 身份切换卡 -->
  <view class="pf__switch">
    <view class="pf__switch-item {{identity === 'user' ? 'is-on' : ''}}" data-role="user" bindtap="switchIdentity">
      <text class="pf__switch-ic">👤</text><text>我是用户</text>
    </view>
    <view class="pf__switch-item {{identity === 'partner' ? 'is-on' : ''}}" data-role="partner" bindtap="switchIdentity">
      <text class="pf__switch-ic">🧭</text><text>我是耍伴</text>
    </view>
  </view>

  <!-- U2 双信用分卡（独立两栏） -->
  <view class="pf__scores">
    <view class="pf__score" data-role="user" bindtap="onScoreDetail">
      <view class="pf__score-num">{{user.user_credit_score}}</view>
      <view class="pf__score-label">用户信用分</view>
      <view class="pf__score-level">{{userLevel}}</view>
    </view>
    <view class="pf__score-divider"></view>
    <view class="pf__score" data-role="partner" bindtap="onScoreDetail">
      <view class="pf__score-num">{{user.partner_credit_score || '--'}}</view>
      <view class="pf__score-label">耍伴信用分</view>
      <view class="pf__score-level">{{partnerLevel}}</view>
    </view>
  </view>

  <!-- U3 订单四宫格 -->
  <view class="pf__orders">
    <view class="pf__order" wx:for="{{orderEntries}}" wx:key="key" data-key="{{item.key}}" bindtap="onOrderEntry">
      <view class="pf__order-ic">{{item.icon}}
        <text class="pf__order-dot" wx:if="{{item.count}}">{{item.count}}</text>
      </view>
      <view class="pf__order-name">{{item.name}}</view>
    </view>
  </view>

  <!-- U5 耍伴专区: 已是耍伴才显示 -->
  <view class="pf__card" wx:if="{{user.is_partner}}">
    <view class="pf__card-title">耍伴工作台</view>

    <!-- 承接订单速览(最多 3 条, 点卡片跳详情) -->
    <view class="pf__dash" wx:if="{{partnerRecentOrders.length > 0}}">
      <view class="pf__dash-item"
        wx:for="{{partnerRecentOrders}}" wx:key="order_id"
        data-oid="{{item.order_id}}" bindtap="goOrderDetail"
      >
        <view class="pf__dash-head">
          <text class="pf__dash-scene">{{item.scene_name}}</text>
          <text class="pf__dash-status">{{item.status_name}}</text>
        </view>
        <view class="pf__dash-body">
          <view class="pf__dash-line">🕐 {{item.time_str}}</view>
          <view class="pf__dash-line">📍 {{item.location_name}}</view>
          <view class="pf__dash-line">💰 ¥{{item.total_fen / 100}}</view>
        </view>
      </view>
    </view>
    <view class="pf__dash-empty" wx:else>
      暂无承接订单，去<a class="pf__dash-go" data-key="myTakeOrders" bindtap="onPartnerEntry">我承接的订单</a>查看或前往广场抢单
    </view>

    <view class="pf__card-sub-title">快捷入口</view>
    <view
      class="pf__link"
      wx:for="{{partnerEntries}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onPartnerEntry"
    >
      <text class="pf__link-ic">{{item.icon}}</text>
      <text class="pf__link-name">{{item.name}}</text>
      <text class="pf__link-arrow">›</text>
    </view>
  </view>

  <!-- 非耍伴: 成为耍伴引导 -->
  <view class="pf__apply" wx:else bindtap="becomePartner">
    <view>
      <view class="pf__apply-title">成为认证耍伴，接单赚收入</view>
      <view class="pf__apply-sub">完成实名+人脸+场景认证即可接单，享平台流量扶持</view>
    </view>
    <view class="pf__apply-btn">去认证</view>
  </view>

  <!-- U4 功能列表(联系客服用微信官方客服会话 open-type=contact) -->
  <view class="pf__card">
    <block wx:for="{{funcList}}" wx:key="key">
      <button
        wx:if="{{item.key === 'help'}}"
        class="pf__link pf__link--btn"
        open-type="contact"
        binderror="onContactError"
        hover-class="pf__link--hover"
      >
        <text class="pf__link-ic">{{item.icon}}</text>
        <text class="pf__link-name">{{item.name}}</text>
        <text class="pf__link-arrow">›</text>
      </button>
      <button
        wx:else
        class="pf__link pf__link--btn"
        data-key="{{item.key}}"
        bindtap="onFuncTap"
        hover-class="pf__link--hover"
      >
        <text class="pf__link-ic">{{item.icon}}</text>
        <text class="pf__link-name">{{item.name}}</text>
        <text class="pf__link-arrow">›</text>
      </button>
    </block>
  </view>

  <!-- U6 -->
  <view class="pf__logout pf__logout--exit" bindtap="onExitLogin">退出登录</view>
  <view class="pf__logout" bindtap="onLogout">注销账号</view>
  <view class="pf__version">版本号 {{version}}</view>

  <night-mask visible="{{isRedline}}"></night-mask>
</view>
