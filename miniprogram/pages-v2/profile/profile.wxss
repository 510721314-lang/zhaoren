.profile {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 0 20rpx 160rpx;
}

/* 访客引导卡: 未登录时替代空的个人中心 */
.pf__guest {
  margin-top: 12rpx;
  background: var(--brand-primary-light);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-card);
  padding: 40rpx 32rpx;
  text-align: center;
}
.pf__guest-title {
  font-size: var(--font-xxl);
  font-weight: 600;
  color: var(--text-1);
}
.pf__guest-desc {
  margin-top: 12rpx;
  font-size: var(--font-sm);
  color: var(--text-3);
  line-height: 1.5;
}
.pf__guest-btn {
  margin: 28rpx auto 0;
  width: 420rpx;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: var(--r-md);
  background: var(--brand-primary);
  color: #fff;
  font-size: var(--font-md);
}

/* 耍伴入驻进度卡 */
.pf__onboard {
  margin-top: 12rpx;
  background: var(--bg-card);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-card);
  padding: 28rpx 32rpx;
}
.pf__onboard-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.pf__onboard-title { font-size: var(--font-lg); font-weight: 600; color: var(--text-1); }
.pf__onboard-step { font-size: var(--font-xs); color: var(--text-3); }
.pf__onboard-bar { margin-top: 18rpx; }
.pf__onboard-track { height: 10rpx; border-radius: 6rpx; background: var(--bg-subtle); overflow: hidden; }
.pf__onboard-fill { height: 100%; border-radius: 6rpx; background: var(--brand-primary); transition: width .3s; }
.pf__onboard-dots {
  display: flex; justify-content: space-between; margin-top: 12rpx;
}
.pf__onboard-dot { font-size: var(--font-xs); color: var(--text-3); }
.pf__onboard-dot.is-on { color: var(--brand-primary); font-weight: 600; }
.pf__onboard-tip {
  margin-top: 16rpx; font-size: var(--font-sm); color: var(--text-2); line-height: 1.5;
}
.pf__onboard-btn {
  margin-top: 20rpx; height: 76rpx; line-height: 76rpx; text-align: center;
  border-radius: var(--r-md); background: var(--brand-primary); color: #fff; font-size: var(--font-md);
}

/* U1 身份头部: 品牌浅底, 个人中心辨识度 */
.pf__header {
  margin-top: 12rpx;
  background: var(--brand-primary-light);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-card);
  padding: 32rpx 28rpx;
  display: flex;
  align-items: center;
}
.pf__avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: var(--avatar-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-display-xl);
  overflow: hidden;
}
.pf__avatar-img {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
}
.pf__head-info {
  margin-left: 24rpx;
}
.pf__name-line {
  display: flex;
  align-items: center;
}
.pf__name {
  font-size: var(--font-xxl);
  font-weight: 700;
  color: var(--text-1);
}
.pf__badge {
  font-size: var(--font-xs);
  color: var(--func-success);
  border: 1rpx solid var(--cert-border);
  border-radius: 8rpx;
  padding: 0 8rpx;
  margin-left: 10rpx;
}
.pf__phone {
  margin-top: 10rpx;
  font-size: var(--font-sm);
  color: var(--text-4);
}

/* 身份切换 */
.pf__switch {
  margin-top: 20rpx;
  background: var(--bg-segment);
  border-radius: var(--r-md);
  padding: 6rpx;
  display: flex;
}
.pf__switch-item {
  flex: 1;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-md);
  color: var(--text-3);
}
.pf__switch-item.is-on {
  background: var(--bg-card);
  color: var(--brand-primary);
  font-weight: 700;
  box-shadow: var(--shadow-card);
}
.pf__switch-ic {
  margin-right: 8rpx;
}

/* U2 信用分（仅当前身份, 另一身份切身份查看） */
.pf__scores {
  margin-top: 20rpx;
  background: var(--bg-card);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-card);
  padding: 32rpx 0;
  display: flex;
  align-items: center;
}
.pf__score {
  flex: 1;
  text-align: center;
}
.pf__score-num {
  font-size: var(--font-display-lg);
  font-weight: 700;
  color: var(--func-warning);
}
.pf__score-label {
  margin-top: 6rpx;
  font-size: var(--font-sm);
  color: var(--text-3);
}
.pf__score-level {
  margin-top: 10rpx;
  display: inline-block;
  font-size: var(--font-xs);
  font-weight: 600;
  color: var(--brand-primary);
  background: var(--brand-primary-light);
  border-radius: var(--r-full);
  padding: 4rpx 16rpx;
}
.pf__score-hint {
  margin: 8rpx 8rpx 0;
  font-size: var(--font-xs);
  color: var(--text-4);
  text-align: right;
}

/* U3 */
.pf__orders {
  margin-top: 20rpx;
  background: var(--bg-card);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-card);
  padding: 28rpx 0;
  display: flex;
}
.pf__order {
  flex: 1;
  text-align: center;
}
.pf__order-ic {
  position: relative;
  font-size: var(--font-display-lg);
}
.pf__order-dot {
  position: absolute;
  top: -8rpx;
  right: 24rpx;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  padding: 0 6rpx;
  border-radius: 14rpx;
  background: var(--func-danger);
  color: var(--text-invert);
  font-size: var(--font-xs);
}
.pf__order-name {
  margin-top: 10rpx;
  font-size: var(--font-sm);
  color: var(--text-2);
}

/* 卡片通用 */
.pf__card {
  margin-top: 20rpx;
  background: var(--bg-card);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-card);
  padding: 8rpx 28rpx;
}
.pf__card-title {
  padding: 24rpx 0 8rpx;
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-1);
}
.pf__card-sub-title {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-divider);
  font-size: var(--font-xs);
  color: var(--text-4);
}

/* 耍伴工作台 · 承接订单速览 */
.pf__dash {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin: 12rpx 0 8rpx;
}
.pf__dash-item {
  background: var(--bg-segment);
  border-radius: var(--r-md);
  padding: 16rpx 20rpx;
}
.pf__dash-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.pf__dash-scene {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--text-1);
}
.pf__dash-status {
  font-size: var(--font-xs);
  color: var(--func-info);
}
.pf__dash-body {
  margin-top: 8rpx;
  font-size: var(--font-xs);
  color: var(--text-3);
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx 24rpx;
}
.pf__dash-line {
  font-size: var(--font-xs);
}
.pf__dash-empty {
  margin: 12rpx 0 4rpx;
  padding: 20rpx;
  text-align: center;
  font-size: var(--font-xs);
  color: var(--text-4);
  background: var(--bg-segment);
  border-radius: var(--r-md);
}
.pf__dash-go {
  color: var(--brand-primary);
  margin: 0 4rpx;
}
.pf__link {
  display: flex;
  align-items: center;
  height: 96rpx;
  border-bottom: 1rpx solid var(--border-divider);
}
.pf__link:last-child {
  border-bottom: none;
}
/* button 元素复用列表行样式: 重置微信按钮默认外观 */
.pf__link--btn {
  width: 100%;
  margin: 0;
  padding: 0;
  background: transparent;
  border-radius: 0;
  font-size: inherit;
  font-weight: normal;
  line-height: normal;
  text-align: left;
}
.pf__link--btn::after {
  border: none;
}
.pf__link--hover {
  background: var(--bg-segment);
}
.pf__link-ic {
  font-size: var(--font-xxl);
  margin-right: 20rpx;
}
.pf__link-name {
  flex: 1;
  font-size: var(--font-md);
  color: var(--text-2);
}
.pf__link-arrow {
  font-size: var(--font-xxl);
  color: var(--text-disabled);
}
.pf__badge {
  font-size: 20rpx;
  color: var(--text-invert);
  background: var(--func-danger, #fa5151);
  border-radius: 20rpx;
  padding: 2rpx 10rpx;
  min-width: 28rpx;
  text-align: center;
  margin: 0 8rpx;
}

/* 成为耍伴 */
.pf__apply {
  margin-top: 20rpx;
  background: linear-gradient(90deg, var(--brand-primary-light), var(--func-success-light));
  border-radius: var(--r-lg);
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.pf__apply-title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--func-success);
}
.pf__apply-sub {
  margin-top: 8rpx;
  font-size: var(--font-xs);
  color: var(--text-4);
}
.pf__apply-btn {
  background: var(--brand-primary);
  color: var(--text-invert);
  font-size: var(--font-sm);
  border-radius: 28rpx;
  padding: 12rpx 28rpx;
  flex-shrink: 0;
}

/* U6 账号与安全 */
.pf__acct-title {
  margin: 40rpx 8rpx 4rpx;
  font-size: var(--font-xs);
  font-weight: 600;
  color: var(--text-4);
}
.pf__logout {
  margin-top: 28rpx;
  text-align: center;
  font-size: var(--font-sm);
  color: var(--func-danger);
}
.pf__logout--exit {
  color: var(--text-4);
  margin-top: 16rpx;
}
.pf__version {
  margin-top: 16rpx;
  text-align: center;
  font-size: var(--font-xs);
  color: var(--text-disabled);
}

/* 地图找TA: 工具区入口行(点击进入附近地图) */
.pf__map {
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 0 24rpx;
  margin: 20rpx 0 0;
  background: var(--bg-card);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-card);
}
.pf__map-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}
.pf__map-row-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}
.pf__map-txt { min-width: 0; }
.pf__map-sub {
  margin-top: 4rpx;
  font-size: var(--font-xs);
  color: var(--text-5);
}

/* P3-18(2026-10-27): 头部「编辑资料」入口 + 昵称/头像编辑弹层 */
.pf__header--hover { opacity: 0.92; }
.pf__edit-entry {
  margin-left: auto;
  font-size: var(--font-xs);
  color: var(--brand-primary);
  white-space: nowrap;
}
.pf__edit-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 900;
}
.pf__edit-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 901;
  background: var(--bg-card);
  border-radius: var(--r-lg) var(--r-lg) 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}
.pf__edit-title {
  text-align: center;
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text-1);
}
.pf__edit-avatar {
  margin: 28rpx auto 0;
  width: 160rpx;
  text-align: center;
}
.pf__edit-avatar--hover { opacity: 0.85; }
.pf__edit-avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
}
.pf__edit-avatar-ph {
  display: block;
  width: 160rpx;
  height: 160rpx;
  line-height: 160rpx;
  border-radius: 50%;
  background: var(--avatar-bg);
  font-size: 72rpx;
  text-align: center;
}
.pf__edit-avatar-tip {
  margin-top: 10rpx;
  font-size: var(--font-xs);
  color: var(--text-4);
}
.pf__edit-row {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--bg-subtle);
  border-radius: var(--r-md);
}
.pf__edit-label {
  font-size: var(--font-md);
  color: var(--text-2);
}
.pf__edit-input {
  flex: 1;
  margin-left: 20rpx;
  font-size: var(--font-md);
  color: var(--text-1);
}
.pf__edit-ph { color: var(--text-4); }
.pf__edit-actions {
  margin-top: 32rpx;
  display: flex;
}
.pf__edit-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: var(--r-md);
  font-size: var(--font-md);
  background: var(--brand-primary);
  color: #fff;
}
.pf__edit-btn--ghost {
  margin-right: 20rpx;
  background: var(--bg-subtle);
  color: var(--text-2);
}
.pf__edit-btn.is-disabled { opacity: 0.6; }


