.sf { min-height: 100vh; background: var(--bg-page); padding: 0 20rpx 80rpx; }
.sf__sos-bar {
  background: var(--func-danger);
  color: var(--text-invert);
  padding: 20rpx 28rpx;
  font-size: var(--font-sm);
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: sticky;
  top: 0;
  z-index: 10;
}
.sf__sos-kefu { font-size: var(--font-xs); color: var(--text-invert); text-decoration: underline; }
.sf__body { padding-top: 20rpx; }
.sf__card { background: var(--bg-card); border-radius: var(--r-lg); padding: 24rpx 28rpx; box-shadow: var(--shadow-card); margin-bottom: 20rpx; }
.sf__card-title { font-size: var(--font-md); font-weight: 600; color: var(--text-1); margin-bottom: 16rpx; }

.sf__status-title { font-size: var(--font-md); color: var(--func-success); font-weight: 600; }
.sf__elapsed { margin-top: 8rpx; font-size: var(--font-sm); color: var(--text-3); }

.sf__map-placeholder { height: 200rpx; background: var(--bg-segment); border-radius: var(--r-md); display: flex; align-items: center; justify-content: center; color: var(--text-5); margin-bottom: 16rpx; }
.sf__loc-row { display: flex; align-items: center; padding: 12rpx 0; }
.sf__loc-label { width: 160rpx; font-size: var(--font-sm); color: var(--text-3); }
.sf__loc-val { flex: 1; font-size: var(--font-sm); color: var(--text-1); }

.sf__checkin-tip { font-size: var(--font-sm); color: var(--text-3); margin-bottom: 12rpx; }
.sf__checkin-info { display: flex; justify-content: space-between; margin-bottom: 16rpx; font-size: var(--font-sm); color: var(--text-2); }

/* A4 一键求助进度环 */
.sf__sos-wrap { display: flex; flex-direction: column; align-items: center; padding: 32rpx 0; }
.sf__sos-ring { width: 240rpx; height: 240rpx; border-radius: 50%; position: relative; display: flex; align-items: center; justify-content: center; }
.sf__sos-progress { position: absolute; inset: 0; border-radius: 50%; }
.sf__sos-inner { position: relative; width: 180rpx; height: 180rpx; background: var(--bg-card); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: var(--font-sm); color: var(--text-1); }
.sf__sos-hint { margin-top: 16rpx; font-size: var(--font-xs); color: var(--text-4); }

.sf__btn { width: 100%; height: 80rpx; line-height: 80rpx; border-radius: 40rpx; font-size: var(--font-md); margin-top: 12rpx; }
.sf__btn::after { border: none; }
.sf__btn--ghost { background: var(--bg-segment); color: var(--text-2); }
.sf__btn--danger { background: var(--func-danger); color: var(--text-invert); }

.sf__silent-counting { padding: 16rpx 0; text-align: center; font-size: var(--font-md); color: var(--func-danger); }

.sf__footer-tip { padding: 40rpx 0; text-align: center; font-size: var(--font-xs); color: var(--text-5); }

/* 三态骨架屏 */
.sf__loading { padding: 16rpx; }
.sf__skeleton { height: 120rpx; background: var(--bg-segment); border-radius: var(--r-md); margin-bottom: 16rpx; animation: sf-skeleton-pulse 1.2s ease-in-out infinite; }
@keyframes sf-skeleton-pulse { 0%,100% { opacity: 0.5; } 50% { opacity: 1; } }
