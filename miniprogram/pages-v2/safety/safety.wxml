<view class="v2 sf">
  <nav-bar title="安全报备"></nav-bar>

  <!-- 加载态 -->
  <view class="sf__loading" wx:if="{{loading}}">
    <view class="sf__skeleton" wx:for="{{[1,2,3]}}" wx:key="*this"></view>
  </view>
  <!-- 网络异常态 -->
  <empty-state wx:elif="{{loadError}}" icon="📡" title="网络异常" desc="请检查网络后重试" btnText="重试" bind:btntap="reload" />
  <!-- 正常态（订单存在且未跳转） -->
  <block wx:elif="{{order && !redirect}}">
  <!-- 已发出求助顶部红条（不可滑动消除） -->
  <view class="sf__sos-bar" wx:if="{{sosActive}}">
    🚨 求助已发出，平台安全专员正在处理
    <text class="sf__sos-kefu" bindtap="onKefuResolve">客服模拟解除</text>
  </view>

  <view class="sf__body">
    <!-- A1 报备状态头 -->
    <view class="sf__card">
      <view class="sf__status-title">报备进行中</view>
      <view class="sf__elapsed">已报备 {{elapsedSec}}秒</view>
    </view>

    <!-- A2 位置共享卡（真实高精度 GPS） -->
    <view class="sf__card">
      <view class="sf__card-title">
        📍 实时位置
        <text class="sf__loc-refresh" bindtap="getHighAccuracyLocation" wx:if="{{locStatus !== 'locating'}}">刷新</text>
        <text class="sf__loc-refreshing" wx:else>定位中…</text>
      </view>

      <!-- 地图：有定位成功才渲染 -->
      <map class="sf__map"
        wx:if="{{locStatus === 'success' && currentLat}}"
        latitude="{{mapLat}}"
        longitude="{{mapLng}}"
        markers="{{mapMarkers}}"
        scale="16"
        show-location="{{true}}"
        enable-3D="{{false}}"
        enable-compass="{{false}}"
        enable-zoom="{{true}}"
        enable-scroll="{{false}}"
        enable-rotate="{{false}}" />
      <view class="sf__map-placeholder" wx:elif="{{locStatus === 'locating'}}">🕐 正在获取高精度定位…</view>
      <view class="sf__map-placeholder sf__map-placeholder--fail" wx:elif="{{locStatus === 'fail'}}">⚠️ 定位失败，请检查权限或网络</view>
      <view class="sf__map-placeholder" wx:else>🗺️ 等待定位…</view>

      <!-- 精度标签（颜色随精度变化） -->
      <view class="sf__acc-badge sf__acc-badge--{{accuracy <= 50 ? 'good' : accuracy <= 200 ? 'ok' : accuracy > 0 ? 'poor' : 'unknown'}}" wx:if="{{accuracy > 0 || locStatus === 'fail'}}">
        {{accuracy > 0 ? '精度 ' + accuracyText : '精度未知'}}
      </view>

      <!-- 详细信息 -->
      <view class="sf__loc-detail" wx:if="{{locStatus === 'success'}}">
        <view class="sf__loc-row" wx:if="{{address}}">
          <text class="sf__loc-label">📍 地址</text>
          <text class="sf__loc-val sf__loc-val--addr">{{address}}</text>
        </view>
        <view class="sf__loc-row">
          <text class="sf__loc-label">🕐 更新</text>
          <text class="sf__loc-val">{{locUpdateAt}} · 每{{locationRefreshSec}}秒自动刷新</text>
        </view>
      </view>
    </view>

    <!-- A3 定时打卡 -->
    <view class="sf__card">
      <view class="sf__card-title">定时打卡</view>
      <view class="sf__checkin-tip">每{{checkinMin}}分钟自动打卡</view>
      <view class="sf__checkin-info">
        <view class="sf__checkin-last">上次打卡：{{lastCheckin}}</view>
        <view class="sf__checkin-next">下次打卡倒计时：{{nextCheckinSec}}秒</view>
      </view>
      <button class="sf__btn sf__btn--ghost" bindtap="onManualCheckin">手动打卡</button>
    </view>

    <!-- A4 分级求助 -->
    <view class="sf__card">
      <view class="sf__card-title">分级求助</view>

      <!-- 一键求助（长按秒数取 CONFIG.SAFETY.oneKeyPressSec） -->
      <view class="sf__sos-wrap">
        <view class="sf__sos-ring"
          bindtouchstart="onSosTouchStart"
          bindtouchend="onSosTouchEnd"
          bindtouchcancel="onSosTouchEnd">
          <view class="sf__sos-progress" style="background:conic-gradient(var(--func-danger) {{sosProgress}}deg, var(--bg-segment) {{sosProgress}}deg);"></view>
          <view class="sf__sos-inner">
            <text wx:if="{{!sosActive}}">长按{{oneKeyPressSec}}秒</text>
            <text wx:else>已发出</text>
          </view>
        </view>
        <view class="sf__sos-hint">长按{{oneKeyPressSec}}秒触发一键求助</view>
      </view>

      <!-- 静默求助 -->
      <block wx:if="{{silentCountdownSec > 0}}">
        <view class="sf__silent-counting">静默求助倒计时：{{silentCountdownSec}}秒</view>
        <button class="sf__btn sf__btn--danger" bindtap="onSilentCancel">撤销</button>
      </block>
      <block wx:else>
        <button class="sf__btn sf__btn--ghost" bindtap="onSilentStart" disabled="{{sosActive}}">静默求助（{{sosCountdownSec}}秒后触发）</button>
      </block>
    </view>

    <!-- A6 底部灰字 -->
    <view class="sf__footer-tip">履约结束后报备自动关闭，不可手动关闭</view>
  </view>

  </block>
  <!-- 订单存在但状态不允许（redirect） -->
  <empty-state wx:elif="{{order}}" icon="⚠️" title="状态不允许" desc="仅履约中状态可进入安全报备，即将跳转" />
  <!-- 空态 -->
  <empty-state wx:else icon="📭" title="数据不存在" desc="该记录可能已被删除" />
  <night-mask visible="{{isRedline}}"></night-mask>
</view>
