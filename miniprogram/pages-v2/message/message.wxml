<view class="v2 msg">
  <nav-bar title="消息" show-back="{{false}}"></nav-bar>

  <!-- M0 留存提示条 -->
  <view class="msg__retention">{{retentionText}}</view>

  <!-- M2 固定入口 -->
  <view class="msg__entries">
    <view class="msg__entry" bindtap="onSystemTap" wx:if="{{entries.system}}">
      <view class="msg__entry-avatar">{{entries.system.avatar}}
        <text class="msg__badge" wx:if="{{entries.system.unread_count}}">{{entries.system.unread_count}}</text>
      </view>
      <view class="msg__entry-main">
        <view class="msg__entry-name">{{entries.system.counterpart}}</view>
        <view class="msg__entry-last">{{entries.system.last_msg}}</view>
      </view>
      <view class="msg__entry-time">{{entries.system.last_msg_at}}</view>
    </view>
    <view class="msg__entry" bindtap="onKefuTap" wx:if="{{entries.kefu}}">
      <view class="msg__entry-avatar">{{entries.kefu.avatar}}</view>
      <view class="msg__entry-main">
        <view class="msg__entry-name">{{entries.kefu.counterpart}}</view>
        <view class="msg__entry-last">{{entries.kefu.last_msg}}</view>
      </view>
      <view class="msg__entry-time">{{entries.kefu.last_msg_at}}</view>
    </view>
  </view>

  <!-- M1 订单会话 -->
  <view class="msg__list">
    <!-- 加载态 -->
    <view class="msg__loading" wx:if="{{loading}}">
      <view class="msg__skeleton" wx:for="{{[1,2,3]}}" wx:key="*this"></view>
    </view>
    <!-- 空态 -->
    <empty-state wx:elif="{{orderList.length === 0}}" icon="💬" title="暂无消息" desc="订单创建后会话将出现在此" />
    <!-- 网络异常态 -->
    <empty-state wx:elif="{{loadError}}" icon="📡" title="网络异常" desc="请检查网络后重试" btnText="重试" bind:btntap="reload" />
    <!-- 正常态：block 承接 wx:elif，内部 view 承接 wx:for，避免同元素双指令冲突 -->
    <block wx:elif="{{orderList.length > 0}}">
      <view
        class="msg__conv {{item.pinned ? 'is-pinned' : ''}}"
        wx:for="{{orderList}}"
        wx:key="_id"
        data-id="{{item._id}}"
        bindtap="onConvTap"
        bindlongpress="onLongPress"
      >
        <view class="msg__avatar">{{item.avatar}}
          <text class="msg__badge" wx:if="{{item.unread_count}}">{{item.unread_count}}</text>
        </view>
        <view class="msg__main">
          <view class="msg__row1">
            <text class="msg__name">{{item.displayTitle}}</text>
            <status-tag code="{{item.order_status}}"></status-tag>
          </view>
          <view class="msg__row2">
            <text class="msg__summary">{{item.summary}}</text>
            <view class="msg__right">
              <text class="msg__time">{{item.last_msg_at_display}}</text>
              <text class="msg__read" wx:if="{{item.is_read}}">✓✓</text>
            </view>
          </view>
        </view>
      </view>
    </block>
  </view>

  <night-mask visible="{{isRedline}}" bind:reserve="onReserve"></night-mask>
</view>
