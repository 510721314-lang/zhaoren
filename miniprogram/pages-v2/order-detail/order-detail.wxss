.od { min-height: 100vh; background: var(--bg-page); padding: 0 20rpx 160rpx; }
.od__body { padding-top: 20rpx; }
.od__card { background: var(--bg-card); border-radius: var(--r-lg); padding: 24rpx 28rpx; box-shadow: var(--shadow-card); margin-bottom: 20rpx; }
.od__card-title { font-size: var(--font-md); font-weight: 600; color: var(--text-1); margin-bottom: 16rpx; }

/* O1 状态头 */
.od__status-head { padding: 32rpx 28rpx; border-radius: var(--r-lg); margin-bottom: 20rpx; }
.od__status-name { font-size: var(--font-display); font-weight: 700; }
.od__status-count { margin-top: 8rpx; font-size: var(--font-sm); color: var(--text-2); }
.od__order-no { margin-top: 12rpx; font-size: var(--font-xs); color: var(--text-4); }

/* 引导横幅: 下一步做什么 */
.od__next-step {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--r-md);
  margin-bottom: 20rpx;
  border: 1rpx solid;
}
.od__next-ic { font-size: 36rpx; flex-shrink: 0; }
.od__next-text { flex: 1; min-width: 0; }
.od__next-title { font-size: var(--font-sm); font-weight: 600; }
.od__next-sub { font-size: var(--font-xs); margin-top: 4rpx; opacity: 0.75; }
.od__next-btn {
  flex-shrink: 0;
  font-size: var(--font-xs);
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
  font-weight: 600;
}
/* tone 主题: primary=主行动, warn=需注意, info=提示, mute=等待 */
.od__next-step--primary {
  background: rgba(76, 175, 80, 0.1);
  border-color: var(--func-success, #4caf50);
}
.od__next-step--primary .od__next-btn {
  background: var(--func-success, #4caf50);
  color: #fff;
}
.od__next-step--warn {
  background: rgba(250, 81, 81, 0.12);
  border-color: var(--func-danger, #fa5151);
  border-width: 2rpx;
}
.od__next-step--warn .od__next-title { color: var(--func-danger, #fa5151); font-weight: 700; }
.od__next-step--warn .od__next-btn {
  background: var(--func-danger, #fa5151);
  color: #fff;
  font-size: var(--font-md);
  padding: 14rpx 28rpx;
  border-radius: 32rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 16rpx rgba(250, 81, 81, 0.4);
  animation: od-pay-pulse 1.8s ease-in-out infinite;
}
@keyframes od-pay-pulse {
  0%, 100% { transform: scale(1); box-shadow: 0 4rpx 16rpx rgba(250, 81, 81, 0.4); }
  50% { transform: scale(1.06); box-shadow: 0 6rpx 24rpx rgba(250, 81, 81, 0.65); }
}
.od__next-step--info {
  background: rgba(24, 144, 255, 0.1);
  border-color: var(--brand-primary, #1890ff);
}
.od__next-step--info .od__next-btn {
  background: var(--brand-primary, #1890ff);
  color: #fff;
}
.od__next-step--mute {
  background: var(--bg-segment);
  border-color: var(--border-divider);
}
.od__next-step--mute .od__next-btn {
  background: var(--text-3);
  color: #fff;
}

.od__tags { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.od__row { display: flex; justify-content: space-between; padding: 12rpx 0; border-bottom: 1rpx solid var(--border-divider); }
.od__row:last-child { border-bottom: none; }
.od__label { font-size: var(--font-sm); color: var(--text-3); }
.od__val { font-size: var(--font-sm); color: var(--text-1); }
.od__val--strong { font-weight: 600; color: var(--func-danger); }
.od__val--success { color: var(--func-success); }

/* O3 操作区 */
.od__btn { width: 100%; height: 80rpx; line-height: 80rpx; border-radius: 40rpx; font-size: var(--font-md); margin-top: 16rpx; }
.od__btn::after { border: none; }
.od__btn--primary { background: var(--brand-primary); color: var(--text-invert); }
.od__btn--ghost { background: var(--bg-segment); color: var(--text-2); }
.od__btn--danger { background: var(--func-danger); color: var(--text-invert); }

.od__action-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.od__action-btn { height: 120rpx; line-height: 1.4; padding: 20rpx 0; background: var(--bg-segment); color: var(--text-1); font-size: var(--font-sm); border-radius: var(--r-md); display: flex; flex-direction: column; align-items: center; justify-content: center; }
.od__action-btn::after { border: none; }
.od__action-btn--primary { background: var(--brand-primary); color: var(--text-invert); }
.od__action-btn--disabled { opacity: 0.4; pointer-events: none; }

/* 安全中心(图5) */
.od__safety-grid { display: flex; gap: 20rpx; }
.od__sos-btn,
.od__report-btn {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: var(--r-md);
  font-size: var(--font-md);
  font-weight: 600;
  padding: 0;
  margin: 0;
}
.od__sos-btn { background: #d9413b; color: #fff; }
.od__report-btn { background: #fff; color: #d9413b; border: 2rpx solid #f0b7b4; }
.od__sos-btn::after,
.od__report-btn::after { border: none; }
.od__safety-desc { margin-top: 16rpx; font-size: var(--font-xs); color: var(--text-4); line-height: 1.6; }
.od__checkin-list { margin-top: 8rpx; border-top: 1rpx solid var(--border-divider); }
.od__checkin-item {
  display: flex;
  align-items: center;
  height: 72rpx;
  border-bottom: 1rpx solid var(--border-divider);
}
.od__checkin-item:last-child { border-bottom: none; }
.od__checkin-ic { font-size: var(--font-md); margin-right: 12rpx; }
.od__checkin-text { flex: 1; font-size: var(--font-sm); color: var(--text-2); }
.od__checkin-time { font-size: var(--font-sm); color: var(--text-4); }

/* 里程碑进度条 */
.od__milestone { padding: 20rpx 0 24rpx; margin-bottom: 16rpx; }
.od__ms-title { font-size: var(--font-sm); color: var(--text-2); margin-bottom: 20rpx; }
.od__ms-steps { display: flex; align-items: center; justify-content: space-between; }
.od__ms-step { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.od__ms-dot { width: 56rpx; height: 56rpx; border-radius: 50%; background: var(--bg-segment); color: var(--text-disabled); display: flex; align-items: center; justify-content: center; font-size: var(--font-sm); font-weight: 600; }
.od__ms-step.is-done .od__ms-dot { background: var(--brand-primary); color: var(--text-invert); }
.od__ms-label { font-size: var(--font-xs); color: var(--text-disabled); }
.od__ms-step.is-done .od__ms-label { color: var(--brand-primary); font-weight: 500; }
.od__ms-line { flex: 1; height: 4rpx; background: var(--bg-segment); margin: 0 12rpx; margin-bottom: 28rpx; }
.od__ms-line.is-done { background: var(--brand-primary); }
.od__ms-submit { margin-top: 24rpx; }
.od__ms-hint { font-size: var(--font-xs); color: var(--text-disabled); text-align: center; margin-top: 12rpx; }

.od__safety-confirm, .od__ratio-confirm { padding: 16rpx 0; }
.od__safety-q { font-size: var(--font-md); color: var(--text-1); margin-bottom: 16rpx; text-align: center; }
.od__safety-btns { display: flex; gap: 16rpx; }
.od__safety-btns .od__btn { flex: 1; margin-top: 0; }
.od__safety-tip { margin-top: 12rpx; font-size: var(--font-xs); color: var(--func-danger); text-align: center; }

.od__after-sale-tip, .od__terminated-tip { padding: 24rpx 0; text-align: center; font-size: var(--font-sm); color: var(--text-3); }

/* S2.5 改期待确认 */
.od__modify-pending { padding: 12rpx 0; }
.od__modify-pending-title { text-align: center; font-size: var(--font-md); font-weight: 600; color: var(--text-1); padding: 12rpx 0; }
.od__modify-pending .od__after-sale-tip { padding: 6rpx 0; }

/* O4 改期内联卡 */
.od__modify-panel {
  margin-top: 20rpx;
  background: var(--bg-card);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-card);
  padding: 8rpx 28rpx 24rpx;
}
.od__modify-tip { font-size: var(--font-xs); color: var(--text-4); padding: 12rpx 0; line-height: 1.6; }
.od__picker-row { display: flex; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid var(--border-divider); }
.od__picker-label { width: 120rpx; font-size: var(--font-sm); color: var(--text-3); }
.od__picker-val { flex: 1; font-size: var(--font-md); color: var(--text-1); }
.od__picker-val.is-empty { color: var(--text-5); }
.od__arrow { color: var(--text-4); }
.od__panel-btns { display: flex; gap: 16rpx; margin-top: 20rpx; }
.od__panel-btns .od__btn { flex: 1; margin-top: 0; }

/* 三态骨架屏 */
.od__loading { padding: 16rpx; }
.od__skeleton { height: 120rpx; background: var(--bg-segment); border-radius: var(--r-md); margin-bottom: 16rpx; animation: od-skeleton-pulse 1.2s ease-in-out infinite; }
@keyframes od-skeleton-pulse { 0%,100% { opacity: 0.5; } 50% { opacity: 1; } }
