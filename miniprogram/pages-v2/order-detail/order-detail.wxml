<view class="v2 od">
  <nav-bar title="订单详情"></nav-bar>

  <!-- 加载态 -->
  <view class="od__loading" wx:if="{{loading}}">
    <view class="od__skeleton" wx:for="{{[1,2,3]}}" wx:key="*this"></view>
  </view>
  <!-- 网络异常态 -->
  <empty-state wx:elif="{{loadError}}" icon="📡" title="网络异常" desc="请检查网络后重试" btnText="重试" bind:btntap="reload" />
  <!-- 正常态 -->
  <block wx:elif="{{order}}">
  <view class="od__body">
    <!-- O1 状态头 -->
    <view class="od__status-head" style="background:{{statusInfo.bgTag}};">
      <view class="od__status-name" style="color:{{statusInfo.colorTag}};">{{statusInfo.name}}</view>
      <view class="od__status-count" wx:if="{{countdownText}}">{{countdownText}}</view>
      <view class="od__order-no">订单号 #{{order.order_no}}</view>
    </view>

    <!-- 到账通知列表(被打赏等多条依次展示; 点单条标记已读并移除) -->
    <view class="od__tip-list" wx:if="{{tipNotices.length > 0}}">
      <view
        class="od__tip-banner"
        wx:for="{{tipNotices}}" wx:key="id"
        data-id="{{item.id}}"
        bindtap="onTipNoticeTap"
        hover-class="od__tip-banner--hover"
      >
        <text class="od__tip-text">{{item.text}}</text>
        <text class="od__tip-time">{{item.time}}</text>
      </view>
    </view>

    <!-- 引导横幅: 下一步做什么 -->
    <view class="od__next-step od__next-step--{{nextStep.tone}}" wx:if="{{nextStep}}">
      <view class="od__next-ic">{{nextStep.icon}}</view>
      <view class="od__next-text">
        <view class="od__next-title">{{nextStep.title}}</view>
        <view class="od__next-sub">{{nextStep.subtitle}}</view>
      </view>
      <view class="od__next-btn" wx:if="{{nextStep.action}}" bindtap="onNextStepTap">{{nextStep.action.text}} ›</view>
    </view>

    <!-- O1 13态进度轴 -->
    <view class="od__card">
      <order-progress status="{{order.status}}"></order-progress>
    </view>

    <!-- 订单信息(概要三行沿用消息页 order_summary l1/l2/l3; 金额/场景标签保留) -->
    <view class="od__card">
      <view class="od__card-title">订单信息</view>
      <view class="od__tags">
        <tag-chip type="scene" scene-code="{{scene.code}}" wx:if="{{scene}}"></tag-chip>
        <tag-chip type="gongyi" wx:if="{{order.project_attr === 'public_welfare'}}" />
      </view>
      <view class="od__row" wx:if="{{order.scene_content_text}}">
        <text class="od__label">子场景</text>
        <text class="od__val">{{order.scene_content_text}}</text>
      </view>
      <view class="od__summary-box" wx:if="{{orderSummary && orderSummary.l1}}">
        <view class="od__summary-line od__summary-line--l1">{{orderSummary.l1}}</view>
        <view class="od__summary-line" wx:if="{{orderSummary.l2}}">{{orderSummary.l2}}</view>
        <view class="od__summary-line" wx:if="{{orderSummary.l3}}">{{orderSummary.l3}}</view>
      </view>
      <view class="od__row" wx:if="{{order.partner_name}}"><text class="od__label">耍伴</text><text class="od__val">{{order.partner_name}}</text></view>
      <!-- 打赏记录(双方可见; 发单人"已打赏", 耍伴"收到打赏", 累计金额+逐笔明细) -->
      <view class="od__row" wx:if="{{order.tip_total_fen > 0}}">
        <text class="od__label">打赏</text>
        <text class="od__val od__val--tip">{{order.my_role === 'user' ? '已打赏' : '收到打赏'}} ¥{{tipTotalYuan}}</text>
      </view>
      <view class="od__tip-list" wx:if="{{tipList.length}}">
        <view class="od__tip-item" wx:for="{{tipList}}" wx:key="pay_no">
          <text class="od__tip-am">¥{{item.amountYuan}}{{item.note ? ' · ' + item.note : ''}}</text>
          <text class="od__tip-tm">{{item.timeText}}</text>
        </view>
      </view>
    </view>

    <!-- O2 安全中心(图5): 履约活跃状态双方可见, 紧急求助+安全报备+最近报备记录 -->
    <view class="od__card" wx:if="{{order.status === 'S2' || order.status === 'S3' || order.status === 'S3_5' || order.status === 'S4'}}">
      <view class="od__card-title">🛡️ 安全中心</view>
      <view class="od__safety-grid">
        <button class="od__sos-btn" bindtap="onSos" hover-class="btn-press">🆘 紧急求助</button>
        <button class="od__report-btn" bindtap="onSafety" hover-class="btn-press">📍 安全报备</button>
      </view>
      <view class="od__safety-desc">紧急求助将记录位置并通知平台；安全报备可向对方报平安</view>
      <view class="od__checkin-list" wx:if="{{safety.checkins.length > 0}}">
        <view class="od__checkin-item" wx:for="{{safety.checkins}}" wx:key="key">
          <text class="od__checkin-ic">✅</text>
          <text class="od__checkin-text">{{item.text}}</text>
          <text class="od__checkin-time">{{item.time}}</text>
        </view>
      </view>
    </view>

    <!-- O7 保险卡 -->
    <view class="od__card" wx:if="{{order.insurance && order.insurance.policy_no}}">
      <view class="od__card-title">保险保障</view>
      <view class="od__row"><text class="od__label">保单号</text><text class="od__val">{{order.insurance.policy_no}}</text></view>
      <view class="od__row"><text class="od__label">保额</text><text class="od__val">{{insuranceWan}}万元</text></view>
      <view class="od__row"><text class="od__label">状态</text><text class="od__val od__val--success">{{order.insurance.status === 'insured' ? '生效中' : '待生效'}}</text></view>
    </view>

    <!-- O3.5 爽约申诉(第三批 3B): 处理中/已裁定 + 被诉方举证入口 -->
    <view class="od__card" wx:if="{{noShowReports.length > 0}}">
      <view class="od__card-title">爽约申诉</view>
      <view class="od__nsitem" wx:for="{{noShowReports}}" wx:key="report_id">
        <view class="od__nsitem-head">
          <text class="od__nsitem-role">{{item.my_role === 'reporter' ? '你提交的申诉' : '对方提交的申诉'}}</text>
          <text class="od__nsitem-status {{item.status === 'decided' ? (item.verdict === 'upheld' ? 'is-upheld' : 'is-rejected') : 'is-pending'}}">{{item.status_text}}</text>
        </view>
        <view class="od__nsitem-reason" wx:if="{{item.reason_display}}">{{item.reason_display}}</view>
        <view class="od__nsitem-sub" wx:if="{{item.status !== 'decided'}}">举证截止：{{item.deadline_text}}{{item.defense_overdue ? '（已逾期，平台可直接裁定）' : ''}}</view>
        <button class="od__btn od__btn--primary" wx:if="{{item.can_defense}}" data-id="{{item.report_id}}" bindtap="onNoShowDefense" hover-class="btn-press">提交举证</button>
      </view>
    </view>

    <!-- O3 操作区 -->
    <view class="od__card">
      <view class="od__card-title">操作</view>

      <!-- 联系信息(过渡版, 2026-10-09): 接单方且已支付后展示对方脱敏号; 拨打为占位(二期接号码保护) -->
      <view class="od__contact" wx:if="{{contactDisplay}}">
        <view class="od__contact-row">
          <text class="od__contact-who">📞 {{contactDisplay.who}}</text>
          <text class="od__contact-num">{{contactDisplay.masked}}</text>
          <view class="od__contact-call" hover-class="btn-press" bindtap="onCallPlaceholder">拨打</view>
        </view>
        <view class="od__contact-note">{{contactDisplay.note}}</view>
      </view>

      <!-- S0 待支付 -->
      <block wx:if="{{order.status === 'S0'}}">
        <block wx:if="{{order.my_role === 'user'}}">
          <button class="od__btn od__btn--primary" bindtap="goPay" hover-class="btn-press">去支付</button>
          <button class="od__btn od__btn--ghost" bindtap="onCancel" hover-class="btn-press">取消订单</button>
        </block>
        <block wx:else>
          <button class="od__btn od__btn--disabled" disabled>⏳ 等待用户支付</button>
        </block>
      </block>

      <!-- S1 待确认 -->
      <block wx:elif="{{order.status === 'S1'}}">
        <button class="od__btn od__btn--primary" bindtap="goChat" hover-class="btn-press">进入聊天完成四确认</button>
      </block>

      <!-- S2 已支付待履约 -->
      <block wx:elif="{{order.status === 'S2'}}">
        <block wx:if="{{order.my_role === 'partner'}}">
          <button class="od__btn od__btn--primary" bindtap="onStartService" hover-class="btn-press">开始履约</button>
          <button class="od__btn od__btn--ghost" bindtap="goChat" hover-class="btn-press">联系用户</button>
        </block>
        <block wx:else>
          <button class="od__btn od__btn--primary" bindtap="onViewPrep" hover-class="btn-press">📋 查看履约准备</button>
          <button class="od__btn od__btn--ghost" bindtap="goChat" hover-class="btn-press">联系耍伴</button>
        </block>
        <!-- 改期入口: 仅 S2 可发起(2026-10-07 口径; S3 履约中/S3.5 中断均不可改期) -->
        <button class="od__btn od__btn--ghost" bindtap="onModify" hover-class="btn-press">📅 申请改期</button>
        <!-- 报告爽约(第三批 3B): 约定开始时间已过且时限内可见; 服务端二次校验 S2/S3.5+时限 -->
        <button class="od__btn od__btn--danger" wx:if="{{canNoShowReport}}" bindtap="onNoShowReport" hover-class="btn-press">⚠️ 报告爽约</button>
      </block>

      <!-- S3 履约中 -->
      <block wx:elif="{{order.status === 'S3'}}">
        <!-- 里程碑进度条 -->
        <view class="od__milestone">
          <view class="od__ms-title">履约进度 {{order.milestone.current}}/3</view>
          <view class="od__ms-steps">
            <block wx:for="{{order.milestoneSteps}}" wx:key="idx">
              <view class="od__ms-step {{item.done ? 'is-done' : ''}}">
                <view class="od__ms-dot">{{item.done ? '✓' : item.idx}}</view>
                <view class="od__ms-label">{{item.label}}</view>
              </view>
              <view class="od__ms-line {{index < order.milestone.current ? 'is-done' : ''}}" wx:if="{{index < 2}}"></view>
            </block>
          </view>
          <button class="od__btn od__btn--ghost od__ms-submit" wx:if="{{order.milestone.current < 3 && order.my_role === 'partner'}}" bindtap="onMilestoneSubmit" hover-class="btn-press">
            提交{{order.nextPercent}}%履约进度
          </button>
        </view>
        <view class="od__action-grid">
          <button class="od__action-btn {{order.pending_extend ? 'od__action-btn--disabled' : ''}}" wx:if="{{!order.pending_extend && !finishingService}}" bindtap="onAddTime" hover-class="btn-press">⏰ 加时申请</button>
          <button class="od__action-btn {{(order.canFinishService && !finishingService) ? 'od__action-btn--primary' : 'od__action-btn--disabled'}}" hover-class="btn-press" wx:if="{{order.my_role === 'partner'}}" bindtap="onFinishService" disabled="{{finishingService}}">✓ {{finishingService ? '提交中…' : '履约完成'}}</button>
        </view>
        <!-- 加时在途: S3 内嵌提示 + 对方确认/拒绝按钮 -->
        <view class="od__pending-banner {{order.pending_extend.can_respond ? 'od__pending-banner--mine' : 'od__pending-banner--wait'}}" wx:if="{{order.pending_extend}}">
          <view class="od__pending-banner-title">
            <text wx:if="{{order.pending_extend.can_respond}}" class="od__pending-banner-tag">待你确认</text>
            ⏰ 加时申请 +{{order.pending_extend.add_hours}}小时 · ¥{{order.pending_extend.add_amount_fen / 100}}
          </view>
          <view class="od__pending-banner-sub">{{order.pending_extend.expire_text}}，超时自动拒绝</view>
          <view class="od__pending-banner-sub" wx:if="{{order.pending_extend.by_role === 'user'}}">发单人发起的加时</view>
          <view class="od__pending-banner-sub" wx:else>耍伴发起的加时</view>
          <view class="od__pending-banner-reason" wx:if="{{order.pending_extend.reason}}">📝 {{order.pending_extend.reason}}</view>
        </view>
        <view class="od__safety-btns" wx:if="{{order.pending_extend && order.pending_extend.can_respond}}">
          <button class="od__btn od__btn--ghost" bindtap="onExtendConfirm" hover-class="btn-press">拒绝加时</button>
          <button class="od__btn od__btn--primary" bindtap="onExtendConfirm" hover-class="btn-press">同意加时</button>
        </view>
        <view class="od__after-sale-tip" wx:elif="{{order.pending_extend}}">等待对方确认…</view>
        <view class="od__ms-hint" wx:if="{{order.my_role === 'partner' && !order.canFinishService}}">须先提交到100%才能完成履约</view>
      </block>

      <!-- S3.5 履约中断（PRD 3.5.2 nextActions: resume/confirm） -->
      <block wx:elif="{{order.status === 'S3_5'}}">
        <view class="od__safety-confirm">
          <view class="od__safety-q">履约中断处理</view>
          <view class="od__safety-tip">{{s35ResponseMin}}分钟内未响应自动确认 · {{statusInfo.timeoutText}}</view>
          <view class="od__safety-btns">
            <button class="od__btn od__btn--ghost" bindtap="onResumeService" hover-class="btn-press">恢复履约</button>
            <button class="od__btn od__btn--primary" bindtap="onToPartial" hover-class="btn-press">确认部分完成</button>
          </view>
        </view>
        <!-- 报告爽约(第三批 3B): S3.5 履约中断可申诉 -->
        <button class="od__btn od__btn--danger" wx:if="{{canNoShowReport}}" bindtap="onNoShowReport" hover-class="btn-press">⚠️ 报告爽约</button>
      </block>

      <!-- S4 部分完成 -->
      <block wx:elif="{{order.status === 'S4'}}">
        <view class="od__ratio-confirm">
          <view class="od__safety-q">部分完成比例确认</view>
          <button class="od__btn od__btn--primary" bindtap="onRatioConfirm" hover-class="btn-press">确认比例</button>
        </view>
      </block>

      <!-- S5 已完成 -->
      <block wx:elif="{{order.status === 'S5'}}">
        <button class="od__btn od__btn--primary" wx:if="{{order.my_role === 'user'}}" bindtap="onEvaluate" hover-class="btn-press">去评价</button>
        <button class="od__btn od__btn--ghost" wx:if="{{order.my_role === 'user' && tipEnabled}}" bindtap="onTip" hover-class="btn-press">💝 打赏耍伴</button>
        <button class="od__btn od__btn--ghost" wx:elif="{{order.my_role !== 'user'}}" disabled>⏳ 等待用户评价</button>
      </block>

      <!-- S8 已评价（PRD 3.5.2 nextActions: complaint） -->
      <block wx:elif="{{order.status === 'S8'}}">
        <view class="od__after-sale-tip">售后窗口{{afterSaleDays}}天</view>
        <button class="od__btn od__btn--ghost" wx:if="{{order.my_role === 'user' && tipEnabled}}" bindtap="onTip" hover-class="btn-press">💝 打赏耍伴</button>
        <button class="od__btn od__btn--danger" bindtap="onComplaint" hover-class="btn-press">发起投诉</button>
      </block>

      <!-- S2.5 改期处理中（PRD 3.5.2/3.5.3：对方2小时内确认，超时自动拒绝） -->
      <block wx:elif="{{order.status === 'S2_5'}}">
        <view class="od__terminated-tip">{{statusInfo.name}}</view>
        <view class="od__pending-banner {{order.pending_modify.can_respond ? 'od__pending-banner--mine' : 'od__pending-banner--wait'}}" wx:if="{{order.pending_modify}}">
          <view class="od__pending-banner-title">
            <text wx:if="{{order.pending_modify.can_respond}}" class="od__pending-banner-tag">待你确认</text>
            📅 改期申请 · 改至 {{order.pending_modify.new_date}} {{order.pending_modify.new_time}}
          </view>
          <view class="od__pending-banner-sub">{{statusInfo.timeoutText}}，超时自动拒绝</view>
          <view class="od__pending-banner-sub" wx:if="{{order.pending_modify.by_role === 'user'}}">发单人发起的改期</view>
          <view class="od__pending-banner-sub" wx:else>耍伴发起的改期</view>
          <view class="od__pending-banner-reason" wx:if="{{order.pending_modify.reason}}">📝 {{order.pending_modify.reason}}</view>
        </view>
        <view class="od__safety-btns" wx:if="{{order.pending_modify.can_respond}}">
          <button class="od__btn od__btn--ghost" bindtap="onModifyReject" hover-class="btn-press">拒绝改期</button>
          <button class="od__btn od__btn--primary" bindtap="onModifyConfirm" hover-class="btn-press">同意改期</button>
        </view>
        <view class="od__after-sale-tip" wx:elif="{{order.pending_modify}}">等待对方确认…</view>
      </block>

      <!-- S10.5 争议处理中（PRD 3.5.2 nextActions: arbitration） -->
      <block wx:elif="{{order.status === 'S10_5'}}">
        <view class="od__terminated-tip">{{statusInfo.name}}</view>
        <view class="od__after-sale-tip">{{statusInfo.timeoutText}}</view>
      </block>

      <!-- S6/S7/S9/S10 已终止态（PRD 3.5.2 nextActions 为空） -->
      <block wx:else>
        <view class="od__terminated-tip">{{statusInfo.name}}</view>
      </block>
    </view>
  </view>

  <!-- O4 改期内联卡(原生 date/time picker + 提交时 wx.showModal 二次确认, 替代 bottom-sheet) -->
  <view class="od__modify-panel" wx:if="{{modifyPanelVisible}}">
    <view class="od__modify-tip">{{modifyRuleText}}</view>
    <picker mode="date" start="{{modifyDateMin}}" end="{{timeMaxRange}}" value="{{modifyDate}}" bindchange="onModifyDateChange">
      <view class="od__picker-row">
        <text class="od__picker-label">新日期</text>
        <text class="od__picker-val {{modifyDate ? '' : 'is-empty'}}">{{modifyDate || '请选择'}}</text>
        <text class="od__arrow">›</text>
      </view>
    </picker>
    <picker mode="time" start="{{redlineOpen}}" end="{{redlineClose}}" value="{{modifyTime}}" bindchange="onModifyTimeChange">
      <view class="od__picker-row">
        <text class="od__picker-label">新时间</text>
        <text class="od__picker-val {{modifyTime ? '' : 'is-empty'}}">{{modifyTime || '请选择'}}</text>
        <text class="od__arrow">›</text>
      </view>
    </picker>
    <view class="od__reason-row">
      <text class="od__picker-label">改期原因（选填）</text>
      <textarea class="od__reason-input" placeholder="简要说明改期原因,如:临时有事、时间安排冲突..." value="{{modifyReason}}" bindinput="onModifyReasonInput" maxlength="{{modifyReasonMax}}" auto-height />
      <text class="od__reason-count">{{modifyReason.length}}/{{modifyReasonMax}}</text>
    </view>
    <view class="od__panel-btns">
      <button class="od__btn od__btn--ghost" bindtap="closeModifyPanel" hover-class="btn-press">取消</button>
      <button class="od__btn od__btn--primary" bindtap="submitModify" hover-class="btn-press">提交改期</button>
    </view>
  </view>

  <!-- 加时申请面板: 时长选择(1-12h) + 参考单价 -->
  <view class="od__modify-panel" wx:if="{{extendPanelVisible}}">
    <view class="od__modify-tip" wx:if="{{extendIsFixed}}">一口价订单加时不加价 · 仅延长服务时长 · 对方确认后合并进结算</view>
    <view class="od__modify-tip" wx:else>加时按原单价折算 · 参考单价 ¥{{extendRefPriceFen / 100}}/小时 · 对方确认后合并进结算</view>
    <view class="od__picker-row">
      <text class="od__picker-label">加时时长</text>
      <view class="od__extend-hours">
        <block wx:for="{{[1,2,3,4,6,8]}}" wx:key="*this">
          <text class="od__hour-chip {{extendHours === item ? 'is-active' : ''}}" bindtap="onExtendHoursTap" data-hours="{{item}}">{{item}}h</text>
        </block>
        <view class="od__hour-custom">
          <text class="od__hour-chip {{extendHours > 8 ? 'is-active' : ''}}" bindtap="onExtendHoursTap" data-hours="10">10h</text>
          <text class="od__hour-chip {{extendHours === 12 ? 'is-active' : ''}}" bindtap="onExtendHoursTap" data-hours="12">12h</text>
        </view>
      </view>
    </view>
    <view class="od__reason-row">
      <text class="od__picker-label">申请原因（选填）</text>
      <textarea class="od__reason-input" placeholder="简要说明加时原因,如:项目进度未完成、需要额外时间..." value="{{extendReason}}" bindinput="onExtendReasonInput" maxlength="{{extendReasonMax}}" auto-height />
      <text class="od__reason-count">{{extendReason.length}}/{{extendReasonMax}}</text>
    </view>
    <view class="od__panel-btns">
      <button class="od__btn od__btn--ghost" bindtap="closeExtendPanel" hover-class="btn-press">取消</button>
      <button class="od__btn od__btn--primary" bindtap="submitExtend" hover-class="btn-press">提交加时</button>
    </view>
  </view>
  </block>
  <!-- 空态 -->
  <empty-state wx:else icon="📭" title="数据不存在" desc="该记录可能已被删除" />
  <night-mask visible="{{isRedline}}" bind:reserve="onReserve"></night-mask>
</view>
