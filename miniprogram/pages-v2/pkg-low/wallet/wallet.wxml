<view class="v2 wt">
  <nav-bar title="收入钱包"></nav-bar>

  <view class="wt__body">
    <!-- 加载态 -->
    <view class="wt__loading" wx:if="{{loading}}">
      <view class="wt__skeleton" wx:for="{{[1,2,3,4]}}" wx:key="*this"></view>
    </view>
    <!-- 网络异常态 -->
    <empty-state wx:elif="{{loadError}}" icon="📡" title="网络异常" desc="请检查网络后重试" btnText="重试" bind:btntap="reload" />
    <!-- 正常态 -->
    <block wx:else>
    <!-- V1 余额头 -->
    <view class="wt__balance-card">
      <view class="wt__balance-label">可提现余额（元）</view>
      <view class="wt__balance-num">{{balanceYuan}}</view>
      <view class="wt__income-row">
        <view class="wt__income-item">
          <text class="wt__income-label">本月收入</text>
          <text class="wt__income-val">¥{{monthIncomeYuan}}</text>
        </view>
        <view class="wt__income-divider"></view>
        <view class="wt__income-item">
          <text class="wt__income-label">累计收入</text>
          <text class="wt__income-val">¥{{totalIncomeYuan}}</text>
          <text class="wt__income-tip" wx:if="{{tipIncomeYuan > 0}}">其中打赏 ¥{{tipIncomeYuan}}</text>
        </view>
      </view>
      <button class="wt__withdraw-btn" bindtap="openWithdraw" hover-class="btn-press">提现</button>
    </view>

    <!-- V2 极速提现资格 -->
    <view class="wt__card">
      <view class="wt__card-title-row">
        <text class="wt__card-title">⚡ 新耍伴前{{fastMax}}单T+{{fastArriveDays}}极速提现</text>
      </view>
      <view class="wt__fast-progress">
        <view class="wt__fast-bar" style="width:{{fastProgress}}%;"></view>
      </view>
      <view class="wt__fast-tip">已用 {{fastUsed}}/{{fastMax}} 次</view>
    </view>

    <!-- V3 四态tab -->
    <view class="wt__card">
      <view class="wt__fund-tabs">
        <view class="wt__fund-tab {{fundActive === item.key ? 'is-on' : ''}}" wx:for="{{fundTabs}}" wx:key="key" data-key="{{item.key}}" bindtap="onFundTabTap">
          {{item.name}}
        </view>
      </view>
      <view class="wt__fund-amount">¥{{fundAmount}}</view>
    </view>

    <!-- V4 收益明细: 接单收入/打赏 两专栏 + 时间段条件查询 + 汇总 -->
    <view class="wt__card">
      <view class="wt__sec-tabs">
        <view class="wt__sec-tab {{walletTab === 'income' ? 'is-on' : ''}}" data-tab="income" bindtap="onWalletTabTap">接单收入</view>
        <view class="wt__sec-tab {{walletTab === 'tip' ? 'is-on' : ''}}" data-tab="tip" bindtap="onWalletTabTap">打赏</view>
      </view>
      <view class="wt__range-tabs">
        <view class="wt__range-tab {{rangeKey === item.key ? 'is-on' : ''}}" wx:for="{{rangeTabs}}" wx:key="key" data-key="{{item.key}}" bindtap="onRangeTap">{{item.name}}</view>
      </view>
      <view class="wt__sec-summary">
        <text class="wt__sec-summary-count">{{walletTab === 'income' ? incomeSummary.count : tipSummary.count}} 笔</text>
        <text class="wt__sec-summary-amt">合计 ¥{{walletTab === 'income' ? incomeSummary.totalYuan : tipSummary.sumYuan}}</text>
      </view>

      <!-- 接单收入明细(已结算订单, 服务费口径) -->
      <block wx:if="{{walletTab === 'income'}}">
        <view class="wt__income-item-row" wx:for="{{incomeList}}" wx:key="order_id">
          <view class="wt__income-row-left">
            <view class="wt__income-name">{{item.scene_name}}</view>
            <view class="wt__income-meta">单号 {{item.order_no}}</view>
            <view class="wt__income-time">{{item.created_at}}</view>
          </view>
          <view class="wt__income-row-right">
            <view class="wt__income-net">实收 ¥{{item.netYuan}}</view>
          </view>
        </view>
        <empty-state wx:if="{{!incomeList.length}}" icon="💸" title="暂无接单收入" desc="切换时间段或完成更多订单后查看" />
      </block>

      <!-- 打赏明细(逐笔流水) -->
      <block wx:else>
        <view class="wt__income-item-row" wx:for="{{tipList}}" wx:key="pay_no">
          <view class="wt__income-row-left">
            <view class="wt__income-name">
              {{item.scene_name || '打赏'}}
              <text class="wt__tip-note" wx:if="{{item.note}}">· {{item.note}}</text>
            </view>
            <view class="wt__income-meta">单号 {{item.order_no}}</view>
            <view class="wt__income-time">{{item.created_at}}</view>
          </view>
          <view class="wt__income-row-right">
            <view class="wt__tip-amt">+¥{{item.amountYuan}}</view>
          </view>
        </view>
        <empty-state wx:if="{{!tipList.length}}" icon="💝" title="暂无打赏" desc="完成服务后发单人可打赏你" />
      </block>
    </view>

    <!-- V6 提现记录 -->
    <view class="wt__card" wx:if="{{withdrawList.length > 0}}">
      <view class="wt__card-title">提现记录</view>
      <view class="wt__wd-item" wx:for="{{withdrawList}}" wx:key="withdraw_no">
        <view class="wt__wd-left">
          <view class="wt__wd-name">
            {{item.typeText}}
            <text class="wt__wd-status {{item.arrived ? 'is-arrived' : 'is-processing'}}">{{item.statusText}}</text>
          </view>
          <view class="wt__income-meta">单号 {{item.withdraw_no}}</view>
          <view class="wt__income-meta">{{item.created_text}} 申请</view>
          <view class="wt__income-meta" wx:if="{{item.arrived}}">{{item.arrived_text}} 到账</view>
        </view>
        <view class="wt__wd-right">¥{{item.amountYuan}}</view>
      </view>
    </view>

    <!-- V6 工具行 -->
    <view class="wt__tools">
      <view class="wt__tool" data-name="发票管理" bindtap="onToolTap">发票管理</view>
      <view class="wt__tool" data-name="完税证明" bindtap="onToolTap">完税证明</view>
      <view class="wt__tool" data-name="冻结资金" bindtap="onToolTap">冻结资金</view>
      <view class="wt__tool" data-name="银行卡管理" bindtap="onToolTap">银行卡管理</view>
    </view>
    </block>
  </view>

  <!-- V5 提现弹窗 -->
  <bottom-sheet visible="{{withdrawSheetVisible}}" title="提现" bind:close="closeWithdraw" has-footer="{{true}}">
    <view class="wt__withdraw-input-row">
      <text class="wt__withdraw-symbol">¥</text>
      <input class="wt__withdraw-input" type="digit" value="{{withdrawAmount}}" placeholder="请输入金额" bindinput="onWithdrawAmountInput" />
    </view>
    <view class="wt__withdraw-tip">可提现余额 ¥{{balanceYuan}}</view>
    <view class="wt__fast-row">
      <text>⚡ 极速提现（T+{{fastArriveDays}}）</text>
      <switch checked="{{fastWithdraw}}" color="var(--brand-primary)" bindchange="onFastToggle" />
    </view>
    <view class="wt__bank-row">
      <text class="wt__bank-label">到账银行卡</text>
      <text class="wt__bank-val">尾号 {{bankTail}}</text>
    </view>
    <view slot="footer" class="wt__sheet-btns">
      <button class="wt__btn wt__btn--ghost" bindtap="closeWithdraw" hover-class="btn-press">取消</button>
      <button class="wt__btn wt__btn--primary" bindtap="confirmWithdraw" hover-class="btn-press">确认提现</button>
    </view>
  </bottom-sheet>

  <night-mask visible="{{isRedline}}" bind:reserve="onReserve"></night-mask>
</view>
