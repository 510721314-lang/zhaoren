<view class="pa">
  <!-- 批3c: 入驻链步骤条(仅 from=chain 进入时展示) -->
  <view class="pa__stepbar" wx:if="{{chainBar}}">入驻进度 {{chainBar.index}}/{{chainBar.total}} · {{chainBar.label}}</view>
  <view class="pa__hero">
    <view class="pa__hero-emoji">🧑‍🤝‍🧑</view>
    <view class="pa__hero-title">申请成为耍伴</view>
    <view class="pa__hero-sub">选择你能提供帮助的场景, 入驻后即刻接单</view>
  </view>

  <!-- 已提交状态回显: 审核中不再鼓励重复提交; 驳回展示原因 -->
  <view class="pa__banner pa__banner--pending" wx:if="{{applyStatus === 'pending_review'}}">
    <view class="pa__banner-title">申请审核中</view>
    <view class="pa__banner-desc">平台通常 24 小时内完成审核，通过后自动开通接单权限。可在此调整场景/位置后重新提交，不影响排队。</view>
  </view>
  <view class="pa__banner pa__banner--rejected" wx:elif="{{applyStatus === 'rejected'}}">
    <view class="pa__banner-title">上次申请未通过</view>
    <view class="pa__banner-desc">{{rejectNote ? '原因：' + rejectNote : '请检查资料后重新提交。'}}</view>
  </view>
  <view class="pa__banner pa__banner--ok" wx:elif="{{applyStatus === 'approved' || alreadyPartner}}">
    <view class="pa__banner-title">已入驻</view>
    <view class="pa__banner-desc">你已是认证耍伴，通过基础考试后即可接单。</view>
  </view>

  <view class="pa__card">
    <view class="pa__card-title">日常位置 <text class="pa__required">*</text></view>
    <view class="pa__tip">注册时确定的常驻位置，用于向需求方展示你们之间的距离与到达耗时</view>
    <view class="pa__loc" bindtap="onChooseLocation">
      <block wx:if="{{homeLocation}}">
        <view class="pa__loc-main">
          <view class="pa__loc-name">📍 {{homeLocation.name}}</view>
          <view class="pa__loc-addr">{{homeLocation.address}}</view>
        </view>
        <text class="pa__loc-change">重选</text>
      </block>
      <view wx:else class="pa__loc-empty">📍 点击选择日常位置（小区 / 商圈 / 地标）</view>
    </view>
  </view>

  <view class="pa__card">
    <view class="pa__card-title">可接场景</view>
    <view class="pa__scenes">
      <view wx:for="{{scenes}}" wx:key="code"
            class="pa__scene {{item.selected ? 'is-on' : ''}}"
            data-index="{{index}}" bindtap="onToggleScene">
        <view class="pa__scene-emoji">{{item.emoji}}</view>
        <view class="pa__scene-name">{{item.name}}</view>
        <view class="pa__scene-check" wx:if="{{item.selected}}">✓</view>
      </view>
    </view>
  </view>

  <view class="pa__tips">
    <text>入驻即自动完成实名认证校验, 可立即接单. 更多资质认证后续开放.</text>
  </view>

  <button class="pa__submit" hover-class="btn-press" bindtap="onSubmit" loading="{{submitting}}" disabled="{{submitting}}">
    提交申请
  </button>
</view>
