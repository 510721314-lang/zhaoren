.rn { min-height: 100vh; background: var(--bg-page); padding-bottom: 60rpx; }
.rn__hero { padding: 56rpx 32rpx 24rpx; text-align: center; }
.rn__hero-ic { font-size: 88rpx; }
.rn__hero-title { margin-top: 12rpx; font-size: 40rpx; font-weight: 600; color: var(--text-1); }
.rn__hero-sub { margin-top: 8rpx; font-size: 26rpx; color: var(--text-3); }
.rn__card { margin: 24rpx 32rpx; background: var(--bg-card); border-radius: var(--r-md); padding: 28rpx 32rpx; }
.rn__card--ok { background: var(--brand-primary-light); }
.rn__ok { font-size: 30rpx; color: var(--func-success); font-weight: 600; text-align: center; padding: 12rpx 0; }
.rn__ok--inline { text-align: left; padding: 16rpx 0 4rpx; }
.rn__row { display: flex; justify-content: space-between; padding: 16rpx 0; font-size: 28rpx; }
.rn__label { color: var(--text-3); }
.rn__value { color: var(--text-1); }
.rn__value--warn { color: var(--func-warning); font-weight: 600; }
.rn__tip { margin: 8rpx 44rpx 0; font-size: 24rpx; color: var(--text-3); line-height: 1.7; }
.rn__btn { margin: 40rpx 32rpx 0; background: var(--brand-primary); color: var(--text-invert); font-size: 32rpx; border-radius: 44rpx; }
.rn__btn::after { border: none; }
.rn__btn--ghost { background: var(--brand-primary-light); color: var(--func-success); font-weight: 600; margin: 16rpx 0 0; }
.rn__btn--ghost::after { border: none; }

/* 步骤标题 */
.rn__step { font-size: 30rpx; font-weight: 600; color: var(--text-1); margin-bottom: 20rpx; }

/* 表单 */
.rn__field { display: flex; align-items: center; padding: 18rpx 0; border-bottom: 1rpx solid var(--border-2); }
.rn__field:last-of-type { border-bottom: none; }
.rn__field-label { width: 170rpx; font-size: 28rpx; color: var(--text-2); flex-shrink: 0; }
.rn__input { flex: 1; font-size: 30rpx; color: var(--text-1); }
.rn__ph { color: var(--text-disabled); }
.rn__note { margin-top: 14rpx; font-size: 24rpx; color: var(--text-3); line-height: 1.7; }

/* 协议 */
.rn__doc { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid var(--border-2); }
.rn__doc-name { font-size: 28rpx; color: var(--text-1); }
.rn__doc-op { font-size: 26rpx; color: var(--brand-primary); }
.rn__doc-body { max-height: 480rpx; background: var(--bg-input); border-radius: var(--r-sm); padding: 20rpx; margin: 12rpx 0; font-size: 26rpx; color: var(--text-2); line-height: 1.8; }
.rn__doc-body text { white-space: pre-wrap; }
.rn__agree { margin-top: 20rpx; }
.rn__agree-label { display: flex; align-items: flex-start; font-size: 26rpx; color: var(--text-2); line-height: 1.6; }
.rn__agree-label checkbox { transform: scale(0.8); margin-right: 8rpx; flex-shrink: 0; }

/* 签名 */
.rn__clear { margin-top: 16rpx; text-align: right; font-size: 26rpx; color: var(--text-3); text-decoration: underline; }