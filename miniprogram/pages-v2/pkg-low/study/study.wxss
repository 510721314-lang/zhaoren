.study {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 0 24rpx 48rpx;
}

/* 头部 */
.study__head { padding: 28rpx 8rpx 8rpx; }
.study__title { display: block; font-size: var(--font-xl); font-weight: 700; color: var(--text-1); }
.study__sub { margin-top: 8rpx; display: block; font-size: var(--font-xs); color: var(--text-4); }

/* 科目竖排列表(2026-10-28: 由横向 chips 改竖排; 点击才加载该科章节) */
.study__subjects { margin-top: 20rpx; }
.study__subject {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 28rpx 24rpx;
  background: var(--bg-card);
  border: 2rpx solid transparent;
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-card);
}
.study__subject.is-on {
  border-color: var(--brand-primary);
  background: var(--brand-primary-light);
}
.study__subject-main { display: flex; flex-direction: column; }
.study__subject-name { font-size: var(--font-lg); font-weight: 700; color: var(--text-1); }
.study__subject.is-on .study__subject-name { color: var(--brand-primary); }
.study__subject-desc { margin-top: 6rpx; font-size: var(--font-xs); color: var(--text-4); }
.study__subject-arrow { margin-left: 16rpx; font-size: var(--font-lg); color: var(--text-4); }

/* 状态提示 */
.study__tip { padding: 120rpx 0; text-align: center; font-size: var(--font-sm); color: var(--text-4); }

/* 模块分组 */
.study__group { margin-top: 20rpx; }
.study__group-title {
  padding: 8rpx 8rpx 12rpx;
  font-size: var(--font-xs);
  font-weight: 600;
  color: var(--text-4);
}
.study__chapter {
  margin-bottom: 12rpx;
  padding: 22rpx 24rpx;
  background: var(--bg-card);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-card);
}
.study__chapter.is-open { padding-bottom: 8rpx; }
.study__chapter-row { display: flex; align-items: center; }
.study__chapter-name {
  flex: 1;
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-1);
  line-height: 1.5;
}
.study__chapter-arrow { margin-left: 16rpx; font-size: var(--font-sm); color: var(--text-4); }

/* 正文展开区 */
.study__detail-tip { margin-top: 16rpx; font-size: var(--font-xs); color: var(--text-4); }
.study__blk {
  margin-top: 14rpx;
  font-size: var(--font-sm);
  color: var(--text-2);
  line-height: 1.75;
}
.study__blk.is-h {
  margin-top: 22rpx;
  font-size: var(--font-md);
  font-weight: 700;
  color: var(--text-1);
}
.study__blk.is-li { padding-left: 20rpx; position: relative; }
.study__blk.is-li::before { content: '·'; position: absolute; left: 4rpx; color: var(--text-4); }
