<view class="study">
  <view class="study__head">
    <text class="study__title">学习中心</text>
    <text class="study__sub">{{picked ? '再次点击已选科目可收起 · 切换其他科目查看对应课程' : '选择一个科目开始学习'}}</text>
  </view>

  <!-- 科目竖排列表: 页面加载零请求; 选中科目置顶展开, 其余紧凑上移(2026-10-28 二改) -->
  <view class="study__list">
    <block wx:for="{{subjects}}" wx:key="code" wx:for-item="s">
      <view
        class="study__subject {{picked && activeSubject === s.code ? 'is-open' : 'is-compact'}}"
        data-code="{{s.code}}"
        bindtap="onSubjectTap"
        hover-class="study__subject--hover"
      >
        <view class="study__subject-main">
          <text class="study__subject-name">{{s.name}}</text>
          <text class="study__subject-desc" wx:if="{{!picked || activeSubject === s.code}}">{{s.desc}}</text>
        </view>
        <text class="study__subject-arrow">{{picked && activeSubject === s.code ? '⌃' : '›'}}</text>
      </view>

      <!-- 选中科目的章节面板: 紧随科目卡下方 -->
      <view class="study__panel" wx:if="{{picked && activeSubject === s.code}}">
        <view wx:if="{{listLoading}}" class="study__tip">加载中…</view>
        <view wx:elif="{{listError}}" class="study__tip" bindtap="onRetry">加载失败，点击重试</view>
        <view wx:elif="{{!groups.length}}" class="study__tip">该科目暂无已发布章节</view>

        <view class="study__group" wx:for="{{groups}}" wx:key="key" wx:for-item="g">
          <view class="study__group-title">{{g.module_id}}</view>
          <view
            wx:for="{{g.chapters}}"
            wx:key="chapter_id"
            wx:for-item="item"
            class="study__chapter {{openKey === item.key ? 'is-open' : ''}}"
            data-subject="{{item.subject}}"
            data-module="{{item.module_id}}"
            data-chapter="{{item.chapter_id}}"
            data-key="{{item.key}}"
            bindtap="onChapterTap"
            hover-class="study__chapter--hover"
          >
            <view class="study__chapter-row">
              <text class="study__chapter-name">{{item.title}}</text>
              <text class="study__chapter-arrow">{{openKey === item.key ? '⌃' : '⌄'}}</text>
            </view>
            <block wx:if="{{openKey === item.key}}">
              <view wx:if="{{detailLoading}}" class="study__detail-tip">正文加载中…</view>
              <view class="study__body">
                <view
                  wx:for="{{blocks}}"
                  wx:key="index"
                  wx:for-item="b"
                  class="study__blk {{b.type === 'h' ? 'is-h' : ''}} {{b.type === 'li' ? 'is-li' : ''}}"
                >{{b.text}}</view>
              </view>
            </block>
          </view>
        </view>
      </view>
    </block>
  </view>
</view>
