<view class="study">
  <view class="study__head">
    <text class="study__title">学习中心</text>
    <text class="study__sub">已发布课程 · 点击章节展开阅读</text>
  </view>

  <!-- 科目筛选 -->
  <scroll-view wx:if="{{subjects.length}}" class="study__chips" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="study__chip {{activeSubject === '' ? 'is-on' : ''}}" data-code="" bindtap="onSubjectTap">全部</view>
    <view
      wx:for="{{subjects}}"
      wx:key="code"
      class="study__chip {{activeSubject === item.code ? 'is-on' : ''}}"
      data-code="{{item.code}}"
      bindtap="onSubjectTap"
    >{{item.name}}</view>
  </scroll-view>

  <view wx:if="{{loading}}" class="study__tip">加载中…</view>
  <view wx:elif="{{error}}" class="study__tip" bindtap="onRetry">加载失败，点击重试</view>
  <view wx:elif="{{!groups.length}}" class="study__tip">暂无已发布课程</view>

  <!-- 模块分组 + 章节 -->
  <view class="study__group" wx:for="{{groups}}" wx:key="key" wx:for-item="g">
    <view class="study__group-title">{{g.subjectName}} · {{g.module_id}}</view>
    <view
      wx:for="{{g.chapters}}"
      wx:key="chapter_id"
      wx:for-item="item"
      class="study__chapter {{openKey === item.key ? 'is-open' : ''}}"
      data-subject="{{item.subject}}"
      data-module="{{item.module_id}}"
      data-chapter="{{item.chapter_id}}"
      data-key="{{item.key}}"
      bindtap="onChapterTap"
    >
      <view class="study__chapter-row">
        <text class="study__chapter-name">{{item.title}}</text>
        <text class="study__chapter-arrow">{{openKey === item.key ? '⌃' : '⌄'}}</text>
      </view>
      <block wx:if="{{openKey === item.key}}">
        <view wx:if="{{detailLoading}}" class="study__detail-tip">正文加载中…</view>
        <view
          wx:for="{{blocks}}"
          wx:key="index"
          wx:for-item="b"
          class="study__blk {{b.type === 'h' ? 'is-h' : ''}} {{b.type === 'li' ? 'is-li' : ''}}"
        >{{b.text}}</view>
      </block>
    </view>
  </view>
</view>
