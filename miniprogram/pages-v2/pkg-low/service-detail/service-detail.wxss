page { background: var(--bg-page); }
.svc-detail { min-height: 100vh; padding-bottom: 160rpx; }

.sd__cover {
  width: 100%;
  height: 360rpx;
  background: var(--brand-primary-light);
}
.sd__cover--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 120rpx;
  color: var(--brand-primary);
}

.sd__body { padding: 28rpx 28rpx 40rpx; }
.sd__name {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--text-1);
}
.sd__scene {
  display: inline-block;
  margin-top: 12rpx;
  font-size: var(--font-xs);
  color: var(--brand-primary);
  background: var(--brand-primary-light);
  padding: 4rpx 18rpx;
  border-radius: 20rpx;
}
.sd__brief {
  margin-top: 18rpx;
  font-size: var(--font-base);
  color: var(--text-2);
  line-height: 1.6;
}
.sd__section-title {
  margin-top: 32rpx;
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-1);
}
.sd__content {
  margin-top: 14rpx;
  font-size: var(--font-base);
  color: var(--text-2);
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-word;
}
.sd__img {
  width: 100%;
  border-radius: 12rpx;
  margin: 16rpx 0;
}
.sd__video {
  width: 100%;
  border-radius: 12rpx;
  margin: 16rpx 0;
}

.sd__footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--bg-card);
  border-top: 1rpx solid var(--border-2);
}
.sd__btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--brand-primary);
  color: var(--text-invert);
  border-radius: 44rpx;
  font-size: var(--font-md);
  font-weight: 600;
}
.sd__btn.btn-press { background: var(--brand-primary-press); }

.sd__loading {
  text-align: center;
  padding: 120rpx 0;
  color: var(--text-4);
}
.sd__empty { padding-top: 120rpx; }
