.kefu { min-height: 100vh; background: var(--bg-page); display: flex; flex-direction: column; }

/* 加载 */
.kefu__loading { padding: 24rpx; }
.kefu__err { padding-top: 200rpx; text-align: center; }
.kefu__err-ic { font-size: 80rpx; }
.kefu__err-title { margin-top: 16rpx; font-size: var(--font-md); color: var(--text-3); }
.kefu__err-btn { margin-top: 32rpx; width: 320rpx; height: 80rpx; line-height: 80rpx; font-size: var(--font-md); color: var(--brand-primary); border: 2rpx solid var(--brand-primary); border-radius: var(--r-full); background: var(--bg-card); }
.kefu__err-btn::after { border: none; }

/* 消息区 */
.kefu__body { flex: 1; display: flex; flex-direction: column; min-height: 0; }
.kefu__msgs { flex: 1; padding: 20rpx 24rpx; box-sizing: border-box; }
.kefu__tip { text-align: center; font-size: var(--font-xs); color: var(--text-4); padding: 8rpx 0 20rpx; }
.kefu__msg { display: flex; flex-direction: column; margin-bottom: 24rpx; }
.kefu__msg.is-mine { align-items: flex-end; }
.kefu__bubble {
  max-width: 76%;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  font-size: var(--font-md);
  line-height: 1.5;
  color: var(--text-1);
  background: var(--bg-card);
  box-shadow: var(--shadow-card);
}
.kefu__msg.is-mine .kefu__bubble { background: var(--brand-primary); color: var(--text-invert); border-radius: 20rpx 4rpx 20rpx 20rpx; }
.kefu__msg:not(.is-mine) .kefu__bubble { border-radius: 4rpx 20rpx 20rpx 20rpx; }
.kefu__time { margin-top: 6rpx; font-size: var(--font-xxs); color: var(--text-4); }
.kefu__empty { text-align: center; padding-top: 120rpx; font-size: var(--font-sm); color: var(--text-disabled); }

/* 输入区 */
.kefu__input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--bg-card);
  border-top: 1rpx solid var(--border-2);
}
.kefu__input {
  flex: 1;
  height: 76rpx;
  background: var(--bg-input);
  border-radius: var(--r-md);
  padding: 0 24rpx;
  font-size: var(--font-md);
  color: var(--text-1);
}
.kefu__send {
  flex: none;
  width: 140rpx;
  height: 76rpx;
  line-height: 76rpx;
  margin: 0;
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-invert);
  background: var(--brand-primary);
  border-radius: var(--r-md);
}
.kefu__send::after { border: none; }
.kefu__send[disabled] { background: var(--btn-disabled-bg); color: var(--text-disabled); }
