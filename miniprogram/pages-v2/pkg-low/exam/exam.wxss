.exam {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 0 24rpx 48rpx;
}

/* 头部说明 */
.exam__head { padding: 24rpx 8rpx 16rpx; }
.exam__head-title { font-size: var(--font-xl); font-weight: 700; color: var(--text-1); display: block; }
.exam__head-sub { margin-top: 6rpx; font-size: var(--font-xs); color: var(--text-4); }

/* 题目卡 */
.exam__q { background: var(--bg-card); border-radius: var(--r-lg); padding: 24rpx; margin-top: 16rpx; box-shadow: var(--shadow-card); }
.exam__q-title { font-size: var(--font-md); font-weight: 600; color: var(--text-1); line-height: 1.5; }
.exam__opt {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  font-size: var(--font-md);
  color: var(--text-2);
  background: var(--bg-segment);
  border-radius: var(--r-md);
  border: 2rpx solid transparent;
}
.exam__opt.is-on { color: var(--brand-primary); border-color: var(--brand-primary); background: var(--brand-primary-light); font-weight: 600; }

/* 提交区 */
.exam__submit-wrap { margin-top: 32rpx; }
.exam__submit {
  height: 88rpx;
  line-height: 88rpx;
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-invert);
  background: var(--brand-primary);
  border-radius: var(--r-full);
}
.exam__submit::after { border: none; }
.exam__submit.is-disabled { opacity: 0.6; }
.exam__safe { margin-top: 16rpx; text-align: center; font-size: var(--font-xs); color: var(--text-disabled); }

/* 加载失败 */
.exam__err { padding-top: 120rpx; text-align: center; }
.exam__err-ic { font-size: 80rpx; }
.exam__err-title { margin-top: 16rpx; font-size: var(--font-md); color: var(--text-3); }
.exam__err-btn { margin-top: 32rpx; width: 320rpx; height: 80rpx; line-height: 80rpx; font-size: var(--font-md); color: var(--brand-primary); border: 2rpx solid var(--brand-primary); border-radius: var(--r-full); background: var(--bg-card); }
.exam__err-btn::after { border: none; }

/* 结果态 */
.exam__result { padding-top: 120rpx; text-align: center; }
.exam__result-ic { font-size: 100rpx; }
.exam__result-title { margin-top: 16rpx; font-size: var(--font-xl); font-weight: 700; color: var(--text-1); }
.exam__result-score { margin-top: 24rpx; display: flex; align-items: baseline; justify-content: center; }
.exam__result-num { font-size: 96rpx; font-weight: 700; color: var(--brand-primary); font-family: var(--font-metric); line-height: 1; }
.exam__result-unit { margin-left: 8rpx; font-size: var(--font-md); color: var(--text-3); }
.exam__result-sub { margin-top: 12rpx; font-size: var(--font-sm); color: var(--text-3); }
.exam__result-actions { margin-top: 48rpx; display: flex; flex-direction: column; gap: 16rpx; align-items: center; }
.exam__result-btn { width: 320rpx; height: 84rpx; line-height: 84rpx; font-size: var(--font-md); color: var(--text-2); border: 1rpx solid var(--border-divider); border-radius: var(--r-full); background: var(--bg-card); }
.exam__result-btn::after { border: none; }
.exam__result-btn.is-primary { color: var(--text-invert); background: var(--brand-primary); border-color: var(--brand-primary); font-weight: 600; }
