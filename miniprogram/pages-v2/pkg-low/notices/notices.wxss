.nt { padding: 20rpx 28rpx 40rpx; }
.nt__mark-all {
  text-align: right; font-size: 24rpx; color: var(--brand-primary, #07C160);
  padding: 8rpx 0 16rpx;
}
.nt__more {
  text-align: center; font-size: 24rpx; color: var(--text-3, #666666);
  padding: 20rpx 0 8rpx;
}
.nt__item {
  display: flex; gap: 20rpx;
  padding: 24rpx 20rpx;
  background: var(--bg-card); border-radius: var(--r-md);
  margin-bottom: 16rpx;
}
.nt__item--unread {
  background: rgba(24, 144, 255, 0.04);
}
.nt__ic { font-size: 40rpx; flex-shrink: 0; }
.nt__body { flex: 1; min-width: 0; }
.nt__head { display: flex; align-items: center; gap: 12rpx; }
.nt__title { font-size: 28rpx; font-weight: 600; flex: 1; }
.nt__summary { display: flex; flex-direction: column; gap: 4rpx; margin-bottom: 10rpx; padding: 12rpx 14rpx; background: var(--bg-segment, rgba(255,255,255,0.05)); border-radius: 10rpx; }
.nt__summary-l1 { font-size: 24rpx; font-weight: 600; color: var(--func-warning, #ff8f3c); }
.nt__summary-l2, .nt__summary-l3 { font-size: 20rpx; color: var(--text-3, #999); }
.nt__dot {
  width: 14rpx; height: 14rpx; border-radius: 50%;
  background: var(--func-danger, #fa5151);
  flex-shrink: 0;
}
.nt__sub { font-size: 24rpx; color: var(--text-2); margin-top: 8rpx; }
.nt__time { font-size: 22rpx; color: var(--text-4); margin-top: 8rpx; }
