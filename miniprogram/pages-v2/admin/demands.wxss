.admin-list { padding: var(--gap-md); background: var(--bg-page); min-height: 100vh; }
.list-item { background: var(--bg-card); border-radius: var(--r-sm); padding: var(--gap-md); margin-bottom: var(--sp-sm); box-shadow: var(--shadow-card); }
.item-header { display: flex; justify-content: space-between; align-items: center; }
.demand-no { font-size: var(--font-base); color: var(--text-3); }
.item-status { font-size: var(--font-sm); padding: 4rpx 12rpx; border-radius: var(--r-sm); }
.item-status.matching { background: var(--func-info-light); color: var(--func-info); }
.item-status.cancelled { background: var(--bg-segment); color: var(--text-3); }
.item-status.matched { background: var(--func-success-light); color: var(--func-success); }
.item-main { font-size: var(--font-lg); color: var(--text-1); margin-top: 12rpx; }
.item-sub { font-size: var(--font-base); color: var(--text-3); margin-top: var(--sp-xs); }
.actions { margin-top: var(--sp-sm); }
.btn-offline { background: var(--func-warning); color: var(--text-invert); font-size: var(--font-base); }
.tip, .loading { text-align: center; padding: var(--sp-xl); color: var(--text-3); font-size: var(--font-md); }
