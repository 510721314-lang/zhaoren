.admin-list { padding: var(--gap-md); background: var(--bg-page); min-height: 100vh; }
.filter-bar { display: flex; gap: 12rpx; margin-bottom: var(--sp-md); }
.filter-tab { flex: 1; text-align: center; padding: var(--sp-sm) 0; background: var(--bg-card); border-radius: 8rpx; font-size: var(--font-md); color: var(--text-2); }
.filter-tab.active { background: var(--brand-primary); color: var(--text-invert); }
.list-item { background: var(--bg-card); border-radius: var(--r-sm); padding: var(--gap-md); margin-bottom: var(--sp-sm); box-shadow: var(--shadow-card); }
.item-name { font-size: var(--font-xl); color: var(--text-1); font-weight: 500; }
.item-sub { font-size: var(--font-base); color: var(--text-3); margin-top: var(--sp-xs); }
.item-status { display: inline-block; font-size: var(--font-sm); padding: 4rpx 12rpx; border-radius: var(--r-sm); margin-top: 12rpx; }
.item-status.approved { background: var(--func-success-light); color: var(--func-success); }
.item-status.pending_review { background: var(--func-warning-light); color: var(--func-warning); }
.item-status.rejected { background: var(--func-danger-light); color: var(--func-danger); }
.actions { display: flex; gap: var(--sp-sm); margin-top: var(--sp-sm); }
.btn-approve { background: var(--brand-primary); color: var(--text-invert); font-size: var(--font-base); }
.btn-reject { background: var(--func-danger); color: var(--text-invert); font-size: var(--font-base); }
.tip, .loading { text-align: center; padding: var(--sp-xl); color: var(--text-3); font-size: var(--font-md); }
