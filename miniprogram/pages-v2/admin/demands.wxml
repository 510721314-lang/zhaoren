<view class="admin-list" wx:if="{{isAdmin}}">
  <view class="list">
    <view class="list-item" wx:for="{{list}}" wx:key="demand_id">
      <view class="item-header">
        <text class="demand-no">{{item.demand_no}}</text>
        <text class="item-status {{item.status}}">{{item.status}}</text>
      </view>
      <view class="item-main">{{item.remark || (item.content_options && item.content_options[0]) || '无备注'}}</view>
      <view class="item-sub">发布人: {{item.creator_name}} · 场景: {{item.scene}} · ¥{{item.total_fen / 100}}</view>
      <view class="actions" wx:if="{{item.status === 'matching'}}">
        <button class="btn-offline" size="mini" hover-class="btn-hover" bindtap="offline" data-id="{{item.demand_id}}">下架</button>
      </view>
    </view>
  </view>
  <view class="tip" wx:if="{{list.length === 0 && !loading}}">
    <view class="empty-icon">📋</view>
    <view>暂无需求</view>
  </view>
  <block wx:if="{{loading}}">
    <view class="list-item skeleton" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="skeleton sk-line-sm"></view>
      <view class="skeleton sk-line" style="margin-top:12rpx;"></view>
      <view class="skeleton sk-line-sm" style="margin-top:8rpx;"></view>
    </view>
  </block>
</view>
