.ud {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 24rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.ud-tip {
  padding: 120rpx 0;
  text-align: center;
  font-size: var(--font-md);
  color: var(--text-4);
}

/* ── 头部 ── */
.ud-head {
  display: flex;
  align-items: center;
  padding: 24rpx 0 28rpx;
}
.ud-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  background: var(--bg-card);
}
.ud-avatar--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-xl);
  color: var(--text-1);
  font-weight: 700;
}
.ud-head-main {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}
.ud-name {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--text-1);
}
.ud-sub {
  margin-top: 8rpx;
  font-size: var(--font-sm);
  color: var(--text-4);
}
.ud-badge {
  flex-shrink: 0;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-size: var(--font-xs);
  color: var(--text-2);
  background: var(--bg-segment);
}
.ud-badge.frozen { color: var(--func-warning); }
.ud-badge.banned { color: var(--func-danger); }
.ud-reason {
  margin-bottom: 24rpx;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  font-size: var(--font-sm);
  line-height: 1.6;
  color: var(--func-danger);
  background: var(--bg-segment);
}

/* ── 卡片 ── */
.ud-card {
  margin-bottom: 24rpx;
  padding: 24rpx;
  border-radius: var(--r-xl);
  background: var(--bg-card);
}
.ud-card-title {
  margin-bottom: 8rpx;
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--text-3);
  letter-spacing: 2rpx;
}
.ud-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--border-1);
}
.ud-row:last-child { border-bottom: none; }
.ud-row--col {
  flex-direction: column;
  align-items: flex-start;
}
.ud-k {
  font-size: var(--font-md);
  color: var(--text-3);
  flex-shrink: 0;
  margin-right: 24rpx;
}
.ud-v {
  font-size: var(--font-md);
  color: var(--text-1);
  text-align: right;
  word-break: break-all;
}
.ud-v--num {
  font-size: var(--font-lg);
  font-weight: 700;
}
.ud-v--mono {
  margin-top: 10rpx;
  font-size: var(--font-xs);
  color: var(--text-4);
  text-align: left;
  font-family: monospace;
}
.ud-empty {
  padding: 24rpx 0;
  text-align: center;
  font-size: var(--font-sm);
  color: var(--text-5);
}

/* ── 信用流水 ── */
.ud-log {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--border-1);
}
.ud-log:last-child { border-bottom: none; }
.ud-log-l {
  flex: 1;
  min-width: 0;
}
.ud-log-reason {
  font-size: var(--font-md);
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ud-log-time {
  margin-top: 6rpx;
  font-size: var(--font-xs);
  color: var(--text-5);
}
.ud-log-r {
  flex-shrink: 0;
  margin-left: 20rpx;
  text-align: right;
}
.ud-delta {
  font-size: var(--font-lg);
  font-weight: 700;
}
.ud-delta.is-up { color: var(--func-success); }
.ud-delta.is-down { color: var(--func-danger); }
.ud-log-score {
  display: block;
  margin-top: 4rpx;
  font-size: var(--font-xs);
  color: var(--text-4);
}
