.ev { min-height: 100vh; background: var(--bg-page); padding: 0 20rpx 160rpx; }
.ev__body { padding-top: 20rpx; }
.ev__card { background: var(--bg-card); border-radius: var(--r-lg); padding: 24rpx 28rpx; box-shadow: var(--shadow-card); margin-bottom: 20rpx; }
.ev__card-title { font-size: var(--font-md); font-weight: 600; color: var(--text-1); margin-bottom: 16rpx; }
.ev__required { color: var(--func-danger); }

.ev__summary { display: flex; justify-content: space-between; align-items: center; }
.ev__summary-avatar { font-size: var(--font-display-xxl); }
.ev__summary-title { font-size: var(--font-lg); font-weight: 600; color: var(--text-1); }
.ev__summary-meta { margin-top: 8rpx; font-size: var(--font-sm); color: var(--text-3); }

.ev__stars { display: flex; justify-content: center; padding: 16rpx 0; }
.ev__star { font-size: var(--font-display-xxl); color: var(--bg-segment); margin: 0 8rpx; }
.ev__star.is-on { color: var(--func-warning); }
.ev__stars-tip { text-align: center; font-size: var(--font-sm); color: var(--text-3); }

.ev__tag-group-title { margin: 16rpx 0 8rpx; font-size: var(--font-xs); color: var(--text-4); }
.ev__tags { display: flex; flex-wrap: wrap; gap: 12rpx; }
.ev__tag { padding: 12rpx 24rpx; border-radius: 32rpx; background: var(--bg-segment); font-size: var(--font-sm); color: var(--text-2); }
.ev__tag.is-on { background: var(--brand-primary); color: var(--text-invert); }

.ev__textarea { width: 100%; min-height: 160rpx; background: var(--bg-segment); border-radius: var(--r-md); padding: 16rpx; font-size: var(--font-sm); box-sizing: border-box; }
.ev__count { text-align: right; font-size: var(--font-xs); color: var(--text-5); margin-top: 8rpx; }

.ev__anon-tip { padding: 16rpx 0; text-align: center; font-size: var(--font-xs); color: var(--text-4); }
.ev__countdown { padding: 16rpx 0; text-align: center; font-size: var(--font-sm); color: var(--func-warning); }

.ev__bottom { position: fixed; left: 0; right: 0; bottom: 0; padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom)); background: var(--bg-card); border-top: 1rpx solid var(--border-2); z-index: 100; }
.ev__btn { width: 100%; height: 88rpx; line-height: 88rpx; border-radius: 44rpx; background: var(--brand-primary); color: var(--text-invert); font-size: var(--font-lg); font-weight: 600; }
.ev__btn::after { border: none; }

/* 三态骨架屏 */
.ev__loading { padding: 16rpx; }
.ev__skeleton { height: 120rpx; background: var(--bg-segment); border-radius: var(--r-md); margin-bottom: 16rpx; animation: ev-skeleton-pulse 1.2s ease-in-out infinite; }
@keyframes ev-skeleton-pulse { 0%,100% { opacity: 0.5; } 50% { opacity: 1; } }
