<view class="v2 pd">
  <nav-bar title="耍伴详情"></nav-bar>

  <!-- 加载态 -->
  <view class="pd__loading" wx:if="{{loading}}">
    <view class="pd__skeleton" wx:for="{{[1,2,3]}}" wx:key="*this"></view>
  </view>
  <!-- 网络异常态 -->
  <empty-state wx:elif="{{loadError}}" icon="📡" title="网络异常" desc="请检查网络后重试" btnText="重试" bind:btntap="reload" />
  <!-- 正常态 -->
  <block wx:elif="{{partner}}">
  <!-- T1 头部大卡 -->
  <view class="pd__header">
    <view class="pd__avatar">
      <image wx:if="{{partner.avatar}}" src="{{partner.avatar}}" mode="aspectFill" class="pd__avatar-img" />
      <text wx:else class="pd__avatar-emoji">👤</text>
    </view>
    <view class="pd__head-info">
      <view class="pd__name-line">
        <text class="pd__name">{{partner.nickname}}</text>
        <text class="pd__cert" wx:if="{{partner.real_name_verified}}">实名✓</text>
        <text class="pd__cert" wx:if="{{partner.face_verified}}">人脸✓</text>
      </view>
      <view class="pd__score-line">
        <text>信用分 <text class="pd__score-num">{{partner.score || 0}}</text></text>
        <text class="pd__level"> · {{partner.level || 'L1'}}</text>
      </view>
    </view>
  </view>

  <!-- T2 场景标签 + 统计 -->
  <view class="pd__card">
    <view class="pd__scenes" wx:if="{{sceneList.length > 0}}">
      <tag-chip type="scene" scene-code="{{item.code}}" wx:for="{{sceneList}}" wx:key="code" />
    </view>
    <view class="pd__stats">
      <view class="pd__stat"><text class="pd__stat-num">🧾 {{stats.total_orders || 0}}</text><text class="pd__stat-label">累计订单</text></view>
      <view class="pd__stat"><text class="pd__stat-num">✅ {{stats.completed_orders || 0}}</text><text class="pd__stat-label">已完成</text></view>
      <view class="pd__stat"><text class="pd__stat-num">📍 {{partner.city || '未设置'}}</text><text class="pd__stat-label">服务城市</text></view>
    </view>
  </view>

  <!-- T2.5 日常位置 + 距浏览者距离/多方式耗时 -->
  <view class="pd__card" wx:if="{{partner.home_location}}">
    <view class="pd__loc-title">📍 TA的日常位置</view>
    <view class="pd__loc-name">{{partner.home_location.name || '已设置日常位置'}}</view>
    <view class="pd__loc-addr" wx:if="{{partner.home_location.address}}">{{partner.home_location.address}}</view>

    <view wx:if="{{route}}">
      <view class="pd__route-dist">距你 <text class="pd__route-dist-num">{{route.distanceText}}</text></view>
      <view class="pd__route-modes">
        <view class="pd__mode" wx:for="{{route.modes}}" wx:key="key">
          <view class="pd__mode-icon">{{item.icon}}</view>
          <view class="pd__mode-text">{{item.text}}<text class="pd__mode-est" wx:if="{{item.est}}">≈</text></view>
          <view class="pd__mode-label">{{item.label}}</view>
        </view>
      </view>
      <view class="pd__route-note">到达耗时为路线规划估算，实际以实时路况为准</view>
    </view>
    <view class="pd__route-hint" wx:elif="{{routeLoading}}">正在计算距你的距离与到达耗时…</view>
    <view class="pd__route-hint" wx:elif="{{locDenied}}">开启定位授权后，可查看距你的距离与到达耗时</view>
  </view>

  <!-- T3 个人简介(审核通过快照; 无内容不渲染) -->
  <view class="pd__card" wx:if="{{partner.bio}}">
    <view class="pd__profile-title">个人简介</view>
    <view class="pd__intro">{{partner.bio}}</view>
  </view>

  <!-- T3a 技能标签 -->
  <view class="pd__card" wx:if="{{partner.skills && partner.skills.length > 0}}">
    <view class="pd__profile-title">技能标签</view>
    <view class="pd__skills">
      <text class="pd__skill" wx:for="{{partner.skills}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <!-- T3b 服务亮点 -->
  <view class="pd__card" wx:if="{{partner.service_highlights && partner.service_highlights.length > 0}}">
    <view class="pd__profile-title">服务亮点</view>
    <view class="pd__hl" wx:for="{{partner.service_highlights}}" wx:key="*this">✦ {{item}}</view>
  </view>

  <!-- T3b1 资质证书 (栏目级多图 + 标题; 审核快照, 空不渲染) -->
  <view class="pd__card" wx:if="{{partner.qualifications && (partner.qualifications.photos.length > 0 || partner.qualifications.titles.length > 0)}}">
    <view class="pd__profile-title">资质证书</view>
    <view class="pd__media" wx:if="{{partner.qualifications.photos.length > 0}}">
      <image class="pd__media-img" wx:for="{{partner.qualifications.photos}}" wx:key="*this" src="{{item}}" mode="aspectFill" lazy-load data-index="{{index}}" data-list="{{partner.qualifications.photos}}" bindtap="previewMedia" />
    </view>
    <view class="pd__hl" wx:if="{{partner.qualifications.titles.length > 0}}">
      <view class="pd__media-item" wx:for="{{partner.qualifications.titles}}" wx:key="*this">✦ {{item}}</view>
    </view>
  </view>

  <!-- T3b2 荣誉 其他 (栏目级多图 + 标题; 审核快照, 空不渲染) -->
  <view class="pd__card" wx:if="{{partner.honors && (partner.honors.photos.length > 0 || partner.honors.titles.length > 0)}}">
    <view class="pd__profile-title">荣誉 其他</view>
    <view class="pd__media" wx:if="{{partner.honors.photos.length > 0}}">
      <image class="pd__media-img" wx:for="{{partner.honors.photos}}" wx:key="*this" src="{{item}}" mode="aspectFill" lazy-load data-index="{{index}}" data-list="{{partner.honors.photos}}" bindtap="previewMedia" />
    </view>
    <view class="pd__hl" wx:if="{{partner.honors.titles.length > 0}}">
      <view class="pd__media-item" wx:for="{{partner.honors.titles}}" wx:key="*this">✦ {{item}}</view>
    </view>
  </view>

  <!-- T3.5 动态入口: 条数 + 最新更新时间, 点击进 TA 的动态流 -->
  <view class="pd__card pd__blog-entry" wx:if="{{blogInfo}}" bindtap="goBlog" hover-class="pd__blog-entry--hover">
    <view class="pd__blog-left">
      <text class="pd__blog-icon">📝</text>
      <view class="pd__blog-text">
        <view class="pd__blog-title">动态 <text class="pd__blog-count">{{blogInfo.count}} 条</text></view>
        <view class="pd__blog-sub" wx:if="{{blogTimeText}}">最新更新于 {{blogTimeText}}</view>
      </view>
    </view>
    <text class="pd__blog-arrow">›</text>
  </view>

  <!-- T4 tab -->
  <view class="pd__tabs">
    <view class="pd__tab {{activeTab === 'eval' ? 'is-on' : ''}}" data-tab="eval" bindtap="switchTab">评价({{evaluations.length}})</view>
    <view class="pd__tab {{activeTab === 'cert' ? 'is-on' : ''}}" data-tab="cert" bindtap="switchTab">认证</view>
  </view>

  <view class="pd__card pd__tab-content">
    <block wx:if="{{activeTab === 'eval'}}">
      <block wx:if="{{evaluations.length > 0}}">
        <view class="pd__eval-item" wx:for="{{evaluations}}" wx:key="at">
          <view class="pd__eval-stars">{{item.stars}}⭐</view>
          <view class="pd__eval-tags" wx:if="{{item.tags.length > 0}}">
            <text class="pd__eval-tag" wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag">{{tag}}</text>
          </view>
          <view class="pd__eval-content">{{item.content}}</view>
          <view class="pd__eval-time">{{item.at}}</view>
        </view>
      </block>
      <view wx:else class="pd__empty">暂无评价~</view>
    </block>
    <block wx:if="{{activeTab === 'cert'}}">
      <view class="pd__cert-row"><text class="pd__cert-name">实名认证</text><text class="pd__cert-status {{partner.real_name_verified ? 'ok' : 'pending'}}">{{partner.real_name_verified ? '已通过' : '未认证'}}</text></view>
      <view class="pd__cert-row"><text class="pd__cert-name">人脸核验</text><text class="pd__cert-status {{partner.face_verified ? 'ok' : 'pending'}}">{{partner.face_verified ? '已通过' : '未认证'}}</text></view>
      <view class="pd__cert-row" wx:if="{{sceneList.length > 0}}">
        <text class="pd__cert-name">场景认证</text>
        <text class="pd__cert-status ok">{{sceneList.length}}项通过</text>
      </view>
    </block>
  </view>

  <!-- T5 底部栏 -->
  <view class="pd__bottom">
    <button class="pd__btn pd__btn--ghost" bindtap="onReport" hover-class="btn-press">🛟 举报</button>
    <button class="pd__btn pd__btn--ghost" bindtap="onConsult" hover-class="btn-press">💬 咨询</button>
    <button class="pd__btn pd__btn--primary" bindtap="onInvite" hover-class="btn-press">邀TA帮忙</button>
  </view>
  </block>
  <!-- 空态 -->
  <empty-state wx:else icon="📭" title="数据不存在" desc="该记录可能已被删除" />
  <night-mask visible="{{isRedline}}" bind:reserve="onReserve"></night-mask>
</view>
