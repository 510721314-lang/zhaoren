<view class="v2 pd">
  <nav-bar title="耍伴详情"></nav-bar>

  <!-- 加载态 -->
  <view class="pd__loading" wx:if="{{loading}}">
    <view class="pd__skeleton" wx:for="{{[1,2,3]}}" wx:key="*this"></view>
  </view>
  <!-- 网络异常态 -->
  <empty-state wx:elif="{{loadError}}" icon="📡" title="网络异常" desc="请检查网络后重试" btnText="重试" bind:btntap="reload" />
  <!-- 正常态 -->
  <block wx:elif="{{partner}}">
  <!-- T1 头部大卡 -->
  <view class="pd__header">
    <view class="pd__avatar">{{partner.avatar}}</view>
    <view class="pd__head-info">
      <view class="pd__name-line">
        <text class="pd__name">{{partner.nickname}}</text>
        <text class="pd__cert" wx:if="{{partner.real_name_verified}}">实名✓</text>
        <text class="pd__cert" wx:if="{{partner.face_verified}}">人脸✓</text>
        <text class="pd__cert" wx:for="{{partner.certs}}" wx:key="*this">{{item}}✓</text>
      </view>
      <view class="pd__score-line">
        <text>信用分 <text class="pd__score-num">{{partner.partner_credit_score}}</text></text>
        <text class="pd__level"> · {{partner.partner_level}}优质</text>
        <text class="pd__medal" wx:for="{{partner.medals}}" wx:key="*this">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- T2 一级信息 -->
  <view class="pd__card">
    <view class="pd__scenes">
      <tag-chip type="scene" scene-code="{{item.code}}" wx:for="{{sceneList}}" wx:key="code" />
    </view>
    <block wx:if="{{showStats}}">
      <view class="pd__stats">
        <view class="pd__stat"><text class="pd__stat-num">⏱ {{partner.on_time_rate}}%</text><text class="pd__stat-label">准时率</text></view>
        <view class="pd__stat"><text class="pd__stat-num">❤ {{partner.praise_rate}}%</text><text class="pd__stat-label">好评率</text></view>
        <view class="pd__stat"><text class="pd__stat-num">🧾 {{partner.order_count}}</text><text class="pd__stat-label">累计订单</text></view>
      </view>
    </block>
    <block wx:else>
      <view class="pd__stats-dim">数据积累中（完成3单后展示完整数据）</view>
    </block>
  </view>

  <!-- T3 二级信息（折叠） -->
  <view class="pd__card">
    <view class="pd__fold-header" bindtap="toggleExpand">
      <text class="pd__fold-title">详细信息</text>
      <text class="pd__fold-arrow {{expanded ? 'is-open' : ''}}">▾</text>
    </view>
    <block wx:if="{{expanded}}">
      <view class="pd__detail-row"><text class="pd__detail-label">单价区间</text><text class="pd__detail-val">¥{{partner.price_min}}-{{partner.price_max}}/小时</text></view>
      <view class="pd__detail-row"><text class="pd__detail-label">距你</text><text class="pd__detail-val">{{partner.distance_km}}km</text></view>
      <view class="pd__dyn" wx:if="{{partner.latest_dynamic}}">
        <text class="pd__dyn-tag">📢 最新动态</text>
        <text class="pd__dyn-text">{{partner.latest_dynamic.title}}</text>
        <text class="pd__dyn-time">{{partner.latest_dynamic.at}}</text>
      </view>
    </block>
  </view>

  <!-- T4 三级 tab -->
  <view class="pd__tabs">
    <view class="pd__tab {{activeTab === 'intro' ? 'is-on' : ''}}" data-tab="intro" bindtap="switchTab">服务介绍</view>
    <view class="pd__tab {{activeTab === 'eval' ? 'is-on' : ''}}" data-tab="eval" bindtap="switchTab">评价</view>
    <view class="pd__tab {{activeTab === 'dynamic' ? 'is-on' : ''}}" data-tab="dynamic" bindtap="switchTab">动态</view>
    <view class="pd__tab {{activeTab === 'cert' ? 'is-on' : ''}}" data-tab="cert" bindtap="switchTab">资质</view>
  </view>

  <view class="pd__card pd__tab-content">
    <block wx:if="{{activeTab === 'intro'}}">
      <view class="pd__intro">{{partner.nickname}}是一位经过平台实名+人脸双重认证的认证耍伴，擅长{{sceneList[0].name}}等场景，服务热情专业，欢迎咨询。</view>
    </block>
    <block wx:if="{{activeTab === 'eval'}}">
      <view class="pd__eval-item" wx:for="{{evaluations}}" wx:key="*this">
        <view class="pd__eval-stars">{{item.stars}}⭐</view>
        <view class="pd__eval-tags">
          <text class="pd__eval-tag" wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag">{{tag}}</text>
        </view>
        <view class="pd__eval-content">{{item.content}}</view>
        <view class="pd__eval-time">{{item.at}}</view>
      </view>
    </block>
    <block wx:if="{{activeTab === 'dynamic'}}">
      <view class="pd__dyn-full" wx:if="{{partner.latest_dynamic}}">
        <view class="pd__dyn-cover">{{partner.latest_dynamic.cover || '🏥'}}</view>
        <view class="pd__dyn-title">{{partner.latest_dynamic.title}}</view>
        <view class="pd__dyn-time">{{partner.latest_dynamic.at}}</view>
      </view>
    </block>
    <block wx:if="{{activeTab === 'cert'}}">
      <view class="pd__cert-row" wx:for="{{certs}}" wx:key="name">
        <text class="pd__cert-name">{{item.name}}</text>
        <text class="pd__cert-status">{{item.status}}</text>
      </view>
    </block>
  </view>

  <!-- T5 底部栏 -->
  <view class="pd__bottom">
    <button class="pd__btn pd__btn--ghost" bindtap="onConsult">💬 咨询</button>
    <button class="pd__btn pd__btn--primary" bindtap="onInvite">邀TA帮忙</button>
  </view>
  </block>
  <!-- 空态 -->
  <empty-state wx:else icon="📭" title="数据不存在" desc="该记录可能已被删除" />
  <night-mask visible="{{isRedline}}"></night-mask>
</view>
