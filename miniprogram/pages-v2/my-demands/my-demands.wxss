.md {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 0 20rpx 160rpx;
}

.md__loading {
  margin-top: 20rpx;
}
.md__skeleton {
  height: 200rpx;
  border-radius: var(--r-lg);
  background: var(--bg-card);
  margin-bottom: 20rpx;
  opacity: 0.6;
}

.md__card {
  margin-top: 20rpx;
  background: var(--bg-card);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-card);
  padding: 24rpx 28rpx;
}
.md__card--hover {
  background: var(--bg-segment);
}
.md__card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.md__scene {
  font-size: var(--font-md);
  font-weight: 700;
  color: var(--text-1);
}
.md__status {
  font-size: var(--font-xs);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}
.md__card-body {
  margin-top: 16rpx;
}
.md__row {
  font-size: var(--font-sm);
  color: var(--text-3);
  line-height: 1.9;
}
.md__card-foot {
  margin-top: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-divider);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.md__tip {
  font-size: var(--font-xs);
  color: var(--text-4);
  flex: 1;
  margin-right: 16rpx;
}
.md__price {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--func-danger);
}
