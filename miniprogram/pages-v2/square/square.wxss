.square {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 160rpx;
}

/* 活动 banner 轮播 */
.sq-banner-wrap {
  margin: 16rpx 20rpx 0;
  border-radius: 20rpx;
  overflow: hidden;
}
.sq-banner {
  width: 100%;
  height: 300rpx;
  border-radius: 20rpx;
}
.sq-banner__img {
  width: 100%;
  height: 100%;
  display: block;
}
.sq-banner__text {
  position: absolute;
  left: 28rpx;
  bottom: 24rpx;
  right: 28rpx;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.4);
  pointer-events: none;
}
.sq-banner__title {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.3;
}
.sq-banner__sub {
  font-size: 24rpx;
  opacity: 0.92;
  margin-top: 6rpx;
}

/* 活动卡片区 */
.sq-cards {
  white-space: nowrap;
  padding: 16rpx 20rpx 4rpx;
}
.sq-card {
  display: inline-block;
  width: 280rpx;
  margin-right: 16rpx;
  background: var(--bg-card);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: var(--shadow-card);
  vertical-align: top;
}
.sq-card__cover {
  width: 100%;
  height: 150rpx;
  display: block;
  background: #e8e8e8;
}
.sq-card__body {
  padding: 12rpx 16rpx 16rpx;
  white-space: normal;
}
.sq-card__title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
}
.sq-card__sub {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

/* S0 发布需求引导卡 */
.sq-hero {
  margin: 20rpx 20rpx 4rpx;
  background: var(--bg-card);
  border-radius: 28rpx;
  padding: 44rpx 40rpx 36rpx;
  box-shadow: var(--shadow-float);
  text-align: center;
}
.sq-hero__title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-1);
}
.sq-hero__sub {
  margin-top: 20rpx;
  font-size: var(--font-md);
  color: var(--text-4);
  line-height: 1.7;
}
.sq-hero__btn {
  margin: 36rpx auto 0;
  width: 480rpx;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 20rpx;
  background: var(--brand-primary);
  color: var(--text-invert);
  font-size: 36rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 28rpx rgba(7, 193, 96, 0.28);
}
.sq-hero__btn::after {
  border: none;
}
.sq-hero__switch {
  margin-top: 28rpx;
  font-size: var(--font-md);
  color: var(--brand-primary);
}

/* S1 chips */
.square__chips {
  background: var(--bg-card);
  padding: 16rpx 20rpx;
  white-space: nowrap;
}
.square__chip {
  display: inline-block;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 28rpx;
  margin-right: 16rpx;
  border-radius: 30rpx;
  background: var(--bg-segment);
  color: var(--text-3);
  font-size: var(--font-sm);
}
.square__chip.is-on {
  background: var(--brand-primary);
  color: var(--text-invert);
  font-weight: 600;
}

/* S2 */
.square__sortbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx 8rpx;
}
.square__sorts {
  display: flex;
}
.square__sort {
  font-size: var(--font-sm);
  color: var(--text-4);
  margin-right: 28rpx;
}
.square__sort.is-on {
  color: var(--brand-primary);
  font-weight: 600;
}
.square__count {
  font-size: var(--font-xs);
  color: var(--text-5);
}

/* S3 */
.square__list {
  padding: 12rpx 20rpx 0;
}

/* S4 */
.square__footnote {
  text-align: center;
  font-size: var(--font-xs);
  color: var(--text-disabled);
  padding: 8rpx 0 16rpx;
}

/* 抢单弹窗 */
.grab__title {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--text-1);
  text-align: center;
}
.grab__desc {
  margin-top: 24rpx;
  font-size: var(--font-md);
  color: var(--text-1);
  text-align: center;
}
.grab__meta {
  margin-top: 10rpx;
  font-size: var(--font-sm);
  color: var(--text-4);
}
.grab__tip {
  margin-top: 24rpx;
  background: var(--func-warning-light);
  color: var(--text-aa);
  font-size: var(--font-sm);
  line-height: 1.7;
  border-radius: var(--r-sm);
  padding: 20rpx 24rpx;
}
.grab__btns {
  display: flex;
  gap: 20rpx;
}
.grab__btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: var(--font-md);
  margin: 0;
}
.grab__btn::after {
  border: none;
}
.grab__btn--ghost {
  background: var(--bg-card);
  color: var(--text-3);
  border: 1rpx solid var(--border-ghost);
}
.grab__btn--primary {
  background: var(--brand-primary);
  color: var(--text-invert);
  font-weight: 600;
}
