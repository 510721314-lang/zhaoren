<view class="v2 square">
  <nav-bar title="需求广场" show-back="{{false}}"></nav-bar>

  <!-- 活动 banner 轮播 (后台配置, 0-3 张) -->
  <view wx:if="{{banners.length}}" class="sq-banner-wrap">
    <swiper class="sq-banner" indicator-dots autoplay circular interval="4000" indicator-color="rgba(255,255,255,0.5)" indicator-active-color="#fff">
      <swiper-item wx:for="{{banners}}" wx:key="id" data-idx="{{index}}" bindtap="onActivityTap">
        <image class="sq-banner__img" src="{{item.banner_image}}" mode="aspectFill" lazy-load="{{true}}"></image>
        <view class="sq-banner__text">
          <view class="sq-banner__title">{{item.title}}</view>
          <view wx:if="{{item.subtitle}}" class="sq-banner__sub">{{item.subtitle}}</view>
        </view>
      </swiper-item>
    </swiper>
  </view>

  <!-- 活动卡片区 (后台配置, 0-4 张, 横向滚动) -->
  <scroll-view wx:if="{{cards.length}}" class="sq-cards" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="sq-card" wx:for="{{cards}}" wx:key="id" data-idx="{{index}}" bindtap="onActivityTap">
      <image wx:if="{{item.cover_image}}" class="sq-card__cover" src="{{item.cover_image}}" mode="aspectFill" lazy-load="{{true}}"></image>
      <view class="sq-card__body">
        <view class="sq-card__title">{{item.title}}</view>
        <view wx:if="{{item.subtitle}}" class="sq-card__sub">{{item.subtitle}}</view>
      </view>
    </view>
  </scroll-view>

  <!-- S0 发布需求引导卡 -->
  <view class="sq-hero">
    <view class="sq-hero__title">👏 需要人帮忙？发个需求</view>
    <view class="sq-hero__sub">描述时间地点与预算，系统为你匹配附近合适耍伴，也可广播到接单大厅</view>
    <button class="sq-hero__btn" bindtap="onHeroPublish" hover-class="btn-press">＋ 发布需求</button>
    <view class="sq-hero__switch" bindtap="onSwitchPartner">想接单赚钱？去「我的」切换为耍伴身份 ›</view>
  </view>

  <!-- S1 筛选 chips：全部 + 5场景 + 公益免费（无W3/W7/W9） -->
  <scroll-view class="square__chips" scroll-x enhanced show-scrollbar="{{false}}">
    <view
      class="square__chip {{activeChip === item.code ? 'is-on' : ''}}"
      wx:for="{{chips}}"
      wx:key="code"
      data-code="{{item.code}}"
      bindtap="onChipTap"
    >{{item.name}}</view>
  </scroll-view>

  <!-- S2 排序 + 统计 -->
  <view class="square__sortbar">
    <view class="square__sorts">
      <text
        class="square__sort {{activeSort === index ? 'is-on' : ''}}"
        wx:for="{{sorts}}"
        wx:key="*this"
        data-index="{{index}}"
        bindtap="onSortTap"
      >{{item}}</text>
    </view>
    <text class="square__count">今日需求 {{todayCount}} · 耍伴在线 {{onlinePartners}}</text>
  </view>

  <!-- S3 需求列表（role=partner，R9双态按钮） -->
  <view class="square__list" wx:if="{{!loading}}">
    <view class="fade-in-up" style="animation-delay:{{index * 0.04}}s;" wx:for="{{list}}" wx:key="_id">
      <demand-card
        demand="{{item}}"
        role="partner"
        certified="{{true}}"
        bind:action="onGrab"
        bind:cardtap="onCardTap"
      ></demand-card>
    </view>
    <empty-state wx:if="{{list.length === 0}}" icon="🧭" title="当前筛选下暂无需求" desc="{{matchExpandMin}}分钟内无匹配时将为你智能扩圈，预约下单还可享{{reserveDiscountText}}"></empty-state>
  </view>

  <!-- 骨架屏 -->
  <view class="square__sk" wx:if="{{loading}}">
    <view class="skeleton sk-card" style="height:180rpx;margin-bottom:20rpx;"></view>
    <view class="skeleton sk-card" style="height:180rpx;margin-bottom:20rpx;"></view>
    <view class="skeleton sk-card" style="height:180rpx;margin-bottom:20rpx;"></view>
  </view>

  <!-- S4 脚注 -->
  <view class="square__footnote" wx:if="{{list.length > 0}}">广场广播模式 · 先到先得，抢到即进入四确认流程</view>

  <night-mask visible="{{isRedline}}" bind:reserve="onReserve"></night-mask>
</view>
