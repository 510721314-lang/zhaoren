@import "../../styles/tokens.wxss";

.ppe { padding: 24rpx; }
.ppe__banner { padding: 20rpx 24rpx; border-radius: 16rpx; font-size: 26rpx; margin-bottom: 24rpx; }
.ppe__banner--pending { background: #FFF7E6; color: #AD6800; }
.ppe__banner--rejected { background: #FFF1F0; color: #CF1322; }
.ppe__card { background: #FFFFFF; border-radius: 16rpx; padding: 28rpx; margin-bottom: 24rpx; }
.ppe__label { font-size: 30rpx; font-weight: 600; color: #1F2329; display: flex; justify-content: space-between; }
.ppe__count { font-size: 24rpx; font-weight: 400; color: #9AA0A6; }
.ppe__hint { font-size: 24rpx; color: #9AA0A6; margin-top: 8rpx; }
.ppe__textarea { width: 100%; height: 200rpx; margin-top: 20rpx; font-size: 28rpx; background: #F7F8FA; border-radius: 12rpx; padding: 20rpx; box-sizing: border-box; }
.ppe__tags { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 20rpx; }
.ppe__tag { background: #E8F5E9; color: #07C160; font-size: 26rpx; padding: 8rpx 20rpx; border-radius: 24rpx; display: flex; align-items: center; }
.ppe__tag-x { margin-left: 12rpx; color: #9AA0A6; font-size: 30rpx; }
.ppe__hl { display: flex; justify-content: space-between; align-items: center; background: #F7F8FA; border-radius: 12rpx; padding: 20rpx; margin-top: 16rpx; font-size: 28rpx; }
.ppe__addrow { display: flex; gap: 16rpx; margin-top: 20rpx; }
.ppe__input { flex: 1; background: #F7F8FA; border-radius: 12rpx; padding: 0 20rpx; height: 72rpx; font-size: 28rpx; }
.ppe__addbtn { width: 140rpx; height: 72rpx; line-height: 72rpx; font-size: 26rpx; background: #07C160; color: #FFFFFF; border-radius: 12rpx; padding: 0; display: flex; align-items: center; justify-content: center; }
.ppe__submit { margin-top: 16rpx; background: #07C160; color: #FFFFFF; font-size: 32rpx; border-radius: 44rpx; height: 88rpx; line-height: 88rpx; }
.ppe__submit.is-disabled { background: #C8C9CC; }
.ppe__safe { margin-top: 24rpx; font-size: 24rpx; color: #9AA0A6; text-align: center; }
