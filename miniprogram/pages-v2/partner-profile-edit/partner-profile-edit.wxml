<view class="ppe">
  <!-- 审核状态提示 -->
  <view class="ppe__banner ppe__banner--pending" wx:if="{{auditStatus === 'pending'}}">
    资料审核中，通过后将自动展示。审核期间不可重复提交。
  </view>
  <view class="ppe__banner ppe__banner--rejected" wx:if="{{auditStatus === 'rejected'}}">
    上次提交未通过{{rejectReason ? '：' + rejectReason : ''}}，请修改后重新提交。
  </view>

  <!-- 个人简介 -->
  <view class="ppe__card">
    <view class="ppe__label">个人简介 <text class="ppe__count">{{bio.length}}/200</text></view>
    <textarea class="ppe__textarea" value="{{bio}}" maxlength="200" placeholder="介绍你的特长与服务经验，例如：三甲医院在职护士，周末可陪诊" placeholder-class="ppe__ph" bindinput="onBioInput" />
  </view>

  <!-- 技能标签 -->
  <view class="ppe__card">
    <view class="ppe__label">技能标签 <text class="ppe__count">{{skills.length}}/10</text></view>
    <view class="ppe__hint">每个标签不超过 12 字，审核通过后展示在耍伴卡片与详情页</view>
    <view class="ppe__tags">
      <view class="ppe__tag" wx:for="{{skills}}" wx:key="index">
        {{item}}<text class="ppe__tag-x" data-index="{{index}}" bindtap="onRemoveSkill">×</text>
      </view>
    </view>
    <view class="ppe__addrow" wx:if="{{skills.length < 10}}">
      <input class="ppe__input" value="{{skillInput}}" maxlength="12" placeholder="如：持证护士" placeholder-class="ppe__ph" bindinput="onSkillInput" />
      <!-- 用 view 代替 button: 避免 button 内置样式/键盘失焦吞点击 -->
      <view class="ppe__addbtn" hover-class="btn-press" bindtap="onAddSkill">添加</view>
    </view>
    <view class="ppe__fieldsubmit {{submitting || auditStatus === 'pending' ? 'is-disabled' : ''}}" data-which="skills" bindtap="onSubmitField">独立提交技能标签</view>
  </view>

  <!-- 服务亮点 -->
  <view class="ppe__card">
    <view class="ppe__label">服务亮点 <text class="ppe__count">{{highlights.length}}/3</text></view>
    <view class="ppe__hint">每条不超过 30 字，展示在耍伴详情页</view>
    <view class="ppe__hl" wx:for="{{highlights}}" wx:key="index">
      <text class="ppe__hl-text">{{item}}</text>
      <text class="ppe__tag-x" data-index="{{index}}" bindtap="onRemoveHighlight">×</text>
    </view>
    <!-- 添加框恒显示(杜绝"按钮消失"困惑); 满 3 条时点添加由 JS 提示上限 -->
    <view class="ppe__addrow">
      <input class="ppe__input" value="{{highlightInput}}" maxlength="30" placeholder="如：全程陪同不玩手机" placeholder-class="ppe__ph" bindinput="onHighlightInput" />
      <view class="ppe__addbtn" hover-class="btn-press" bindtap="onAddHighlight">添加</view>
    </view>
    <view class="ppe__fieldsubmit {{submitting || auditStatus === 'pending' ? 'is-disabled' : ''}}" data-which="highlights" bindtap="onSubmitField">独立提交服务亮点</view>
  </view>

  <!-- 资质证书: 标题 + 栏目级多图 -->
  <view class="ppe__card">
    <view class="ppe__label">资质证书 <text class="ppe__count">标题 {{qualTitles.length}}/20 · 图片 {{qualPhotos.length}}/6</text></view>
    <view class="ppe__hint">每条不超过 20 字，可配证件/资质照片（单张≤3M），审核通过后展示在详情页</view>
    <view class="ppe__hl" wx:for="{{qualTitles}}" wx:key="index">
      <text class="ppe__hl-text">{{item}}</text>
      <text class="ppe__tag-x" data-index="{{index}}" bindtap="onRemoveQual">×</text>
    </view>
    <view class="ppe__addrow">
      <input class="ppe__input" value="{{qualInput}}" maxlength="20" placeholder="如：护士执业资格证" placeholder-class="ppe__ph" bindinput="onQualInput" />
      <view class="ppe__addbtn" hover-class="btn-press" bindtap="onAddQual">添加</view>
    </view>
    <view class="ppe__media">
      <view class="ppe__media-item" wx:for="{{qualPhotos}}" wx:key="*this">
        <image class="ppe__media-img" src="{{item}}" mode="aspectFill" data-index="{{index}}" data-list="{{qualPhotos}}" bindtap="previewQualPhoto" />
        <view class="ppe__media-del" data-index="{{index}}" catchtap="onRemoveQualPhoto">×</view>
      </view>
      <view class="ppe__media-add" wx:if="{{qualPhotos.length < 6}}" hover-class="btn-press" bindtap="chooseQualPhotos">+<text>添加图片</text></view>
    </view>
    <view class="ppe__fieldsubmit {{submitting || auditStatus === 'pending' ? 'is-disabled' : ''}}" data-which="qual" bindtap="onSubmitField">独立提交资质证书</view>
  </view>

  <!-- 荣誉 其他: 标题 + 栏目级多图 -->
  <view class="ppe__card">
    <view class="ppe__label">荣誉 其他 <text class="ppe__count">标题 {{honTitles.length}}/20 · 图片 {{honPhotos.length}}/6</text></view>
    <view class="ppe__hint">每条不超过 20 字，可配荣誉/奖状照片（单张≤3M），审核通过后展示在详情页</view>
    <view class="ppe__hl" wx:for="{{honTitles}}" wx:key="index">
      <text class="ppe__hl-text">{{item}}</text>
      <text class="ppe__tag-x" data-index="{{index}}" bindtap="onRemoveHon">×</text>
    </view>
    <view class="ppe__addrow">
      <input class="ppe__input" value="{{honInput}}" maxlength="20" placeholder="如：年度优秀服务者" placeholder-class="ppe__ph" bindinput="onHonInput" />
      <view class="ppe__addbtn" hover-class="btn-press" bindtap="onAddHon">添加</view>
    </view>
    <view class="ppe__media">
      <view class="ppe__media-item" wx:for="{{honPhotos}}" wx:key="*this">
        <image class="ppe__media-img" src="{{item}}" mode="aspectFill" data-index="{{index}}" data-list="{{honPhotos}}" bindtap="previewHonPhoto" />
        <view class="ppe__media-del" data-index="{{index}}" catchtap="onRemoveHonPhoto">×</view>
      </view>
      <view class="ppe__media-add" wx:if="{{honPhotos.length < 6}}" hover-class="btn-press" bindtap="chooseHonPhotos">+<text>添加图片</text></view>
    </view>
    <view class="ppe__fieldsubmit {{submitting || auditStatus === 'pending' ? 'is-disabled' : ''}}" data-which="hon" bindtap="onSubmitField">独立提交荣誉 其他</view>
  </view>

  <button class="ppe__submit {{submitting || auditStatus === 'pending' ? 'is-disabled' : ''}}" bindtap="onSubmit" disabled="{{submitting || auditStatus === 'pending'}}">
    {{submitting ? '提交中…' : (auditStatus === 'pending' ? '审核中' : '提交全部')}}
  </button>
  <view class="ppe__safe">资料经平台审核后展示；禁止填写联系方式/链接，违者将影响信用分。</view>

  <!-- 本次待审核事项 -->
  <view class="ppe__card" wx:if="{{pendingBio || pendingSkills.length || pendingHighlights.length || qualPending.titles.length || qualPending.photos.length || honPending.titles.length || honPending.photos.length}}">
    <view class="ppe__label">本次待审核事项 <text class="ppe__pending-badge">待审核</text></view>
    <view class="ppe__ts" wx:if="{{pendingBio}}"><text class="ppe__ts-tag">简介</text>{{pendingBio}}</view>
    <view class="ppe__tags" wx:if="{{pendingSkills.length}}">
      <text class="ppe__ts-tag ppe__ts-tag--inline">技能</text>
      <view class="ppe__tag ppe__tag--pending" wx:for="{{pendingSkills}}" wx:key="*this">{{item}}</view>
    </view>
    <view class="ppe__hl" wx:if="{{pendingHighlights.length}}">
      <text class="ppe__jsx-tt">亮点</text>
      <view wx:for="{{pendingHighlights}}" wx:key="*this" class="ppe__hl-item">{{item}}</view>
    </view>
    <view class="ppe__ts" wx:if="{{qualPending.titles.length || qualPending.photos.length}}">
      <text class="ppe__ts-tag">资质证书</text>
      <block wx:for="{{qualPending.titles}}" wx:key="*this">{{item}}<text wx:if="{{index < qualPending.titles.length - 1}}">、</text></block>
      <text wx:if="{{qualPending.photos.length}}" class="ppe__ts-mut">（图片 {{qualPending.photos.length}} 张）</text>
    </view>
    <view class="ppe__ts" wx:if="{{honPending.titles.length || honPending.photos.length}}">
      <text class="ppe__ts-tag">荣誉 其他</text>
      <block wx:for="{{honPending.titles}}" wx:key="*this">{{item}}<text wx:if="{{index < honPending.titles.length - 1}}">、</text></block>
      <text wx:if="{{honPending.photos.length}}" class="ppe__ts-mut">（图片 {{honPending.photos.length}} 张）</text>
    </view>
  </view>

  <!-- 审核历史 -->
  <view class="ppe__card" wx:if="{{auditHistory.length}}">
    <view class="ppe__label">审核历史</view>
    <view class="ppe__hist" wx:for="{{auditHistory}}" wx:key="index">
      <text class="ppe__hist-badge {{item.result === 'approved' ? 'is-ok' : 'is-bad'}}">{{item.result === 'approved' ? '通过' : '驳回'}}</text>
      <text class="ppe__hist-time">{{item.timeStr}}</text>
      <view class="ppe__hist-reason" wx:if="{{item.reason}}">理由：{{item.reason}}</view>
    </view>
  </view>
</view>
