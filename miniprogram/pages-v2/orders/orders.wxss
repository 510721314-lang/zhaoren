.ol {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 0 20rpx 160rpx;
}

/* 视角切换 */
.ol__role-switch {
  margin-top: 12rpx;
  background: var(--bg-segment);
  border-radius: var(--r-md);
  padding: 6rpx;
  display: flex;
}
.ol__role-item {
  flex: 1;
  height: 68rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-md);
  color: var(--text-3);
}
.ol__role-item.is-on {
  background: var(--bg-card);
  color: var(--brand-primary);
  font-weight: 700;
  box-shadow: var(--shadow-card);
}

/* 状态 tab */
.ol__tabs {
  margin-top: 20rpx;
  white-space: nowrap;
}
.ol__tab {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 28rpx;
  font-size: var(--font-sm);
  color: var(--text-3);
  background: var(--bg-card);
}
.ol__tab.is-on {
  color: var(--text-invert);
  background: var(--brand-primary);
  font-weight: 600;
}

/* 骨架 */
.ol__loading {
  margin-top: 20rpx;
}
.ol__skeleton {
  height: 220rpx;
  border-radius: var(--r-lg);
  background: var(--bg-card);
  margin-bottom: 20rpx;
  opacity: 0.6;
}

/* 订单卡片 */
.ol__card {
  margin-top: 20rpx;
  background: var(--bg-card);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-card);
  padding: 24rpx 28rpx;
}
.ol__card--hover {
  background: var(--bg-segment);
}
.ol__card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.ol__head-left {
  display: flex;
  align-items: center;
}
/* 改期待确认红点 */
.ol__dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--func-danger, #e64340);
  margin-right: 12rpx;
}
.ol__scene {
  font-size: var(--font-md);
  font-weight: 700;
  color: var(--text-1);
}
.ol__status {
  font-size: var(--font-xs);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}
.ol__card-body {
  margin-top: 16rpx;
}
.ol__row {
  font-size: var(--font-sm);
  color: var(--text-3);
  line-height: 1.9;
}
.ol__card-foot {
  margin-top: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-divider);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.ol__no {
  font-size: var(--font-xs);
  color: var(--text-4);
  flex: 1;
  margin-right: 16rpx;
}
.ol__price {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--func-danger);
}
