<view class="v2 ac">
  <nav-bar title="接单配置"></nav-bar>

  <!-- 加载态 -->
  <view class="ac__loading" wx:if="{{loading}}">
    <view class="ac__skeleton" wx:for="{{[1,2,3]}}" wx:key="*this"></view>
  </view>
  <!-- 网络异常态 -->
  <empty-state wx:elif="{{loadError}}" icon="📡" title="网络异常" desc="请检查网络后重试" btnText="重试" bind:btntap="reload" />
  <!-- 正常态 -->
  <block wx:else>
  <view class="ac__body">
    <!-- 0. 日常位置 -->
    <view class="ac__card">
      <view class="ac__card-title">日常位置</view>
      <view class="ac__tip">你的常驻位置，需求方可在耍伴详情查看距离与到达耗时</view>
      <view class="ac__loc" bindtap="onChooseLocation">
        <block wx:if="{{homeLocation}}">
          <view class="ac__loc-main">
            <view class="ac__loc-name">📍 {{homeLocation.name}}</view>
            <view class="ac__loc-addr">{{homeLocation.address}}</view>
          </view>
          <text class="ac__loc-change">重选</text>
        </block>
        <view wx:else class="ac__loc-empty">📍 点击选择日常位置（小区 / 商圈 / 地标）</view>
      </view>
    </view>

    <!-- 1. 场景多选 + 每场景独立时薪 -->
    <view class="ac__card">
      <view class="ac__card-title">接单场景与时薪 <text class="ac__required">*</text></view>
      <view class="ac__tip">选择你要接的场景并设置时薪（{{rateMinYuan}}-{{rateMaxYuan}} 元/小时），点击保存后生效</view>
      <view class="ac__scene-list">
        <view class="ac__scene-row" wx:for="{{certifiedScenes}}" wx:key="code">
          <view class="ac__scene-chip {{item.selected ? 'is-on' : ''}}" data-code="{{item.code}}" bindtap="onSceneToggle">
            {{item.icon}} {{item.name}}
            <text class="ac__exam-tag ac__exam--pass" wx:if="{{item.examNeeded && item.examPassed}}">✓已通过</text>
            <text class="ac__exam-tag ac__exam--fail" wx:elif="{{item.examNeeded && !item.examPassed}}">需考核</text>
          </view>
          <view class="ac__scene-rate" wx:if="{{item.selected}}">
            <input class="ac__scene-rate-input" type="digit" value="{{sceneRateYuan[item.code]}}" placeholder="{{rateMinYuan}}" data-code="{{item.code}}" bindinput="onRateInput" />
            <text class="ac__scene-rate-unit">元/小时</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 2. 每周时段(每天起止时间各一个滑动条) -->
    <view class="ac__card">
      <view class="ac__card-title">每周接单时段</view>
      <view class="ac__card-sub">仅在你启用的时段内可接单：需求的服务时间段须完全落在时段内</view>
      <view class="ac__week-list">
        <view class="ac__week-item" wx:for="{{weekLabels}}" wx:key="key">
          <view class="ac__week-head">
            <switch checked="{{form.weeklySlots[item.key].enabled}}" color="var(--brand-primary)" data-key="{{item.key}}" bindchange="onWeekToggle" />
            <text class="ac__week-name">{{item.name}}</text>
            <text class="ac__week-range" wx:if="{{form.weeklySlots[item.key].enabled}}">{{slotText[item.key].start}} - {{slotText[item.key].end}}{{slotText[item.key].cross ? ' · 次日' : ''}}</text>
            <text class="ac__week-off" wx:else>休息</text>
          </view>
          <block wx:if="{{form.weeklySlots[item.key].enabled}}">
            <view class="ac__slot-row">
              <text class="ac__slot-label">开始</text>
              <slider class="ac__slot-slider" min="0" max="{{slotsPerDay}}" step="1" value="{{slotIdx[item.key].start}}" data-key="{{item.key}}" bindchange="onWeekStartChange" activeColor="var(--brand-primary)" block-size="20" />
            </view>
            <view class="ac__slot-row">
              <text class="ac__slot-label">结束</text>
              <slider class="ac__slot-slider" min="0" max="{{slotsPerDay}}" step="1" value="{{slotIdx[item.key].end}}" data-key="{{item.key}}" bindchange="onWeekEndChange" activeColor="var(--brand-primary)" block-size="20" />
            </view>
          </block>
        </view>
      </view>
    </view>

    <!-- 3. 接单价格区间(广场过滤 + 抢单校验均以此为准) -->
    <view class="ac__card">
      <view class="ac__card-title">接单价格区间</view>
      <view class="ac__card-sub">平台单价范围 {{rateMinYuan}}-{{rateMaxYuan}} 元/小时；超出区间的需求不会出现在广场，也不可接单</view>
      <view class="ac__row">
        <text class="ac__field-label">最低</text>
        <input class="ac__input" type="digit" value="{{form.minPrice}}" bindinput="onMinPriceInput" placeholder="{{minPricePlaceholder}}" />
        <text class="ac__unit">元/小时</text>
      </view>
      <view class="ac__row">
        <text class="ac__field-label">最高</text>
        <input class="ac__input" type="digit" value="{{form.maxPrice}}" bindinput="onMaxPriceInput" placeholder="{{maxPricePlaceholder}}" />
        <text class="ac__unit">元/小时</text>
      </view>
    </view>

    <!-- 4. 最大距离 -->
    <view class="ac__card">
      <view class="ac__card-title">最大接单距离</view>
      <view class="ac__slider-row">
        <slider min="{{distanceRange[0]}}" max="{{distanceRange[1]}}" value="{{form.maxDistance}}" show-value bindchange="onDistanceChange" activeColor="var(--brand-primary)" />
        <text class="ac__slider-unit">km</text>
      </view>
    </view>

    <!-- 5. 性别偏好 -->
    <view class="ac__card">
      <view class="ac__card-title">性别偏好</view>
      <view class="ac__chips">
        <view class="ac__chip {{form.genderPref === item ? 'is-on' : ''}}" wx:for="{{genderOptions}}" wx:key="*this" data-val="{{item}}" bindtap="onGenderTap">{{item}}</view>
      </view>
    </view>

    <!-- 6. 每日接单上限(平台统一设定, 耍伴只读) -->
    <view class="ac__card">
      <view class="ac__card-title">每日接单上限</view>
      <view class="ac__row-between">
        <text class="ac__readonly">{{form.dailyLimit}} 单/天</text>
        <text class="ac__tip">由平台统一设定</text>
      </view>
    </view>

    <!-- 7. 接受公益订单 -->
    <view class="ac__card">
      <view class="ac__row-between">
        <view>
          <view class="ac__card-title">接受公益订单</view>
          <view class="ac__tip">公益单按标准单价{{subsidyPercent}}%补贴</view>
        </view>
        <switch checked="{{form.acceptWelfare}}" color="var(--func-success)" bindchange="onWelfareToggle" />
      </view>
    </view>

    <!-- 8. 缓冲时间 -->
    <view class="ac__card">
      <view class="ac__card-title">接单缓冲时间</view>
      <picker mode="selector" range="{{bufferOptions}}" value="{{bufferIndex}}" bindchange="onBufferChange">
        <view class="ac__picker-row">
          <text class="ac__picker-val">{{form.bufferMin}}分钟</text>
          <text class="ac__arrow">›</text>
        </view>
      </picker>
    </view>
  </view>

  <!-- 9. 保存 -->
  <view class="ac__bottom">
    <button class="ac__btn" bindtap="onSave" hover-class="btn-press">保存配置</button>
  </view>
  </block>

  <night-mask visible="{{isRedline}}" bind:reserve="onReserve"></night-mask>
</view>
