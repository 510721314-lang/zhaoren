.ac { min-height: 100vh; background: var(--bg-page); padding: 0 20rpx 160rpx; }
.ac__body { padding-top: 20rpx; }
.ac__card { background: var(--bg-card); border-radius: var(--r-lg); padding: 24rpx 28rpx; box-shadow: var(--shadow-card); margin-bottom: 20rpx; }
.ac__card-title { font-size: var(--font-md); font-weight: 600; color: var(--text-1); }
.ac__required { color: var(--func-danger); }
.ac__tip { margin-top: 8rpx; font-size: var(--font-xs); color: var(--text-4); }

.ac__loc { margin-top: 16rpx; border: 2rpx dashed var(--brand-primary); border-radius: 14rpx; padding: 22rpx 22rpx; display: flex; align-items: center; }
.ac__loc-main { flex: 1; min-width: 0; }
.ac__loc-name { font-size: var(--font-sm); color: var(--text-1); font-weight: 600; }
.ac__loc-addr { margin-top: 6rpx; font-size: var(--font-xs); color: var(--text-4); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ac__loc-change { margin-left: 16rpx; font-size: var(--font-xs); color: var(--brand-primary); flex-shrink: 0; }
.ac__loc-empty { font-size: var(--font-sm); color: var(--text-4); }

.ac__scene-list { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.ac__scene-chip { display: inline-flex; align-items: center; gap: 8rpx; padding: 12rpx 24rpx; border-radius: 32rpx; background: var(--bg-segment); font-size: var(--font-sm); color: var(--text-2); }
.ac__scene-chip.is-on { background: var(--brand-primary); color: var(--text-invert); }
.ac__exam-tag { font-size: 20rpx; padding: 2rpx 10rpx; border-radius: 16rpx; line-height: 1.6; }
.ac__exam--pass { background: rgba(34,197,94,0.15); color: var(--func-success); }
.ac__exam--fail { background: rgba(250,81,81,0.15); color: var(--func-danger); }

.ac__week-list { margin-top: 16rpx; }
.ac__week-item { padding: 16rpx 0; border-bottom: 1rpx solid var(--border-divider); }
.ac__week-item:last-child { border-bottom: none; }
.ac__week-head { display: flex; align-items: center; }
.ac__week-name { margin-left: 16rpx; font-size: var(--font-sm); color: var(--text-1); }
/* 时段结果显眼展示(HH:mm - HH:mm) */
.ac__week-range { margin-left: auto; font-size: var(--font-md); font-weight: 600; color: var(--brand-primary); }
.ac__week-off { margin-left: auto; font-size: var(--font-sm); color: var(--text-5); }
/* 时段滑动条(开始/结束各一条) */
.ac__slot-row { display: flex; align-items: center; margin-top: 2rpx; }
.ac__slot-label { width: 64rpx; font-size: var(--font-xs); color: var(--text-3); }
.ac__slot-slider { flex: 1; margin: 0 8rpx; }
/* 卡片副标题(说明文案) */
.ac__card-sub { margin-top: 6rpx; font-size: var(--font-xs); color: var(--text-4); line-height: 1.5; }
/* 价格区间两个输入的行前缀 */
.ac__field-label { width: 64rpx; font-size: var(--font-sm); color: var(--text-3); }
/* 只读值(每日接单上限, 平台统一设定) */
.ac__readonly { font-size: var(--font-md); font-weight: 600; color: var(--text-1); }

.ac__row { display: flex; align-items: center; margin-top: 16rpx; }
.ac__input { flex: 1; height: 72rpx; background: var(--bg-segment); border-radius: var(--r-md); padding: 0 16rpx; font-size: var(--font-md); }
.ac__unit { margin-left: 16rpx; font-size: var(--font-sm); color: var(--text-3); }

.ac__slider-row { display: flex; align-items: center; margin-top: 16rpx; }
.ac__slider-row slider { flex: 1; }
.ac__slider-unit { margin-left: 16rpx; font-size: var(--font-sm); color: var(--text-3); }

.ac__chips { display: flex; gap: 12rpx; margin-top: 16rpx; }
.ac__chip { padding: 12rpx 24rpx; border-radius: 32rpx; background: var(--bg-segment); font-size: var(--font-sm); color: var(--text-2); }
.ac__chip.is-on { background: var(--brand-primary); color: var(--text-invert); }

.ac__row-between { display: flex; justify-content: space-between; align-items: center; }

.ac__picker-row { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 0; }
.ac__picker-val { font-size: var(--font-md); color: var(--text-1); }
.ac__arrow { color: var(--text-4); }

.ac__bottom { position: fixed; left: 0; right: 0; bottom: 0; padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom)); background: var(--bg-card); border-top: 1rpx solid var(--border-2); z-index: 100; }
.ac__btn { width: 100%; height: 88rpx; line-height: 88rpx; border-radius: 44rpx; background: var(--brand-primary); color: var(--text-invert); font-size: var(--font-lg); font-weight: 600; }
.ac__btn::after { border: none; }

/* 三态UI · 骨架屏 */
.ac__loading { padding: 16rpx; }
.ac__skeleton { height: 96rpx; background: var(--bg-segment); border-radius: var(--r-md); margin-bottom: 16rpx; animation: ac-skeleton-pulse 1.2s ease-in-out infinite; }
@keyframes ac-skeleton-pulse { 0%,100% { opacity: 0.5; } 50% { opacity: 1; } }
