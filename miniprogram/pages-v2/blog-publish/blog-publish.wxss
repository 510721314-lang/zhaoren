/* pages-v2/blog-publish/blog-publish.wxss · 发布动态 */
.bp { min-height: 100vh; background: var(--bg-page); }
.bp__body { padding: 20rpx 24rpx 60rpx; }
.bp__card { margin-bottom: 20rpx; }

.bp__input { width: 100%; min-height: 220rpx; font-size: var(--font-lg); line-height: 1.7; color: var(--text-1); box-sizing: border-box; }
.bp__count { text-align: right; font-size: var(--font-sm); color: var(--text-4); margin-top: 12rpx; }

.bp__label { font-size: var(--font-md); color: var(--text-2); margin-bottom: 20rpx; }
.bp__pick { display: flex; flex-wrap: wrap; }
.bp__chip {
  padding: 12rpx 26rpx; margin: 0 18rpx 18rpx 0;
  font-size: var(--font-base); color: var(--text-2); background: var(--bg-segment);
  border-radius: var(--r-full); position: relative; transition: var(--ease);
}
.bp__chip--on { background: var(--brand-primary); color: var(--text-invert); padding-right: 50rpx; }
.bp__chip--on::after { content: '✓'; position: absolute; right: 18rpx; top: 50%; transform: translateY(-50%); font-size: var(--font-sm); }

/* 图片九宫格 */
.bp__picker { display: flex; flex-wrap: wrap; }
.bp__picker-item { position: relative; width: 200rpx; height: 200rpx; margin: 0 18rpx 18rpx 0; }
.bp__picker-img { width: 200rpx; height: 200rpx; border-radius: var(--r-sm); background: var(--bg-page); }
.bp__up-mask { position: absolute; inset: 0; background: var(--bg-mask); display: flex; align-items: center; justify-content: center; border-radius: var(--r-sm); }
.bp__up-spinner {
  width: 40rpx; height: 40rpx; border: 5rpx solid rgba(255,255,255,0.3);
  border-top-color: #fff; border-radius: 50%; animation: bp-spin 0.8s linear infinite;
}
@keyframes bp-spin { to { transform: rotate(360deg); } }
.bp__up-del { position: absolute; top: -14rpx; right: -14rpx; width: 40rpx; height: 40rpx; line-height: 36rpx; text-align: center; background: rgba(0,0,0,0.6); color: #fff; border-radius: 50%; font-size: var(--font-lg); }
.bp__picker-add {
  width: 200rpx; height: 200rpx; border: 2rpx dashed var(--border-ghost);
  border-radius: var(--r-sm); display: flex; flex-direction: column;
  align-items: center; justify-content: center; color: var(--text-4); transition: var(--ease);
}
.bp__picker-add--hover { background: var(--bg-segment); }
.bp__add-plus { font-size: var(--font-2xl); line-height: 1; }
.bp__add-text { font-size: var(--font-sm); margin-top: 10rpx; }

.bp__submit { margin-top: 12rpx; }
.bp__tip { text-align: center; font-size: var(--font-sm); color: var(--text-4); margin-top: 24rpx; line-height: 1.6; }