<view class="v2 chat">
  <view style="height: {{statusBarHeight}}px;"></view>

  <!-- C1 头部 -->
  <view class="chat__header">
    <view class="chat__back" bindtap="goOrderDetail">‹</view>
    <view class="chat__title"><block wx:if="{{counterpart}}">{{counterpart}} · {{sceneName}}</block><block wx:else>加载中...</block></view>
    <view class="chat__order-entry" bindtap="goOrderDetail">📋</view>
  </view>

  <!-- 加载态 -->
  <view class="chat__loading" wx:if="{{loading}}">
    <view class="chat__skeleton" wx:for="{{[1,2,3]}}" wx:key="*this"></view>
  </view>
  <!-- 网络异常态 -->
  <empty-state wx:elif="{{loadError}}" icon="📡" title="无法打开会话" desc="{{loadErrorMsg || '请检查网络后重试'}}" btnText="重试" bind:btntap="reload" />
  <!-- 正常态 -->
  <block wx:elif="{{orderId}}">
  <!-- 待支付横幅(仅付款方可见; 放弃支付后由此再次进入支付) -->
  <view class="chat__pay-banner" wx:if="{{orderStatus === 'S0' && role === 'user'}}" bindtap="goPay">
    <text>✅ 四项确认完成,订单待支付(30分钟内有效)</text>
    <text class="chat__pay-go">去支付 ›</text>
  </view>

  <!-- C2 四确认进度条 -->
  <confirm-progress progress="{{progress}}"></confirm-progress>

  <!-- C3 限制提示条 -->
  <view class="chat__limit {{unlocked ? 'is-ok' : ''}}">
    <block wx:if="{{chatBlocked}}">⛔ 订单已取消/关闭,会话已停止</block>
    <block wx:elif="{{!unlocked}}">⚠ 四确认完成前仅可使用模板消息沟通</block>
    <block wx:else>已解锁自由沟通</block>
  </view>

  <!-- C4 消息流 -->
  <scroll-view scroll-y class="chat__flow" scroll-into-view="{{scrollToView}}" scroll-with-animation enhanced>
    <view class="chat__msg-wrap" wx:for="{{messages}}" wx:key="_id" id="{{item._id}}">
      <!-- 系统事件条 -->
      <view class="chat__system" wx:if="{{item.msg_type === 'system'}}">
        <text>{{item.content}}</text>
        <text class="chat__msg-time">{{item.created_at}}</text>
      </view>

      <!-- 模板消息卡 -->
      <tm-template-card wx:if="{{item.msg_type === 'template'}}" msg="{{item}}" bind:optiontap="onTmOption"></tm-template-card>

      <!-- 普通文字气泡 -->
      <view class="chat__bubble chat__bubble--{{item.direction}}" wx:if="{{item.msg_type === 'text'}}">
        <view class="chat__bubble-text">{{item.content}}</view>
        <view class="chat__bubble-time">{{item.created_at}} <text wx:if="{{item.is_read}}">✓✓</text></view>
      </view>
    </view>
  </scroll-view>

  <!-- C5 模板快捷键行 -->
  <view class="chat__quick" wx:if="{{!unlocked && !chatBlocked}}">
    <view class="chat__quick-item" wx:for="{{quickKeys}}" wx:key="id" data-id="{{item.id}}" bindtap="onQuickKey">
      <view class="chat__quick-ic">{{item.icon}}</view>
      <view class="chat__quick-name">{{item.name}}</view>
    </view>
  </view>

  <!-- C6 输入行 -->
  <view class="chat__input-bar">
    <block wx:if="{{chatBlocked}}">
      <view class="chat__input-locked">⛔ 会话已停止</view>
    </block>
    <block wx:elif="{{!unlocked}}">
      <view class="chat__input-locked">🔒 四确认完成后解锁自由沟通...</view>
    </block>
    <block wx:else>
      <input class="chat__input" value="{{inputText}}" placeholder="输入消息..." bindinput="onTextInput" confirm-type="send" bindconfirm="sendText" />
      <view class="chat__send-btn" bindtap="sendText">发送</view>
    </block>
  </view>

  <!-- 调整时间弹层 -->
  <bottom-sheet visible="{{editSheet === 'time'}}" title="🕐 调整服务时间" bind:close="closeEditSheet" has-footer="{{true}}">
    <picker mode="date" value="{{editDate}}" bindchange="onEditDate">
      <view class="chat__edit-field"><text>服务日期</text><text class="chat__edit-val">{{editDate || '请选择'}}</text></view>
    </picker>
    <picker mode="time" value="{{editTimeHm}}" bindchange="onEditTimeHm">
      <view class="chat__edit-field"><text>开始时间</text><text class="chat__edit-val">{{editTimeHm || '请选择'}}</text></view>
    </picker>
    <view class="chat__edit-tip">修改后四项确认将全部重置,需双方重新确认</view>
    <view slot="footer" class="chat__other-btns">
      <button class="chat__btn chat__btn--ghost" bindtap="closeEditSheet" hover-class="btn-press">取消</button>
      <button class="chat__btn chat__btn--primary" bindtap="confirmEditTime" hover-class="btn-press">确认修改</button>
    </view>
  </bottom-sheet>

  <!-- 调整内容弹层 -->
  <bottom-sheet visible="{{editSheet === 'content'}}" title="📋 调整服务内容" bind:close="closeEditSheet" has-footer="{{true}}">
    <checkbox-group bindchange="onEditContentChange">
      <view class="chat__edit-opt" wx:for="{{editContentOpts}}" wx:key="name">
        <checkbox value="{{item.name}}" checked="{{item.checked}}" />
        <text>{{item.name}}</text>
      </view>
    </checkbox-group>
    <view class="chat__edit-tip">修改后四项确认将全部重置,需双方重新确认</view>
    <view slot="footer" class="chat__other-btns">
      <button class="chat__btn chat__btn--ghost" bindtap="closeEditSheet" hover-class="btn-press">取消</button>
      <button class="chat__btn chat__btn--primary" bindtap="confirmEditContent" hover-class="btn-press">确认修改</button>
    </view>
  </bottom-sheet>

  <!-- 调整费用弹层 -->
  <bottom-sheet visible="{{editSheet === 'fee'}}" title="💰 调整费用" bind:close="closeEditSheet" has-footer="{{true}}">
    <view class="chat__edit-field">
      <text>调整后总价</text>
      <input class="chat__edit-input" type="digit" value="{{editFeeYuan}}" placeholder="单位:元" bindinput="onEditFeeInput" />
    </view>
    <view class="chat__edit-tip">修改后四项确认将全部重置,需双方重新确认;平台将按新金额重新计算服务费</view>
    <view slot="footer" class="chat__other-btns">
      <button class="chat__btn chat__btn--ghost" bindtap="closeEditSheet" hover-class="btn-press">取消</button>
      <button class="chat__btn chat__btn--primary" bindtap="confirmEditFee" hover-class="btn-press">确认修改</button>
    </view>
  </bottom-sheet>

  </block>
  <!-- 空态 -->
  <empty-state wx:else icon="📭" title="数据不存在" desc="该记录可能已被删除" />
  <night-mask visible="{{isRedline}}" bind:reserve="onReserve"></night-mask>
</view>
