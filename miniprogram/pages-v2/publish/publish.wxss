.pub {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 0 20rpx 180rpx;
}
.pub__draft-entry {
  font-size: var(--font-sm);
  color: var(--brand-primary);
}

.pub__block {
  background: var(--bg-card);
  border-radius: var(--r-lg);
  padding: 24rpx 28rpx;
  margin-top: 20rpx;
  box-shadow: var(--shadow-card);
}
.pub__label {
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--text-2);
  margin-bottom: 16rpx;
}
.pub__required {
  color: var(--func-danger);
  margin-left: 4rpx;
}

/* 定向邀约横幅 */
.pub__direct {
  margin-top: 20rpx;
  background: var(--func-warning-light);
  color: var(--text-aa);
  border: 1rpx solid var(--func-warning-light);
  border-radius: var(--r-lg);
  padding: 18rpx 24rpx;
  font-size: var(--font-sm);
  font-weight: 600;
}

/* 地址信息小标题 */
.pub__sub-title {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-divider);
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--text-1);
}
/* 发布地址(只读GPS) */
.pub__pub-loc {
  flex: 1;
}

/* B2 segment */
.pub__segment {
  display: flex;
  background: var(--bg-segment);
  border-radius: var(--r-md);
  padding: 6rpx;
}
.pub__seg {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 20rpx;
  font-size: var(--font-sm);
  color: var(--text-3);
}
.pub__seg.is-on {
  background: var(--bg-card);
  color: var(--brand-primary);
  font-weight: 700;
  box-shadow: var(--shadow-card);
}
.pub__welfare-tip {
  margin-top: 16rpx;
  background: var(--func-success-light);
  color: var(--func-success);
  font-size: var(--font-sm);
  line-height: 1.6;
  border-radius: var(--r-sm);
  padding: 14rpx 18rpx;
}

/* B3 场景 */
.pub__scene-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.pub__scene-card {
  position: relative;
  width: calc(33.33% - 11rpx);
  border-radius: var(--r-md);
  border: 2rpx solid var(--border-1);
  padding: 16rpx 0;
  text-align: center;
}
.pub__scene-card.is-on {
  border-color: var(--brand-primary);
  background: var(--brand-primary-light);
}
.pub__scene-ic {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  margin: 0 auto 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-xxl);
}
.pub__scene-name {
  font-size: var(--font-sm);
  color: var(--text-2);
}
.pub__gb-badge {
  position: absolute;
  top: -12rpx;
  right: 12rpx;
  background: var(--brand-accent);
  color: var(--text-invert);
  font-size: var(--font-xs);
  line-height: 1.5;
  padding: 0 8rpx;
  border-radius: 8rpx;
}

/* B4 输入 */
.pub__input {
  width: 100%;
  height: 68rpx;
  background: var(--bg-input);
  border: 1rpx solid var(--border-1);
  border-radius: var(--r-sm);
  padding: 0 20rpx;
  font-size: var(--font-md);
  color: var(--text-1);
}
.pub__textarea {
  width: 100%;
  height: 160rpx;
  background: var(--bg-input);
  border: 1rpx solid var(--border-1);
  border-radius: var(--r-sm);
  padding: 14rpx 20rpx;
  font-size: var(--font-md);
  color: var(--text-1);
}
.pub__count {
  text-align: right;
  font-size: var(--font-xs);
  color: var(--text-disabled);
  margin-top: 8rpx;
}

/* B5 picker */
.pub__picker-row {
  display: flex;
  align-items: center;
  height: 72rpx;
  border-bottom: 1rpx solid var(--border-divider);
}
.pub__picker-label {
  width: 120rpx;
  font-size: var(--font-md);
  color: var(--text-2);
  flex-shrink: 0;
}
.pub__picker-val {
  flex: 1;
  font-size: var(--font-md);
  color: var(--text-1);
}
.pub__picker-val.is-empty {
  color: var(--text-5);
}
.pub__picker-input {
  flex: 1;
  font-size: var(--font-md);
  color: var(--text-1);
}
.pub__arrow {
  font-size: var(--font-xxl);
  color: var(--text-4);
  flex-shrink: 0;
}
.pub__sub-label {
  margin-top: 16rpx;
  margin-bottom: 8rpx;
  font-size: var(--font-sm);
  color: var(--text-3);
}
.pub__location-tip {
  margin-top: 10rpx;
  font-size: var(--font-xs);
  color: var(--brand-accent);
}
/* 经纬度显示(灰色小字, 紧贴地址行下方) */
.pub__coord {
  margin-top: 6rpx;
  padding: 0 120rpx;  /* 与 picker-label 对齐 */
  font-size: 22rpx;
  color: var(--text-4);
  line-height: 1.4;
}
/* 距离提示(蓝色强调, 在两地址经纬度之间) */
.pub__distance {
  margin-top: 8rpx;
  padding: 0 120rpx;
  font-size: 24rpx;
  color: var(--text-3);
}
.pub__dist-val {
  color: var(--brand-primary);
  font-weight: 600;
}

/* B6 行 */
.pub__row {
  display: flex;
  align-items: center;
  height: 72rpx;
  border-bottom: 1rpx solid var(--border-divider);
}
.pub__row:last-child {
  border-bottom: none;
}
.pub__row-label {
  width: 120rpx;
  font-size: var(--font-md);
  color: var(--text-2);
  flex-shrink: 0;
}
.pub__row-unit {
  font-size: var(--font-sm);
  color: var(--text-4);
  margin-left: 12rpx;
}
.pub__stepper {
  display: flex;
  align-items: center;
}
.pub__step-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--bg-segment);
  font-size: var(--font-xxl);
  color: var(--text-2);
}
.pub__step-val {
  width: 80rpx;
  text-align: center;
  font-size: var(--font-lg);
  color: var(--text-1);
  font-weight: 600;
}
.pub__budget-input {
  flex: 1;
  height: 56rpx;
  border: 1rpx solid var(--border-1);
  border-radius: var(--r-sm);
  padding: 0 16rpx;
  font-size: var(--font-md);
  color: var(--text-1);
}

/* chips 通用 */
.pub__chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.pub__chip {
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 24rpx;
  border-radius: 30rpx;
  background: var(--bg-segment);
  color: var(--text-3);
  font-size: var(--font-sm);
}
.pub__chip.is-on {
  background: var(--brand-primary);
  color: var(--text-invert);
  font-weight: 600;
}
.pub__input--mt {
  margin-top: 16rpx;
}

/* B9 撮合模式 */
.pub__mode-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.pub__mode-card {
  border: 2rpx solid var(--border-1);
  border-radius: var(--r-md);
  padding: 20rpx 24rpx;
}
.pub__mode-card.is-on {
  border-color: var(--brand-primary);
  background: var(--brand-primary-light);
}
.pub__mode-card.is-locked {
  opacity: 0.5;
}
.pub__mode-name {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-1);
}
.pub__vip-badge {
  margin-left: 8rpx;
  background: var(--brand-accent);
  color: var(--text-invert);
  font-size: var(--font-xs);
  padding: 0 8rpx;
  border-radius: 8rpx;
}
.pub__mode-desc {
  margin-top: 6rpx;
  font-size: var(--font-sm);
  color: var(--text-4);
}

/* B10 */
.pub__autosave {
  margin-top: 16rpx;
  text-align: center;
  font-size: var(--font-xs);
  color: var(--func-success);
}

/* B11 */
.pub__bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--bg-card);
  border-top: 1rpx solid var(--border-2);
  display: flex;
  gap: 20rpx;
  z-index: 100;
}
.pub__btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: var(--font-md);
  margin: 0;
}
.pub__btn::after {
  border: none;
}
.pub__btn--ghost {
  background: var(--bg-card);
  color: var(--text-3);
  border: 1rpx solid var(--border-ghost);
}
.pub__btn--primary {
  background: var(--brand-primary);
  color: var(--text-invert);
  font-weight: 600;
}
.pub__btn--primary[disabled] {
  background: var(--btn-disabled-bg);
  color: var(--text-invert);
}

/* B3.1 已选服务内容 + 服务内容选择窗 */
.pub__opt-row {
  margin-top: 18rpx;
}
.pub__opt-label {
  font-size: var(--font-sm);
  color: var(--text-2);
  margin-bottom: 8rpx;
}
.pub__opt-picked {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  min-height: 76rpx;
  padding: 12rpx 20rpx;
  border: 1rpx solid var(--border-1);
  border-radius: 14rpx;
  background: var(--bg-card);
}
.pub__opt-chip {
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 20rpx;
  border-radius: 26rpx;
  background: var(--brand-primary-light);
  color: var(--brand-primary);
  font-size: var(--font-sm);
}
.pub__opt-empty {
  flex: 1;
  color: var(--text-3);
  font-size: var(--font-sm);
}
.pub__opt-edit {
  margin-left: auto;
  color: var(--brand-primary);
  font-size: var(--font-sm);
}
.pub__opt-tip {
  font-size: var(--font-sm);
  color: var(--text-3);
  margin-bottom: 16rpx;
}
.pub__opt-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-bottom: 12rpx;
}
.pub__opt-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--border-1);
  border-radius: 14rpx;
  background: var(--bg-card);
  color: var(--text-2);
  font-size: var(--font-md);
}
.pub__opt-item.is-on {
  border-color: var(--brand-primary);
  background: var(--brand-primary-light);
  color: var(--brand-primary);
  font-weight: 600;
}
.pub__opt-check {
  font-size: var(--font-md);
  color: var(--brand-primary);
}
.pub__opt-footer {
  display: flex;
}

/* 草稿项 */
.pub__draft-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-divider);
}
.pub__draft-item:last-child {
  border-bottom: none;
}
.pub__draft-title {
  font-size: var(--font-md);
  color: var(--text-1);
}
.pub__draft-meta {
  margin-top: 6rpx;
  font-size: var(--font-xs);
  color: var(--text-5);
}
.pub__draft-empty {
  text-align: center;
  padding: 60rpx 0;
  font-size: var(--font-sm);
  color: var(--text-5);
}

/* B3.2 W9 宠物照料授权书(电子确认) */
.pub__pet-doc {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F2F3F5;
}
.pub__pet-doc-name { font-size: 28rpx; color: #222; }
.pub__pet-doc-op { font-size: 26rpx; color: #22B573; }
.pub__pet-agree { margin-top: 16rpx; }
.pub__pet-agree-label {
  display: flex;
  align-items: flex-start;
  font-size: 26rpx;
  color: #606266;
  line-height: 1.6;
}
.pub__pet-agree-label checkbox { transform: scale(0.8); margin-right: 8rpx; flex-shrink: 0; }

/* W9 授权书电子文件弹窗(bottom-sheet 内容/底部按钮) */
.pub__pet-sheet-body {
  height: 52vh;
  box-sizing: border-box;
  padding: 8rpx 0 0;
}
.pub__pet-sheet-text {
  font-size: 27rpx;
  color: #4E5969;
  line-height: 1.85;
  white-space: pre-wrap;
}
.pub__pet-sheet-foot { display: flex; gap: 20rpx; }
.pub__sign-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 44rpx;
  font-size: 30rpx;
}
.pub__sign-btn--cancel { background: #F2F3F5; color: #606266; }
.pub__sign-btn--ok { background: #22B573; color: #fff; font-weight: 600; }
