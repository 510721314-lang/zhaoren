<view class="v2 pub">
  <nav-bar title="{{navTitle}}" bg="var(--bg-card)">
    <view slot="right" class="pub__draft-entry" wx:if="{{draftCount > 0}}" data-count="{{draftCount}}" bindtap="openDraftBox">
      📋草稿箱({{draftCount}})
    </view>
  </nav-bar>

  <view style="height: {{statusBarHeight + 46}}px;"></view>

  <!-- 定向邀约横幅(从耍伴详情"咨询/邀TA"进入) -->
  <view class="pub__direct" wx:if="{{directInvite}}">
    🎯 定向邀约：{{invitePartnerName || '指定耍伴'}} · 发布后仅TA可见可接单
  </view>

  <!-- B2 项目属性 -->
  <view class="pub__block">
    <view class="pub__label">项目属性</view>
    <view class="pub__segment">
      <view class="pub__seg {{form.project_attr === 'commercial' ? 'is-on' : ''}}" data-attr="commercial" bindtap="setAttr">💰 商业付费</view>
      <view class="pub__seg {{form.project_attr === 'public_welfare' ? 'is-on' : ''}}" data-attr="public_welfare" bindtap="setAttr">💚 公益免费</view>
    </view>
    <view class="pub__welfare-tip" wx:if="{{form.project_attr === 'public_welfare'}}">
      {{welfareText}}
    </view>
  </view>

  <!-- B3 场景选择 -->
  <view class="pub__block">
    <view class="pub__label">场景选择 <text class="pub__required">*</text></view>
    <view class="pub__scene-grid">
      <view class="pub__scene-card {{form.scene_code === item.code ? 'is-on' : ''}}" wx:for="{{scenes}}" wx:key="code" data-code="{{item.code}}" bindtap="setScene">
        <view class="pub__gb-badge" wx:if="{{item.gb}}">国标</view>
        <view class="pub__scene-ic" style="background:{{item.color}};">{{item.icon}}</view>
        <view class="pub__scene-name">{{item.name}}</view>
      </view>
    </view>
    <!-- B3.1 已选服务内容(点场景卡→免责声明→选择窗; 此处可点击重新编辑) -->
    <view class="pub__opt-row" wx:if="{{form.scene_code}}">
      <view class="pub__opt-label">服务内容 <text class="pub__required">*</text></view>
      <view class="pub__opt-picked" bindtap="openOptionSheet">
        <block wx:if="{{form.content_options.length > 0}}">
          <text class="pub__opt-chip" wx:for="{{form.content_options}}" wx:key="*this">{{item}}</text>
        </block>
        <text class="pub__opt-empty" wx:else>请选择服务内容</text>
        <text class="pub__opt-edit">修改 ›</text>
      </view>
    </view>
  </view>

  <!-- B3.2 W9 宠物照料授权书(PRD R9: 「明确授权」须留存电子凭证, 无凭证视为未授权、不得履约) -->
  <view class="pub__block" wx:if="{{form.scene_code === 'W9'}}">
    <view class="pub__label">宠物照料授权 <text class="pub__required">*</text></view>
    <view class="pub__pet-doc" bindtap="openPetAuthSheet">
      <text class="pub__pet-doc-name">《宠物照料授权书》</text>
      <text class="pub__pet-doc-op">{{petAuthChecked ? '已签署 · 点击查看' : '点击查看全文'}}</text>
    </view>
    <checkbox-group bindchange="onPetAuthChange" class="pub__pet-agree">
      <label class="pub__pet-agree-label">
        <checkbox value="ok" checked="{{petAuthChecked}}" color="#22B573" />
        <text>本人为宠物主人或已获明确授权；勾选后将弹出授权书电子文件，需签字确认后才生效，知悉该电子确认将作为授权凭证留存</text>
      </label>
    </checkbox-group>
  </view>

  <!-- B4 标题+描述 -->
  <view class="pub__block">
    <view class="pub__label">需求标题 <text class="pub__required">*</text></view>
    <input class="pub__input" value="{{form.title}}" placeholder="一句话描述需求" maxlength="{{titleMax}}" bindinput="onTitleInput" />
    <view class="pub__count">{{titleCount}}/{{titleMax}}</view>
  </view>
  <view class="pub__block">
    <view class="pub__label">详细描述 <text class="pub__required">*</text></view>
    <textarea class="pub__textarea" value="{{form.description}}" placeholder="详细说明服务内容、要求等" maxlength="{{descMax}}" bindinput="onDescInput" />
    <view class="pub__count">{{descCount}}/{{descMax}}</view>
  </view>

  <!-- B5 时间地点 -->
  <view class="pub__block">
    <view class="pub__label">服务时间与地点</view>
    <picker mode="date" start="{{today}}" end="{{dateMax}}" value="{{form.service_date}}" bindchange="onDateChange">
      <view class="pub__picker-row">
        <text class="pub__picker-label">日期</text>
        <text class="pub__picker-val {{form.service_date ? '' : 'is-empty'}}">{{form.service_date || '请选择'}}</text>
        <text class="pub__arrow">›</text>
      </view>
    </picker>
    <picker mode="time" start="{{redlineOpen}}" end="{{redlineClose}}" value="{{form.service_time}}" bindchange="onTimeChange">
      <view class="pub__picker-row">
        <text class="pub__picker-label">时间</text>
        <text class="pub__picker-val {{form.service_time ? '' : 'is-empty'}}">{{form.service_time || '请选择'}}</text>
        <text class="pub__arrow">›</text>
      </view>
    </picker>
    <view class="pub__sub-label">时长</view>
    <view class="pub__chips">
      <view class="pub__chip {{form.duration_hours === item ? 'is-on' : ''}}" wx:for="{{durationOptions}}" wx:key="*this" data-val="{{item}}" bindtap="setDuration">{{item}}h</view>
    </view>
    <input class="pub__input pub__input--mt" wx:if="{{form.duration_hours === 0}}" placeholder="自定义小时数" type="digit" bindinput="onDurationCustomInput" />
    <!-- 地址信息(图3): 发布地址=当前GPS自动记录不可改; 履约地址=地图选点 -->
    <view class="pub__sub-title">地址信息</view>
    <view class="pub__picker-row" bindtap="onRelocatePublish">
      <text class="pub__picker-label">发布地址</text>
      <text class="pub__picker-val {{publishLocation ? '' : 'is-empty'}} pub__pub-loc">
        {{locating ? '定位中…' : (publishLocation ? '当前位置' + (publishLocation.updatedAt ? ' · ' + publishLocation.updatedAt : '') : '点击获取当前位置')}}
      </text>
      <text class="pub__arrow">📍</text>
    </view>
    <view class="pub__coord" wx:if="{{publishLocation && publishLocation.address}}">📍 {{publishLocation.address}}</view>
    <view class="pub__location-tip">📌 发布地址为您发布时的实际定位，自动记录不可修改；点击可重新定位</view>
    <view class="pub__picker-row" bindtap="onLocationPick">
      <text class="pub__picker-label">履约地址</text>
      <input class="pub__picker-input" value="{{form.location_name}}" placeholder="点击在地图上选择履约地点" bindinput="onLocationInput" catchtap="noop" />
      <text class="pub__arrow">📍</text>
    </view>
    <!-- 经纬度隐藏用于截图审核, 保留给地址名 -->
    <view class="pub__coord" wx:if="{{form.location_name && form.location_name !== ''}}">📌 {{form.location_name}}</view>
    <view class="pub__distance" wx:if="{{distanceKm > 0}}">
      📏 发布地址到履约地址相距 <text class="pub__dist-val">{{distanceText}}</text>
    </view>
    <view class="pub__location-tip">📍 耍伴将在此地点与您碰面，请准确选择；接单时校验耍伴与此地距离不超过 {{distanceMaxKm}} 公里</view>
  </view>

  <!-- B6 人数预算 -->
  <view class="pub__block">
    <view class="pub__label">人数与预算</view>
    <view class="pub__row">
      <text class="pub__row-label">人数</text>
      <view class="pub__stepper">
        <view class="pub__step-btn" bindtap="decHeadcount">-</view>
        <view class="pub__step-val">{{form.headcount}}</view>
        <view class="pub__step-btn" bindtap="incHeadcount">+</view>
      </view>
    </view>
    <view class="pub__row" wx:if="{{form.project_attr === 'commercial'}}">
      <text class="pub__row-label">预算</text>
      <input class="pub__budget-input" type="digit" value="{{form.budget}}" placeholder="{{budgetPlaceholder}}" bindinput="onBudgetInput" />
      <text class="pub__row-unit">元/小时</text>
    </view>
  </view>

  <!-- B7 AA费用预估 -->
  <view class="pub__block">
    <view class="pub__label">AA费用预估 <text class="pub__required">*</text></view>
    <view class="pub__chips">
      <view class="pub__chip {{form.aa_estimate === item.value ? 'is-on' : ''}}" wx:for="{{aaOptions}}" wx:key="value" data-val="{{item.value}}" bindtap="setAA">
        {{item.label}}
      </view>
    </view>
    <input class="pub__input pub__input--mt" wx:if="{{form.aa_estimate === 'custom'}}" placeholder="预估AA费用" type="digit" bindinput="onAACustomInput" />
  </view>

  <!-- B8 性别偏好 -->
  <view class="pub__block">
    <view class="pub__label">性别偏好</view>
    <view class="pub__chips">
      <view class="pub__chip {{form.gender_pref === '不限' ? 'is-on' : ''}}" data-val="不限" bindtap="setGender">不限</view>
      <view class="pub__chip {{form.gender_pref === '男' ? 'is-on' : ''}}" data-val="男" bindtap="setGender">男</view>
      <view class="pub__chip {{form.gender_pref === '女' ? 'is-on' : ''}}" data-val="女" bindtap="setGender">女</view>
    </view>
  </view>

  <!-- B9 撮合模式(定向邀约进入时锁定, 不再展示选择) -->
  <view class="pub__block" wx:if="{{!directInvite}}">
    <view class="pub__label">撮合模式</view>
    <view class="pub__mode-list">
      <view class="pub__mode-card {{form.match_mode === item.code ? 'is-on' : ''}} {{item.code === 'smart' && smartLocked ? 'is-locked' : ''}}" wx:for="{{matchModes}}" wx:key="code" data-code="{{item.code}}" bindtap="setMatchMode">
        <view class="pub__mode-name">
          {{item.name}}
          <text class="pub__vip-badge" wx:if="{{item.needVip}}">VIP</text>
        </view>
        <view class="pub__mode-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <!-- B10 自动保存提示 -->
  <view class="pub__autosave" wx:if="{{autoSaveText}}">✓草稿已自动保存·{{autoSaveText}}（有效期{{draftExpireDays}}天）</view>

  <!-- B11 底部按钮(编辑模式=修改需求: 放弃修改/确认修改) -->
  <view class="pub__bottom">
    <block wx:if="{{isEditMode}}">
      <button class="pub__btn pub__btn--ghost" bindtap="onGiveUpEdit" hover-class="btn-press">放弃修改</button>
      <button class="pub__btn pub__btn--primary" loading="{{publishing}}" disabled="{{publishing}}" bindtap="onPublish">确认修改</button>
    </block>
    <block wx:else>
      <button class="pub__btn pub__btn--ghost" bindtap="saveDraft" hover-class="btn-press">存草稿</button>
      <button class="pub__btn pub__btn--primary" loading="{{publishing}}" disabled="{{publishing}}" bindtap="onPublish">发布需求</button>
    </block>
  </view>

  <!-- 草稿箱弹窗(列表选择类弹层, bottom-sheet 保留) -->
  <bottom-sheet visible="{{draftBoxVisible}}" title="草稿箱" bind:close="closeDraftBox">
    <view class="pub__draft-item" wx:for="{{draftList}}" wx:key="_id" data-index="{{index}}" bindtap="restoreDraft">
      <view class="pub__draft-title">{{item.demand_data.title}}</view>
      <view class="pub__draft-meta">{{item.demand_data.service_date}} · 保存于 {{item.saved_at}}</view>
    </view>
    <view class="pub__draft-empty" wx:if="{{draftList.length === 0}}">暂无草稿</view>
  </bottom-sheet>

  <!-- 服务内容(子服务项)选择窗: 选场景→免责声明通过后自动弹出 -->
  <bottom-sheet visible="{{optionSheetVisible}}" title="选择服务内容" has-footer="{{true}}" bind:close="closeOptionSheet">
    <view class="pub__opt-tip">请选择本次需要的服务（至少 1 项，最多 3 项）</view>
    <view class="pub__opt-list">
      <view class="pub__opt-item {{item.checked ? 'is-on' : ''}}" wx:for="{{optionList}}" wx:key="name" data-name="{{item.name}}" bindtap="toggleOption">
        <text class="pub__opt-name">{{item.name}}</text>
        <text class="pub__opt-check">{{item.checked ? '✓' : ''}}</text>
      </view>
    </view>
    <view slot="footer" class="pub__opt-footer">
      <button class="pub__btn pub__btn--primary" bindtap="confirmOptions">确定</button>
    </view>
  </bottom-sheet>

  <!-- W9 宠物照料授权书 电子文件弹窗(签字确认 / 取消) -->
  <bottom-sheet visible="{{petAuthSheetVisible}}" title="宠物照料授权书" has-footer="{{true}}" bind:close="onPetAuthCancel">
    <scroll-view class="pub__pet-sheet-body" scroll-y>
      <text class="pub__pet-sheet-text">{{petAuthText || '授权书文本加载失败，请检查网络后重试'}}</text>
    </scroll-view>
    <view slot="footer" class="pub__pet-sheet-foot">
      <view class="pub__sign-btn pub__sign-btn--cancel" bindtap="onPetAuthCancel">取消</view>
      <view class="pub__sign-btn pub__sign-btn--ok" bindtap="onPetAuthSign">本人签字确认</view>
    </view>
  </bottom-sheet>

  <night-mask visible="{{isRedline}}" bind:reserve="onReserve"></night-mask>
</view>
