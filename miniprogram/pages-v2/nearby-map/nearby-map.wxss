.nm { position: relative; width: 100vw; height: 100vh; background: var(--bg-page); }
.nm__map { width: 100%; height: 100%; }

/* 顶部快捷开关 */
.nm__toggle {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  z-index: 10;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  background: var(--bg-page);
  color: var(--text-4);
  font-size: 24rpx;
  box-shadow: var(--shadow-card);
}
.nm__toggle.is-on { background: var(--brand-primary); color: var(--text-invert); }

/* 刷新 */
.nm__refresh {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  z-index: 10;
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--bg-card);
  color: var(--brand-primary);
  font-size: 36rpx;
  box-shadow: var(--shadow-card);
}

/* 分享提示卡 */
.nm__hint {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 110rpx;
  z-index: 10;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--bg-card);
  border-radius: var(--r-md);
  padding: 20rpx 24rpx;
  box-shadow: var(--shadow-card);
}
.nm__hint-emoji { font-size: 44rpx; }
.nm__hint-title { font-size: var(--font-sm); font-weight: 600; color: var(--text-1); }
.nm__hint-sub { margin-top: 4rpx; font-size: var(--font-xs); color: var(--text-5); }
.nm__hint-btn {
  margin-left: auto;
  flex-shrink: 0;
  font-size: var(--font-sm);
  color: var(--brand-primary);
  font-weight: 600;
}

/* 选中卡片 */
.nm__card {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 56rpx;
  z-index: 10;
  background: var(--bg-card);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}
.nm__card-body { display: flex; align-items: center; gap: 20rpx; padding: 24rpx; }
.nm__card-avatar { width: 88rpx; height: 88rpx; border-radius: 50%; background: var(--bg-segment); }
.nm__card-emoji { width: 88rpx; height: 88rpx; line-height: 88rpx; text-align: center; font-size: 48rpx; background: var(--bg-segment); border-radius: 50%; }
.nm__card-info { flex: 1; min-width: 0; }
.nm__card-name { font-size: var(--font-md); font-weight: 600; color: var(--text-1); }
.nm__card-tag { margin-top: 6rpx; font-size: var(--font-xs); color: var(--text-5); }
.nm__card-close { flex-shrink: 0; width: 48rpx; height: 48rpx; line-height: 44rpx; text-align: center; color: var(--text-4); font-size: 28rpx; }
.nm__card-btn {
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: var(--font-md);
  color: var(--text-invert);
  background: var(--brand-primary);
  font-weight: 600;
}

.nm__loading {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 20;
  color: var(--text-4);
  font-size: var(--font-sm);
  background: rgba(255,255,255,0.8);
  padding: 16rpx 28rpx;
  border-radius: 30rpx;
}