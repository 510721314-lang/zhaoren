.pa { padding: 32rpx 28rpx 200rpx; }

.pa__hero {
  text-align: center;
  padding: 48rpx 0 40rpx;
}
.pa__hero-emoji { font-size: 96rpx; }
.pa__hero-title {
  font-size: 40rpx; font-weight: 700; color: var(--text-1);
  margin-top: 8rpx;
}
.pa__hero-sub {
  font-size: 26rpx; color: var(--text-4); margin-top: 12rpx;
}

.pa__card {
  background: var(--bg-card); border-radius: 20rpx; padding: 32rpx 28rpx;
  margin-top: 24rpx; box-shadow: var(--shadow-card);
}
.pa__card-title {
  font-size: 30rpx; font-weight: 600; color: var(--text-1); margin-bottom: 24rpx;
}
.pa__required { color: var(--func-danger); margin-left: 4rpx; }
.pa__tip { font-size: 24rpx; color: var(--text-4); margin: -12rpx 0 20rpx; line-height: 1.5; }

.pa__loc {
  border: 2rpx dashed var(--func-warning); border-radius: 14rpx;
  padding: 24rpx 22rpx; display: flex; align-items: center;
}
.pa__loc-main { flex: 1; min-width: 0; }
.pa__loc-name { font-size: 28rpx; color: var(--text-1); font-weight: 600; }
.pa__loc-addr {
  font-size: 24rpx; color: var(--text-4); margin-top: 6rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.pa__loc-change { font-size: 24rpx; color: var(--func-warning); margin-left: 16rpx; flex-shrink: 0; }
.pa__loc-empty { font-size: 28rpx; color: var(--text-4); }

.pa__scenes { display: flex; flex-wrap: wrap; gap: 20rpx; }
.pa__scene {
  width: calc(33.33% - 14rpx); box-sizing: border-box;
  padding: 28rpx 12rpx; border-radius: 16rpx;
  background: var(--bg-segment); text-align: center;
  border: 2rpx solid transparent;
  transition: all .15s ease;
  position: relative;
}
.pa__scene.is-on {
  background: var(--func-warning-light); border-color: var(--func-warning);
}
.pa__scene-emoji { font-size: 52rpx; }
.pa__scene-name { font-size: 24rpx; color: var(--text-1); margin-top: 6rpx; }
.pa__scene-check {
  position: absolute; top: 8rpx; right: 12rpx;
  width: 36rpx; height: 36rpx; border-radius: 50%;
  background: var(--func-warning); color: var(--text-invert); font-size: 22rpx;
  display: flex; align-items: center; justify-content: center;
}

.pa__tips {
  margin-top: 32rpx; font-size: 24rpx; color: var(--text-5);
  padding: 0 12rpx;
}

.pa__submit {
  margin-top: 80rpx; background: var(--func-warning); color: var(--text-invert);
  border-radius: 48rpx; font-size: 32rpx; font-weight: 600;
  padding: 28rpx 0; border: none;
}
.pa__submit[disabled] { background: var(--btn-disabled-bg); color: var(--text-disabled); }
