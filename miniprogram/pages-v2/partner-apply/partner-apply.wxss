.pa { padding: 32rpx 28rpx 200rpx; }

.pa__hero {
  text-align: center;
  padding: 48rpx 0 40rpx;
}
.pa__hero-emoji { font-size: 96rpx; }
.pa__hero-title {
  font-size: 40rpx; font-weight: 700; color: var(--text-primary);
  margin-top: 8rpx;
}
.pa__hero-sub {
  font-size: 26rpx; color: var(--text-tertiary); margin-top: 12rpx;
}

.pa__card {
  background: #fff; border-radius: 20rpx; padding: 32rpx 28rpx;
  margin-top: 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.pa__card-title {
  font-size: 30rpx; font-weight: 600; color: var(--text-primary); margin-bottom: 24rpx;
}

.pa__scenes { display: flex; flex-wrap: wrap; gap: 20rpx; }
.pa__scene {
  width: calc(33.33% - 14rpx); box-sizing: border-box;
  padding: 28rpx 12rpx; border-radius: 16rpx;
  background: #F5F5F7; text-align: center;
  border: 2rpx solid transparent;
  transition: all .15s ease;
  position: relative;
}
.pa__scene.is-on {
  background: #FFF4E6; border-color: #FF9A3C;
}
.pa__scene-emoji { font-size: 52rpx; }
.pa__scene-name { font-size: 24rpx; color: var(--text-primary); margin-top: 6rpx; }
.pa__scene-check {
  position: absolute; top: 8rpx; right: 12rpx;
  width: 36rpx; height: 36rpx; border-radius: 50%;
  background: #FF9A3C; color: #fff; font-size: 22rpx;
  display: flex; align-items: center; justify-content: center;
}

.pa__tips {
  margin-top: 32rpx; font-size: 24rpx; color: var(--text-quaternary);
  padding: 0 12rpx;
}

.pa__submit {
  margin-top: 80rpx; background: #FF9A3C; color: #fff;
  border-radius: 48rpx; font-size: 32rpx; font-weight: 600;
  padding: 28rpx 0; border: none;
}
.pa__submit[disabled] { background: #D4A87A; color: #fff; }
