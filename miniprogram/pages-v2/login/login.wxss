.login {
  min-height: 100vh;
  background: var(--bg-page);
  /* 底部预留安全区，修复全面屏贴边 */
  padding: 0 48rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  /* 内容整体垂直居中，修复下半屏大片空白 */
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.login__brand {
  text-align: center;
}
.login__logo {
  width: 140rpx;
  height: 140rpx;
  margin: 0 auto;
  border-radius: 36rpx;
  background: var(--brand-primary-light);
  /* 品牌图标加同色光晕，暗底上更有"抬起来"的质感 */
  box-shadow: 0 16rpx 40rpx rgba(7, 193, 96, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-display-xxl);
}
.login__name {
  margin-top: 28rpx;
  font-size: var(--font-display-lg);
  font-weight: 700;
  color: var(--text-1);
}
.login__slogan {
  margin-top: 12rpx;
  font-size: var(--font-md);
  color: var(--text-4);
  letter-spacing: 4rpx;
}
.login__sells {
  margin-top: 48rpx;
  display: flex;
  justify-content: space-between;
  /* 卖点卡片化：四个徽标收成一块，视觉块面更清晰 */
  background: var(--bg-card);
  border: 2rpx solid var(--border-1);
  border-radius: 24rpx;
  padding: 24rpx 0;
}
.login__sell {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: var(--font-sm);
  color: var(--text-3);
  width: 25%;
}
/* 相邻卖点加竖向分割线 */
.login__sell + .login__sell {
  border-left: 2rpx solid var(--border-1);
}
.login__sell-ic {
  /* 统一 emoji 图标尺寸与行高，消除四个徽标体积不齐 */
  font-size: 48rpx;
  line-height: 1;
  margin-bottom: 12rpx;
}
.login__panel {
  margin-top: 48rpx;
}
/* 协议卡片化：三条协议独立成卡片容器，视觉上与卖点区区分 */
.login__agree-card {
  background: var(--bg-card);
  border: 2rpx solid var(--border-1);
  border-radius: 24rpx;
  padding: 4rpx 24rpx;
}
.login__agree-row {
  display: flex;
  align-items: center;
  /* 行内上下留白扩大触控区域（整行可点） */
  padding: 16rpx 0;
}
.login__agree-row + .login__agree-row {
  border-top: 2rpx solid var(--border-1);
}
.login__check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border-1);
  color: var(--text-invert);
  font-size: var(--font-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
  transition: background 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
}
.login__check.is-on {
  background: var(--brand-primary);
  border-color: var(--brand-primary);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.18);
}
.login__agree-text {
  font-size: var(--font-md);
  color: var(--func-info);
}
.login__btn {
  margin-top: 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: var(--brand-primary);
  color: var(--text-invert);
  font-size: var(--font-lg);
  font-weight: 600;
  /* 绿色渐变 + 同色投影，主按钮更有质感（禁用态会在后面覆盖为纯灰） */
  background: linear-gradient(135deg, var(--brand-primary) 0%, var(--brand-primary-press) 100%);
  box-shadow: 0 14rpx 34rpx rgba(7, 193, 96, 0.35);
}
.login__btn::after {
  border: none;
}
.login__btn.button-hover {
  background: var(--brand-primary-press);
}
.login__btn[disabled] {
  background: var(--btn-disabled-bg);
  color: var(--text-invert);
  /* 禁用态与可用态拉开对比 */
  opacity: 0.45;
  box-shadow: none;
}
.login__tip {
  margin-top: 20rpx;
  text-align: center;
  font-size: var(--font-xs);
  color: var(--text-5);
}
.login__foot {
  margin-top: 48rpx;
  text-align: center;
  font-size: var(--font-xs);
  color: var(--text-5);
  opacity: 0.8;
}
.login__reject {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-mask);
  z-index: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 56rpx;
}
.login__reject-card {
  width: 100%;
  background: var(--bg-card);
  border-radius: var(--r-xl);
  padding: 56rpx 40rpx 48rpx;
  text-align: center;
}
.login__reject-ic {
  font-size: var(--font-display-xxl);
}
.login__reject-title {
  margin-top: 20rpx;
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--text-1);
}
.login__reject-desc {
  margin-top: 16rpx;
  font-size: var(--font-sm);
  color: var(--text-3);
  line-height: 1.7;
}
.login__reject-btn {
  margin-top: 40rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  background: var(--brand-primary);
  color: var(--text-invert);
  font-size: var(--font-md);
}
.login__reject-btn::after {
  border: none;
}
/* ── Tab 切换 ── */
.login__tabs {
  display: flex;
  margin-top: 32rpx;
  background: var(--bg-card);
  border-radius: 12rpx;
  padding: 6rpx;
}
.login__tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: var(--font-md);
  color: var(--text-3);
  border-radius: 8rpx;
  transition: all 0.2s;
}
.login__tab.is-on {
  background: var(--brand-primary);
  color: var(--text-invert);
  font-weight: 600;
}

/* ── 表单 ── */
.login__form { margin-top: 32rpx; }
.login__field {
  background: var(--bg-card);
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}
.login__field--row { display: flex; align-items: stretch; }
.login__input {
  width: 100%;
  height: 88rpx;
  padding: 0 28rpx;
  font-size: var(--font-md);
  color: var(--text-1);
  background: transparent;
  box-sizing: border-box;
}
.login__input--flex { flex: 1; }
.login__ph { color: var(--text-5); font-size: var(--font-sm); }
.login__sms-btn {
  flex-shrink: 0;
  width: 200rpx;
  height: 88rpx;
  line-height: 88rpx;
  margin: 0;
  border-radius: 0;
  font-size: var(--font-sm);
  background: var(--brand-primary);
  color: var(--text-invert);
}
.login__sms-btn::after { border: none; }
.login__sms-btn[disabled] { background: var(--btn-disabled-bg); color: var(--text-invert); }
.login__btn--ghost {
  background: transparent;
  color: var(--brand-primary);
  border: 2rpx solid var(--brand-primary);
  margin-top: 16rpx;
}
.login__btn--ghost[disabled] {
  background: transparent;
  border-color: var(--border-1);
  color: var(--text-5);
}

/* ── 手机号一键/手输分隔 ── */
.login__divider {
  display: flex;
  align-items: center;
  margin: 40rpx 0 8rpx;
}
.login__divider::before,
.login__divider::after {
  content: '';
  flex: 1;
  height: 2rpx;
  background: var(--border-1);
}
.login__divider-tx {
  padding: 0 24rpx;
  font-size: var(--font-xs);
  color: var(--text-5);
}
.login__manual-toggle {
  text-align: center;
  font-size: var(--font-sm);
  color: var(--func-info);
  padding: 16rpx 0;
}
/* ── 账号密码辅助入口 ── */
.login__alt-link {
  margin-top: 32rpx;
  text-align: center;
  font-size: var(--font-sm);
  color: var(--text-4);
}
