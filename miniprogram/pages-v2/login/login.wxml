<view class="v2 login">
  <view style="height: {{statusBarHeight * 2}}rpx;"></view>

  <!-- L1 品牌区 -->
  <view class="login__brand">
    <view class="login__logo">🤝</view>
    <view class="login__name">找个人帮忙</view>
    <view class="login__slogan">安全第一 · 合规先行</view>
  </view>

  <!-- L2 卖点区 -->
  <view class="login__sells">
    <view class="login__sell"><text class="login__sell-ic">🛡</text><text>官方认证</text></view>
    <view class="login__sell"><text class="login__sell-ic">📋</text><text>保险兜底</text></view>
    <view class="login__sell"><text class="login__sell-ic">📍</text><text>零静默定位</text></view>
    <view class="login__sell"><text class="login__sell-ic">🔒</text><text>资金担保</text></view>
  </view>

  <!-- 协议 + 登录 -->
  <view class="login__panel">
    <view class="login__agree-row" wx:for="{{agreeItems}}" wx:key="key">
      <view class="login__check {{agreements[item.key] ? 'is-on' : ''}}" data-key="{{item.key}}" catchtap="toggleAgreement">{{agreements[item.key] ? '✓' : ''}}</view>
      <text class="login__agree-text" data-key="{{item.key}}" catchtap="openAgreement">{{item.label}}</text>
    </view>

    <!-- 登录方式切换: 微信一键 / 手机号一键 -->
    <view class="login__tabs">
      <view class="login__tab {{tab==='wechat' ? 'is-on' : ''}}" data-tab="wechat" catchtap="switchTab">微信一键登录</view>
      <view class="login__tab {{tab==='phone' ? 'is-on' : ''}}" data-tab="phone" catchtap="switchTab">手机号登录</view>
    </view>

    <!-- 方式一: 微信一键登录 -->
    <button wx:if="{{tab==='wechat'}}" class="login__btn" loading="{{logging}}" disabled="{{!allChecked || logging}}" bindtap="onLogin">
      微信一键登录
    </button>
    <view class="login__tip" wx:if="{{tab==='wechat'}}">登录即代表同意上述协议，未勾选协议无法登录</view>

    <!-- 方式二: 手机号登录 -->
    <view wx:if="{{tab==='phone'}}">
      <!-- 一键授权: 自动获取微信绑定的当前通信手机号 -->
      <button class="login__btn" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber"
              loading="{{phLogging}}" disabled="{{!allChecked || phLogging}}">
        一键获取本机手机号登录
      </button>

      <view class="login__divider"><text class="login__divider-tx">或</text></view>

      <!-- 切换手工输入 -->
      <view class="login__manual-toggle" bindtap="toggleManual">
        {{showManual ? '收起手输入口' : '使用其他手机号登录'}}
      </view>

      <!-- 手工输入手机号 + 短信验证码 -->
      <view wx:if="{{showManual}}" class="login__form">
        <view class="login__field">
          <input class="login__input" type="number" maxlength="11" placeholder="请输入手机号" placeholder-class="login__ph"
                 value="{{phone}}" bindinput="onPhoneInput"/>
        </view>
        <view class="login__field login__field--row">
          <input class="login__input login__input--flex" type="number" maxlength="6" placeholder="短信验证码" placeholder-class="login__ph"
                 value="{{smsCode}}" bindinput="onSmsInput"/>
          <button class="login__sms-btn" disabled="{{smsCountdown>0 || !phoneValid}}" bindtap="onSendSms">
            {{smsCountdown>0 ? smsCountdown+'s' : '获取验证码'}}
          </button>
        </view>
        <button class="login__btn" loading="{{phLogging}}" disabled="{{!allChecked || !phoneValid || !smsCodeValid || phLogging}}" bindtap="onPhoneLogin">
          手机号登录
        </button>
        <button class="login__btn login__btn--ghost" loading="{{phLogging}}" disabled="{{!allChecked || !phoneValid || !smsCodeValid || phLogging}}" bindtap="onPhoneRegister">
          新手机号快捷注册
        </button>
      </view>
    </view>

    <!-- 辅助: 账号密码(非主登录方式) -->
    <view wx:if="{{tab==='password'}}" class="login__form">
      <view class="login__field">
        <input class="login__input" maxlength="20" placeholder="账号(4-20位字母数字下划线)" placeholder-class="login__ph"
               value="{{loginAccount}}" bindinput="onAccountInput"/>
      </view>
      <view class="login__field">
        <input class="login__input" password="{{true}}" maxlength="32" placeholder="密码(6-32位)" placeholder-class="login__ph"
               value="{{loginPassword}}" bindinput="onPasswordInput"/>
      </view>
      <button class="login__btn" loading="{{pwLogging}}" disabled="{{!allChecked || !accountValid || !passwordValid || pwLogging}}" bindtap="onPasswordLogin">
        账号密码登录
      </button>
      <button class="login__btn login__btn--ghost" loading="{{pwLogging}}" disabled="{{!allChecked || !accountValid || !passwordValid || pwLogging}}" bindtap="onPasswordRegister">
        还没账号？设置密码
      </view>
      <view class="login__tip">注册密码前需先微信登录建号</view>
      <view class="login__alt-link" data-tab="wechat" catchtap="switchTab">← 返回微信登录</view>
    </view>

    <!-- 账号密码辅助入口 -->
    <view wx:if="{{tab!=='password'}}" class="login__alt-link" data-tab="password" catchtap="switchTab">账号密码登录</view>
  </view>

  <!-- R5 年龄不足拦截页 -->
  <view class="login__reject" wx:if="{{rejected}}">
    <view class="login__reject-card">
      <view class="login__reject-ic">🚫</view>
      <view class="login__reject-title">暂无法提供服务</view>
      <view class="login__reject-desc">{{rejectReason}}</view>
      <button class="login__reject-btn" bindtap="backReject" hover-class="btn-press">返回</button>
    </view>
  </view>

  <!-- 🔧 内测辅助: 短信验证码 mock 工具(Phase 1.4, 上线移除) -->
  <view class="login__debug" bindtap="onDebugSms">🔧 内测工具: 获取短信验证码</view>

  <night-mask visible="{{isRedline}}" bind:reserve="onReserve"></night-mask>
</view>
