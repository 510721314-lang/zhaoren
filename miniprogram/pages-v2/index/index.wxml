<view class="v2 home">
  <!-- H1 导航：问候语 + 城市 + 铃铛 -->
  <view class="home__nav" style="padding-top: {{statusBarHeight + 6}}px;">
    <view class="home__hello">{{greeting}}，需要什么帮忙？</view>
    <view class="home__nav-right">
      <view class="home__city" bindtap="onCityTap">📍 {{city}}<text class="home__city-arrow">⌄</text></view>
      <view class="home__bell" bindtap="onBellTap">
        🔔
        <text class="home__bell-badge" wx:if="{{user.unread_notice}}">{{user.unread_notice}}</text>
      </view>
    </view>
  </view>

  <!-- H1b 场景/服务搜索 -->
  <view class="home__searchbar">
    <text class="home__search-ic">🔍</text>
    <input
      class="home__search-input"
      value="{{searchKey}}"
      placeholder="搜索服务 / 场景"
      placeholder-class="home__search-ph"
      confirm-type="search"
      bindinput="onSearchInput"
      bindconfirm="onSearchConfirm"
    />
    <text class="home__search-x" wx:if="{{searchKey}}" bindtap="onSearchClear">×</text>
  </view>

  <!-- H2 卖点条 -->
  <safe-sell-bar></safe-sell-bar>

  <!-- H2b 运营 Banner 轮播（后台 home_activity 管理，0-N 张，可空） -->
  <view class="home__banner-wrap" wx:if="{{banners.length}}">
    <swiper class="home__banner" indicator-dots autoplay circular interval="4000" indicator-color="rgba(255,255,255,0.5)" indicator-active-color="#fff">
      <swiper-item wx:for="{{banners}}" wx:key="id" data-idx="{{index}}" bindtap="onActivityTap">
        <image class="home__banner-img" src="{{item.banner_image}}" mode="aspectFill" lazy-load="{{true}}"></image>
        <view class="home__banner-text">
          <view class="home__banner-title">{{item.title}}</view>
          <view wx:if="{{item.subtitle}}" class="home__banner-sub">{{item.subtitle}}</view>
        </view>
      </swiper-item>
    </swiper>
  </view>

  <!-- H3 紧急联系人未确认提醒（可关闭不阻断） -->
  <view class="home__emergency" wx:if="{{showEmergency && unconfirmedContact}}">
    <text class="home__emergency-text">您的紧急联系人「{{unconfirmedContact.name}}」尚未完成确认</text>
    <view class="home__emergency-actions">
      <text class="home__emergency-go" catchtap="onEmergencyConfirm">去确认 ›</text>
      <text class="home__emergency-x" catchtap="onEmergencyClose">×</text>
    </view>
  </view>

  <!-- H4 场景宫格（搜索实时过滤） -->
  <view class="home__grid" wx:if="{{!loading && filteredScenes.length > 0}}">
    <view class="home__cell" wx:for="{{filteredScenes}}" wx:key="code" data-code="{{item.code}}" bindtap="onSceneTap">
      <view class="home__gb-badge" wx:if="{{item.gb}}">国标</view>
      <view class="home__cell-ic" style="background:{{item.color}};">{{item.icon}}</view>
      <view class="home__cell-name">{{item.name}}</view>
    </view>
  </view>
  <view class="home__search-empty" wx:elif="{{!loading}}">
    <view>未找到与「{{searchKey}}」相关的场景</view>
    <view class="home__search-empty-sub">试试：陪诊 / 学习 / 生活协助 / 出行 / 线上</view>
  </view>

  <!-- 骨架屏: 场景宫格 + 需求卡片 -->
  <view class="home__skeleton" wx:if="{{loading}}">
    <view class="home__sk-grid">
      <view class="home__sk-cell" wx:for="{{[1,2,3,4,5,6,7,8]}}" wx:key="*this">
        <view class="skeleton sk-circle" style="width:72rpx;height:72rpx;"></view>
        <view class="skeleton sk-line-sm" style="width:60rpx;margin:12rpx auto 0;"></view>
      </view>
    </view>
    <view class="skeleton sk-card" style="height:180rpx;margin-top:24rpx;"></view>
    <view class="skeleton sk-card" style="height:180rpx;"></view>
  </view>

  <!-- H5 新人福利 -->
  <view class="home__welfare" wx:if="{{showWelfare && user.new_user && !user.first_order_used}}" bindtap="onWelfareReceive">
    <view>
      <view class="home__welfare-title">{{welfare.welfareTitle}}</view>
      <view class="home__welfare-sub">{{welfare.welfareSub}}</view>
    </view>
    <view class="home__welfare-btn">领取</view>
  </view>

  <!-- H5b 活跃耍伴(图4): 横滑头像+昵称+信用分胶囊 -->
  <view class="home__active-card" wx:if="{{activePartners.length > 0}}">
    <view class="home__active-title"><text class="home__title-bar"></text>⭐ 活跃耍伴</view>
    <scroll-view scroll-x class="home__active-scroll" enhanced show-scrollbar="{{false}}">
      <view class="home__active-item" wx:for="{{activePartners}}" wx:key="openid" data-openid="{{item.openid}}" bindtap="onActivePartnerTap">
        <image wx:if="{{item.avatar}}" class="home__active-avatar" src="{{item.avatar}}" mode="aspectFill" lazy-load></image>
        <view wx:else class="home__active-avatar home__active-avatar--ph">👤</view>
        <view class="home__active-name">{{item.nickname}}</view>
        <view class="home__active-score" wx:if="{{item.partner_credit_score > 0}}">{{item.partner_credit_score}}分</view>
      </view>
    </scroll-view>
  </view>

  <!-- H6 内容Tab -->
  <view class="home__tabs">
    <view class="home__tab {{activeTab === 'demand' ? 'is-on' : ''}}" data-tab="demand" bindtap="switchTab">🔥 需求广场</view>
    <view class="home__tab {{activeTab === 'partner' ? 'is-on' : ''}}" data-tab="partner" bindtap="switchTab">⭐ 耍伴推荐</view>
  </view>

  <!-- H7a 需求列表(按场景分组, 每场景8条 + 更多) -->
  <block wx:if="{{!loading && activeTab === 'demand'}}">
    <view class="home__scene-group" wx:for="{{sceneGroups}}" wx:for-item="group" wx:key="scene_code">
      <view class="home__scene-head">
        <view class="home__scene-bar"></view>
        <text class="home__scene-title">{{group.scene_name}}</text>
        <text class="home__scene-count">{{group.list.length}} 条</text>
      </view>
      <block wx:if="{{group.list.length > 0}}">
        <view class="fade-in-up" style="animation-delay:{{index * 0.05}}s;" wx:for="{{group.list}}" wx:for-item="demand" wx:key="_id">
          <demand-card
            demand="{{demand}}"
            role="user"
            bind:cardtap="onDemandTap"
            bind:action="onDemandTap"
          ></demand-card>
        </view>
      </block>
      <view wx:else class="home__scene-empty">暂无匹配需求 · 点我去发布</view>
      <view
        wx:if="{{group.has_more}}"
        class="home__scene-more-btn"
        data-code="{{group.scene_code}}"
        data-name="{{group.scene_name}}"
        bindtap="onSceneMoreTap"
      >查看更多{{group.scene_name}}需求 ›</view>
    </view>
    <empty-state wx:if="{{sceneGroups.length === 0}}" icon="📋" title="当前暂无匹配需求" desc="可试试其他场景，或预约下单享{{reserveDiscountText}}" btnText="去发布"></empty-state>
  </block>

  <!-- H7b 耍伴列表 -->
  <block wx:else>
    <view class="home__list">
      <view class="fade-in-up" style="animation-delay:{{index * 0.05}}s;" wx:for="{{partnerList}}" wx:key="_id">
        <partner-card
          partner="{{item}}"
          bind:cardtap="onPartnerTap"
          bind:invite="onPartnerTap"
          bind:more="onPartnerTap"
        ></partner-card>
      </view>
      <view class="home__partner-tip">下拉加载更多高信用耍伴 · 新耍伴前{{trafficOrders}}单享流量扶持</view>
    </view>
  </block>

  <!-- 附近可接单池(仅耍伴端): 页面最底部, 按发布时间倒序展示前10条, 更多跳附近列表页; 复用 demand-card -->
  <view class="home__near" wx:if="{{!loading && isPartner}}">
    <view class="home__near-head">
      <text class="home__title-bar"></text>
      <text class="home__near-title">📍 附近可接</text>
      <view class="home__near-more" hover-class="home__near-more--hover" bindtap="onNearbyMoreTap">更多 ›</view>
    </view>
    <block wx:if="{{nearbyList.length > 0}}">
      <view class="fade-in-up" style="animation-delay:{{index * 0.05}}s;" wx:for="{{nearbyList}}" wx:key="_id">
        <demand-card
          demand="{{item}}"
          role="partner"
          bind:cardtap="onDemandTap"
          bind:action="onDemandTap"
        ></demand-card>
      </view>
    </block>
    <view wx:else class="home__near-empty">附近暂无可接需求</view>
  </view>

  <!-- H8 页脚 -->
  <view class="home__footer">—— 全场景 {{redlineClose}}-{{redlineOpen}} 暂停预约与履约 ——</view>

  <!-- H9 右侧浮动功能组(收藏/分享/客服) -->
  <view class="home__float">
    <view class="home__float-btn">
      <button class="home__float-inner" hover-class="home__float-inner--hover" bindtap="onFloatFavorite" aria-label="收藏">
        <text class="home__float-ic">{{favorited ? '★' : '☆'}}</text>
      </button>
    </view>
    <view class="home__float-btn">
      <button class="home__float-inner" hover-class="home__float-inner--hover" open-type="share" aria-label="分享">
        <text class="home__float-ic">↗</text>
      </button>
    </view>
    <view class="home__float-btn">
      <button class="home__float-inner" hover-class="home__float-inner--hover" open-type="contact" aria-label="客服">
        <text class="home__float-ic home__float-ic--cs"></text>
      </button>
    </view>
  </view>

  <night-mask visible="{{isRedline}}" bind:reserve="onReserve"></night-mask>
</view>
