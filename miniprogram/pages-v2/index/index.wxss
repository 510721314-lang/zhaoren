.home {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 160rpx;
}

/* H1 */
.home__nav {
  background: var(--bg-card);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 24rpx 14rpx;
  gap: 16rpx;
}
.home__hello {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-1);
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.home__nav-right {
  display: flex;
  align-items: center;
  gap: 18rpx;
  flex-shrink: 0;
}
.home__city {
  font-size: var(--font-md);
  color: var(--text-3);
}
.home__city-arrow {
  font-size: var(--font-xs);
  color: var(--text-5);
  margin-left: 2rpx;
}

/* H1b 搜索栏 */
.home__searchbar {
  background: var(--bg-card);
  margin: 0 20rpx;
  height: 84rpx;
  border-radius: 42rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  background: var(--bg-segment);
}
.home__search-input {
  flex: 1;
  height: 84rpx;
  margin-left: 12rpx;
  font-size: var(--font-md);
  color: var(--text-1);
}
.home__search-ic {
  flex-shrink: 0;
}
.home__search-ph {
  color: var(--text-5);
}
.home__search-x {
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--text-disabled);
  color: #fff;
  font-size: var(--font-lg);
  flex-shrink: 0;
}
.home__search-empty {
  margin: 20rpx;
  background: var(--bg-card);
  border-radius: var(--r-lg);
  padding: 48rpx 24rpx;
  text-align: center;
  color: var(--text-4);
  font-size: var(--font-md);
}
.home__search-empty-sub {
  margin-top: 14rpx;
  font-size: var(--font-sm);
  color: var(--text-disabled);
}
.home__bell {
  position: relative;
  font-size: var(--font-display);
  padding: 0 8rpx;
}
.home__bell-badge {
  position: absolute;
  top: -6rpx;
  right: -10rpx;
  background: var(--func-danger);
  color: var(--text-invert);
  font-size: var(--font-xs);
  line-height: 1.4;
  border-radius: 14rpx;
  padding: 0 8rpx;
}

/* H3 */
.home__emergency {
  margin: 20rpx 20rpx 0;
  background: var(--bg-card);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-float);
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.home__emergency-text {
  font-size: var(--font-sm);
  color: var(--text-2);
}
.home__emergency-actions {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
.home__emergency-go {
  font-size: var(--font-sm);
  color: var(--brand-primary);
  font-weight: 600;
}
.home__emergency-x {
  margin-left: 20rpx;
  font-size: var(--font-xxl);
  color: var(--text-5);
  line-height: 1;
}

/* H4 宫格 */
.home__grid {
  margin: 20rpx 20rpx 0;
  background: var(--bg-card);
  border-radius: var(--r-lg);
  padding: 28rpx 12rpx 20rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  row-gap: 28rpx;
}
.home__cell {
  text-align: center;
  position: relative;
}
.home__cell-ic {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  margin: 0 auto 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-display-lg);
}
.home__cell-name {
  font-size: var(--font-sm);
  color: var(--text-2);
}
.home__cell--gray .home__cell-ic {
  background: var(--cell-gray-bg);
}
.home__cell--gray .home__cell-name {
  color: var(--text-disabled);
}
.home__gb-badge {
  position: absolute;
  top: -12rpx;
  right: 24rpx;
  background: var(--brand-accent);
  color: var(--text-invert);
  font-size: var(--font-xs);
  line-height: 1.5;
  padding: 0 8rpx;
  border-radius: 8rpx;
}

/* H5 */
.home__welfare {
  margin: 20rpx 20rpx 0;
  background: linear-gradient(90deg, var(--banner-grad-start), var(--banner-grad-end));
  border-radius: var(--r-md);
  padding: 20rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.home__welfare-title {
  font-size: var(--font-md);
  color: var(--text-aa);
  font-weight: 600;
}
.home__welfare-sub {
  margin-top: 4rpx;
  font-size: var(--font-xs);
  color: var(--text-banner-sub);
}
.home__welfare-btn {
  background: var(--func-warning);
  color: var(--text-invert);
  font-size: var(--font-sm);
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
  flex-shrink: 0;
}

/* H6 */
/* H5b/H5c 活跃用户 / 活跃耍伴(图4) */
.home__active-card {
  margin: 20rpx 20rpx 0;
  background: var(--bg-card);
  border-radius: var(--r-lg);
  padding: 24rpx 24rpx 26rpx;
  box-shadow: var(--shadow-card);
}
.home__active-title {
  display: flex;
  align-items: center;
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 20rpx;
}
.home__title-bar {
  display: inline-block;
  width: 8rpx;
  height: 32rpx;
  border-radius: 4rpx;
  background: var(--brand-primary);
  margin-right: 12rpx;
}
.home__active-scroll {
  width: 100%;
  white-space: nowrap;
}
.home__active-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 132rpx;
  margin-right: 8rpx;
  vertical-align: top;
}
.home__active-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--bg-segment);
  border: 4rpx solid #f1f3f5;
}
.home__active-avatar--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  line-height: 1;
}
.home__active-name {
  margin-top: 12rpx;
  max-width: 124rpx;
  font-size: var(--font-xs);
  color: var(--text-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.home__active-score {
  margin-top: 8rpx;
  padding: 2rpx 14rpx;
  border-radius: 20rpx;
  background: #fff3e6;
  color: #e08a1e;
  font-size: var(--font-xs);
  line-height: 1.6;
}

.home__tabs {
  display: flex;
  padding: 28rpx 32rpx 16rpx;
}
.home__tab {
  position: relative;
  margin-right: 48rpx;
  font-size: var(--font-xl);
  color: var(--text-5);
}
.home__tab.is-on {
  color: var(--brand-primary);
  font-weight: 700;
}
.home__tab.is-on::after {
  content: '';
  position: absolute;
  left: 20%;
  right: 20%;
  bottom: -12rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--brand-primary);
}

/* H7 */
.home__list {
  padding: 12rpx 20rpx 0;
}

/* H7a 需求广场按场景分组 */
.home__scene-group {
  padding: 16rpx 20rpx 0;
}
.home__scene-head {
  display: flex;
  align-items: center;
  padding: 8rpx 4rpx 16rpx;
}
.home__scene-bar {
  width: 8rpx;
  height: 32rpx;
  border-radius: 4rpx;
  background: var(--brand-primary);
  margin-right: 14rpx;
}
.home__scene-title {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--text-1);
}
.home__scene-count {
  margin-left: auto;
  font-size: var(--font-xs);
  color: var(--text-4);
}
.home__scene-more-btn {
  margin: 20rpx 0 8rpx;
  height: 80rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 40rpx;
  background: var(--brand-primary-light);
  color: var(--brand-primary);
  font-size: var(--font-md);
  font-weight: 600;
  border: 2rpx solid var(--brand-primary);
}
.home__scene-more-btn:active {
  opacity: 0.75;
}
.home__scene-empty {
  padding: 16rpx 20rpx;
  font-size: var(--font-xs);
  color: var(--text-disabled);
  text-align: center;
  background: var(--bg-segment);
  border-radius: var(--r-md);
  margin-bottom: 12rpx;
}
.home__partner-tip {
  text-align: center;
  font-size: var(--font-xs);
  color: var(--text-disabled);
  padding: 8rpx 0 0;
}

/* H8 */
.home__footer {
  text-align: center;
  font-size: var(--font-xs);
  color: var(--text-disabled);
  padding: 12rpx 0 24rpx;
}
