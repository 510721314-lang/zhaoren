.home {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 160rpx;
}

/* H1 */
.home__nav {
  background: var(--bg-card);
  display: flex;
  align-items: center;
  padding: 6rpx 20rpx 16rpx;
  gap: 16rpx;
}
.home__city {
  font-size: var(--font-xl);
  font-weight: 600;
  color: var(--text-1);
  flex-shrink: 0;
}
.home__city-arrow {
  font-size: var(--font-xs);
  color: var(--text-5);
  margin-left: 2rpx;
}
.home__search {
  flex: 1;
  height: 60rpx;
  background: var(--bg-segment);
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  font-size: var(--font-sm);
  color: var(--text-5);
}
.home__search-ic {
  margin-right: 8rpx;
}
.home__bell {
  position: relative;
  font-size: var(--font-display);
  padding: 0 8rpx;
}
.home__bell-badge {
  position: absolute;
  top: -6rpx;
  right: -10rpx;
  background: var(--func-danger);
  color: var(--text-invert);
  font-size: var(--font-xs);
  line-height: 1.4;
  border-radius: 14rpx;
  padding: 0 8rpx;
}

/* H3 */
.home__emergency {
  margin: 20rpx 20rpx 0;
  background: var(--bg-card);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-float);
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.home__emergency-text {
  font-size: var(--font-sm);
  color: var(--text-2);
}
.home__emergency-actions {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
.home__emergency-go {
  font-size: var(--font-sm);
  color: var(--brand-primary);
  font-weight: 600;
}
.home__emergency-x {
  margin-left: 20rpx;
  font-size: var(--font-xxl);
  color: var(--text-5);
  line-height: 1;
}

/* H4 宫格 */
.home__grid {
  margin: 20rpx 20rpx 0;
  background: var(--bg-card);
  border-radius: var(--r-lg);
  padding: 28rpx 12rpx 20rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  row-gap: 28rpx;
}
.home__cell {
  text-align: center;
  position: relative;
}
.home__cell-ic {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  margin: 0 auto 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-display-lg);
}
.home__cell-name {
  font-size: var(--font-sm);
  color: var(--text-2);
}
.home__cell--gray .home__cell-ic {
  background: var(--cell-gray-bg);
}
.home__cell--gray .home__cell-name {
  color: var(--text-disabled);
}
.home__gb-badge {
  position: absolute;
  top: -12rpx;
  right: 24rpx;
  background: var(--brand-accent);
  color: var(--text-invert);
  font-size: var(--font-xs);
  line-height: 1.5;
  padding: 0 8rpx;
  border-radius: 8rpx;
}

/* H5 */
.home__welfare {
  margin: 20rpx 20rpx 0;
  background: linear-gradient(90deg, var(--banner-grad-start), var(--banner-grad-end));
  border-radius: var(--r-md);
  padding: 20rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.home__welfare-title {
  font-size: var(--font-md);
  color: var(--text-aa);
  font-weight: 600;
}
.home__welfare-sub {
  margin-top: 4rpx;
  font-size: var(--font-xs);
  color: var(--text-banner-sub);
}
.home__welfare-btn {
  background: var(--func-warning);
  color: var(--text-invert);
  font-size: var(--font-sm);
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
  flex-shrink: 0;
}

/* H6 */
.home__tabs {
  display: flex;
  padding: 28rpx 32rpx 16rpx;
}
.home__tab {
  position: relative;
  margin-right: 48rpx;
  font-size: var(--font-xl);
  color: var(--text-5);
}
.home__tab.is-on {
  color: var(--brand-primary);
  font-weight: 700;
}
.home__tab.is-on::after {
  content: '';
  position: absolute;
  left: 20%;
  right: 20%;
  bottom: -12rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--brand-primary);
}

/* H7 */
.home__list {
  padding: 12rpx 20rpx 0;
}
.home__partner-tip {
  text-align: center;
  font-size: var(--font-xs);
  color: var(--text-disabled);
  padding: 8rpx 0 0;
}

/* H8 */
.home__footer {
  text-align: center;
  font-size: var(--font-xs);
  color: var(--text-disabled);
  padding: 12rpx 0 24rpx;
}
