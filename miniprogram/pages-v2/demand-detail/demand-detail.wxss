.dd {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 0 20rpx 180rpx;
}
.dd__body {
  padding-top: 20rpx;
}
.dd__card {
  background: var(--bg-card);
  border-radius: var(--r-lg);
  padding: 24rpx 28rpx;
  box-shadow: var(--shadow-card);
  margin-bottom: 20rpx;
}
.dd__tags {
  display: flex;
  flex-wrap: wrap;
}
.dd__title {
  margin-top: 12rpx;
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--text-1);
  line-height: 1.4;
}
.dd__direct-tag {
  margin-top: 12rpx;
  display: inline-block;
  background: #fff6ec;
  color: #c87a2c;
  border: 1rpx solid #f3d4ad;
  border-radius: var(--r-sm);
  padding: 8rpx 16rpx;
  font-size: var(--font-xs);
  font-weight: 600;
}
.dd__desc {
  margin-top: 12rpx;
  font-size: var(--font-md);
  color: var(--text-3);
  line-height: 1.7;
}
.dd__info-grid {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx 0;
}
.dd__info-item {
  width: 50%;
  display: flex;
  align-items: center;
}
.dd__info-label {
  font-size: var(--font-sm);
  color: var(--text-4);
  width: 100rpx;
  flex-shrink: 0;
}
.dd__info-val {
  font-size: var(--font-sm);
  color: var(--text-1);
}
.dd__pub-row {
  display: flex;
  align-items: center;
}
.dd__pub-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--avatar-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-xxl);
}
.dd__pub-info {
  margin-left: 16rpx;
}
.dd__pub-name {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-1);
}
.dd__pub-verified {
  font-size: var(--font-xs);
  color: var(--func-success);
  margin-left: 6rpx;
}
.dd__pub-time {
  margin-top: 4rpx;
  font-size: var(--font-xs);
  color: var(--text-5);
}
.dd__section-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text-1);
  margin: 8rpx 0 16rpx;
}
.dd__partner-scroll {
  white-space: nowrap;
}
.dd__partner-item {
  display: inline-block;
  width: 600rpx;
  margin-right: 20rpx;
  vertical-align: top;
}
.dd__bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--bg-card);
  border-top: 1rpx solid var(--border-2);
  display: flex;
  align-items: center;
  gap: 20rpx;
  z-index: 100;
}
.dd__grab-info {
  flex: 1;
}
.dd__grab-price {
  font-size: var(--font-xxl);
  font-weight: 700;
  color: var(--func-danger);
}
.dd__grab-unit {
  font-size: var(--font-sm);
  color: var(--text-4);
  font-weight: 400;
}
.dd__btn {
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: var(--font-md);
  margin: 0;
  padding: 0 40rpx;
}
.dd__btn::after {
  border: none;
}
.dd__btn--ghost {
  background: var(--bg-card);
  color: var(--text-3);
  border: 1rpx solid var(--border-ghost);
}
.dd__btn--primary {
  background: var(--brand-primary);
  color: var(--text-invert);
  font-weight: 600;
}
.dd__btn--danger {
  background: var(--func-danger);
  color: var(--text-invert);
  font-weight: 600;
}
.dd__btn--disabled {
  background: var(--bg-segment);
  color: var(--text-4);
  font-size: var(--font-sm);
}
.dd__grab-title {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--text-1);
  text-align: center;
}
.dd__grab-desc {
  margin-top: 16rpx;
  font-size: var(--font-md);
  color: var(--text-1);
  text-align: center;
}
.dd__grab-meta {
  margin-top: 8rpx;
  font-size: var(--font-sm);
  color: var(--text-4);
  text-align: center;
}
.dd__grab-tip {
  margin-top: 20rpx;
  background: var(--func-warning-light);
  color: var(--text-aa);
  font-size: var(--font-sm);
  line-height: 1.7;
  border-radius: var(--r-sm);
  padding: 16rpx 20rpx;
}
.dd__grab-btns {
  display: flex;
  gap: 20rpx;
}
.dd__grab-btns .dd__btn {
  flex: 1;
}

/* 三态骨架屏 */
.dd__loading { padding: 16rpx; }
.dd__skeleton { height: 120rpx; background: var(--bg-segment); border-radius: var(--r-md); margin-bottom: 16rpx; animation: dd-skeleton-pulse 1.2s ease-in-out infinite; }
@keyframes dd-skeleton-pulse { 0%,100% { opacity: 0.5; } 50% { opacity: 1; } }
