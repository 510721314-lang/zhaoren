/* @VERIFIED 2026-11-27 已真机验证：token 收敛（服务卡封面占位字色 #fff→var(--text-invert)），浅色零变化/暗色跟随，iOS+Android 无异常，体验版 v1.6.33 */
page { background: var(--bg-page); }
.service { min-height: 100vh; padding-bottom: 40rpx; }

.svc__grid {
  background: var(--bg-card);
  padding: 20rpx 12rpx 16rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  row-gap: 20rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}
.svc__cell {
  text-align: center;
}
.svc__cell-ic {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  margin: 0 auto 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  border: 2rpx solid transparent;
}
.svc__cell-name {
  font-size: var(--font-sm);
  color: var(--text-2);
}
.svc__cell.is-on .svc__cell-ic {
  border-color: var(--brand-primary);
}
.svc__cell.is-on .svc__cell-name {
  color: var(--brand-primary);
  font-weight: 600;
}

.svc__list { padding: 20rpx; }
.svc__card {
  display: flex;
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.svc__card-cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: var(--brand-primary-light);
}
.svc__card-cover--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  color: var(--brand-primary);
}
.svc__card-body {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}
.svc__card-name {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text-1);
}
.svc__card-brief {
  font-size: var(--font-sm);
  color: var(--text-3);
  margin-top: 8rpx;
  line-height: 1.5;
}
.svc__card-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}
.svc__card-scene {
  font-size: var(--font-xs);
  color: var(--brand-primary);
  background: var(--brand-primary-light);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}
.svc__card-arrow {
  font-size: var(--font-xs);
  color: var(--text-4);
}

.svc__loading {
  text-align: center;
  padding: 80rpx 0;
  color: var(--text-4);
  font-size: var(--font-sm);
}

/* ── 搜索栏：前端过滤已加载 list ── */
.svc__search {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  margin: 16rpx 20rpx 0;
  padding: 18rpx 24rpx;
  border-radius: 40rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.svc__search-ic { font-size: 28rpx; margin-right: 12rpx; opacity: .55; }
.svc__search-input { flex: 1; font-size: var(--font-sm); color: var(--text-1); }

/* ── 全部服务 section header ── */
.svc__section-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 24rpx 24rpx 8rpx;
}
.svc__section-title { font-size: var(--font-md); font-weight: 600; color: var(--text-1); }
.svc__section-sub { font-size: var(--font-xs); color: var(--text-4); }

/* 宫格图标卡：加阴影更卡片化（底色保留 item.color 淡彩） */
.svc__cell-ic { box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05); }

/* ── 服务卡：左侧封面区 + 底部标签 + 副标题/分割线/双入口 ── */
.svc__card-cover-wrap { position: relative; width: 180rpx; flex-shrink: 0; }
.svc__card-cover { width: 180rpx; height: 180rpx; }
.svc__card-cover--ph {
  background: linear-gradient(135deg, #07C160 0%, #06AD56 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  color: var(--text-invert);
}
.svc__card-cover-tag {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  text-align: center;
  font-size: 20rpx;
  color: var(--brand-primary);
  background: rgba(255, 255, 255, 0.92);
  border-radius: 0 0 16rpx 16rpx;
  padding: 6rpx 0;
}
.svc__card-sub {
  font-size: var(--font-xs);
  color: var(--brand-primary);
  margin-top: 4rpx;
  font-weight: 500;
}
.svc__card-divider {
  height: 1rpx;
  background: var(--border-divider);
  margin: 12rpx 0;
}
.svc__card-range {
  font-size: var(--font-xs);
  color: var(--brand-primary);
}
