/* app.wxss - 全局样式 · 找人帮忙 小程序
   主题色:主 #D4875A(赭橙) / 辅 #1A2330(墨蓝) / 成功 #3E7C4F / 警示 #A8652A / 危险 #B03A2E
*/
page {
  --primary: #D4875A;
  --secondary: #1A2330;
  --success: #3E7C4F;
  --warning: #A8652A;
  --danger: #B03A2E;
  --text-1: #1A2330;
  --text-2: #6B7280;
  --text-3: #9CA3AF;
  --bg-page: #F5F5F5;
  --bg-card: #FFFFFF;
  --border: #E5E7EB;
  /* 间距体系 */
  --gap-xs: 8rpx;
  --gap-sm: 16rpx;
  --gap-md: 24rpx;
  --gap-lg: 32rpx;
  /* 过渡 */
  --transition: 0.2s ease;
  background: var(--bg-page);
  color: var(--text-1);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

view, text, image, navigator, scroll-view, swiper { box-sizing: border-box; }

.container { padding: 24rpx; }

/* 卡片 */
.card {
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: var(--gap-md);
  margin-bottom: var(--gap-md);
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06);
}

/* 主按钮 */
.btn-primary {
  background: var(--primary);
  color: #fff;
  border: none;
  padding: 20rpx 40rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  text-align: center;
  transition: var(--transition);
}
.btn-primary::after { border: none; }
.btn-primary:active { transform: scale(0.97); opacity: 0.9; }
.btn-primary[disabled] { background: #E8C9B0; color: #fff; }

/* 幽灵按钮 */
.btn-ghost {
  background: transparent;
  color: var(--primary);
  border: 2rpx solid var(--primary);
  padding: 18rpx 38rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  text-align: center;
  transition: var(--transition);
}
.btn-ghost::after { border: none; }
.btn-ghost:active { transform: scale(0.97); background: rgba(212,135,90,0.06); }

/* 危险按钮 */
.btn-danger {
  background: var(--danger);
  color: #fff;
  border: none;
  padding: 20rpx 40rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  text-align: center;
  transition: var(--transition);
}
.btn-danger::after { border: none; }
.btn-danger:active { transform: scale(0.97); opacity: 0.9; }

/* 状态标签基础类 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-right: 8rpx;
}
.tag-primary { background: #F5E6DA; color: var(--primary); }
.tag-success { background: #D9EBDF; color: var(--success); }
.tag-warn { background: #F5E6D2; color: var(--warning); }
.tag-danger { background: #F5DAD5; color: var(--danger); }

/* 迷你按钮(卡片内小操作) */
.mini-btn {
  font-size: 24rpx; color: var(--primary);
  padding: 8rpx 24rpx; border-radius: 999rpx;
  background: #FBF1E9; transition: var(--transition);
}
.mini-btn:active { transform: scale(0.95); opacity: 0.85; }

/* 通用文本 */
.title-lg { font-size: 40rpx; font-weight: 600; color: var(--text-1); }
.title-md { font-size: 32rpx; font-weight: 600; color: var(--text-1); }
.title-sm { font-size: 28rpx; font-weight: 500; color: var(--text-1); }
.text-muted { color: var(--text-2); font-size: 26rpx; }

/* 通用布局 */
.flex-row { display: flex; flex-direction: row; align-items: center; }
.flex-between { display: flex; justify-content: space-between; align-items: center; }
.flex-center { display: flex; justify-content: center; align-items: center; }
.btn-block { display: block; width: 100%; }
.safe-bottom { padding-bottom: calc(env(safe-area-inset-bottom) + 20rpx); }

/* ═══════ 骨架屏(shimmer 动画, 替代文字"加载中") ═══════ */
@keyframes skeleton-shimmer {
  0% { background-position: -468rpx 0; }
  100% { background-position: 468rpx 0; }
}
.skeleton {
  background: linear-gradient(90deg, #F0F0F0 25%, #F8F8F8 50%, #F0F0F0 75%);
  background-size: 936rpx 100%;
  animation: skeleton-shimmer 1.4s ease infinite;
  border-radius: 8rpx;
}
/* 骨架块形状 */
.sk-line { height: 28rpx; margin-bottom: 12rpx; }
.sk-line-sm { height: 22rpx; width: 60%; margin-bottom: 12rpx; }
.sk-circle { width: 80rpx; height: 80rpx; border-radius: 50%; flex-shrink: 0; }
.sk-card { height: 200rpx; margin-bottom: 24rpx; border-radius: 20rpx; }
.sk-row { display: flex; align-items: center; margin-bottom: 24rpx; }

/* ═══════ 统一空状态(各页复用, 删冗余) ═══════ */
.empty-state {
  text-align: center;
  padding: 120rpx 48rpx;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}
.empty-text {
  font-size: 28rpx;
  color: var(--text-2);
}
.empty-sub {
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 12rpx;
  line-height: 1.6;
}
.empty-btn {
  margin-top: 32rpx;
  display: inline-block;
}

/* ═══════ 统一加载提示 ═══════ */
.loading-tip {
  text-align: center;
  color: var(--text-3);
  font-size: 26rpx;
  padding: 80rpx 0;
}
