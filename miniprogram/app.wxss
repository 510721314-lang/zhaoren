@import "./styles/tokens.wxss";
/* app.wxss - 全局样式 · 找人帮忙 小程序
   主题色:主 #D4875A(赭橙) / 辅 #1A2330(墨蓝) / 成功 #3E7C4F / 警示 #A8652A / 危险 #B03A2E
   V15.1 新页面（pages-v2）变量与工具类见 styles/tokens.wxss（.v2 作用域，不污染旧页）
*/
page {
  --primary: #D4875A;
  --primary-light: #F5E6DA;
  --primary-lighter: #FBF1E9;
  --primary-disabled: #E8C9B0;
  --secondary: #1A2330;
  --success: #3E7C4F;
  --success-light: #D9EBDF;
  --warning: #A8652A;
  --warning-light: #F5E6D2;
  --danger: #B03A2E;
  --danger-light: #F5DAD5;
  --text-1: #1A2330;
  --text-2: #6B7280;
  --text-3: #9CA3AF;
  --bg-page: #F5F5F5;
  --bg-card: #FFFFFF;
  --border: #E5E7EB;
  /* 间距体系 */
  --gap-xs: 8rpx;
  --gap-sm: 16rpx;
  --gap-md: 24rpx;
  --gap-lg: 32rpx;
  /* 过渡 */
  --transition: 0.2s ease;
  background: var(--bg-page);
  color: var(--text-1);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: var(--font-lg);
  line-height: 1.5;
}

view, text, image, navigator, scroll-view, swiper { box-sizing: border-box; }

/* 通用按钮 hover（替代 :active 手写，统一透明度反馈） */
.btn-hover { opacity: 0.7; transition: opacity 0.15s ease; }

.container { padding: 24rpx; }

/* 卡片 */
.card {
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: var(--gap-md);
  margin-bottom: var(--gap-md);
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06);
}

/* 主按钮 */
.btn-primary {
  background: var(--primary);
  color: var(--text-invert);
  border: none;
  padding: 20rpx 40rpx;
  border-radius: 12rpx;
  font-size: var(--font-xl);
  text-align: center;
  transition: var(--transition);
}
.btn-primary::after { border: none; }
.btn-primary:active { transform: scale(0.97); opacity: 0.9; }
.btn-primary[disabled] { background: var(--primary-disabled); color: var(--text-disabled); }

/* 幽灵按钮 */
.btn-ghost {
  background: transparent;
  color: var(--primary);
  border: 2rpx solid var(--primary);
  padding: 18rpx 38rpx;
  border-radius: 12rpx;
  font-size: var(--font-xl);
  text-align: center;
  transition: var(--transition);
}
.btn-ghost::after { border: none; }
.btn-ghost:active { transform: scale(0.97); background: rgba(212,135,90,0.06); }

/* 危险按钮 */
.btn-danger {
  background: var(--danger);
  color: var(--text-invert);
  border: none;
  padding: 20rpx 40rpx;
  border-radius: 12rpx;
  font-size: var(--font-xl);
  text-align: center;
  transition: var(--transition);
}
.btn-danger::after { border: none; }
.btn-danger:active { transform: scale(0.97); opacity: 0.9; }

/* 状态标签基础类 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: var(--font-sm);
  margin-right: 8rpx;
}
.tag-primary { background: var(--primary-light); color: var(--primary); }
.tag-success { background: var(--success-light); color: var(--success); }
.tag-warn { background: var(--warning-light); color: var(--warning); }
.tag-danger { background: var(--danger-light); color: var(--danger); }

/* 迷你按钮(卡片内小操作) */
.mini-btn {
  font-size: var(--font-base); color: var(--primary);
  padding: 8rpx 24rpx; border-radius: 999rpx;
  background: var(--primary-lighter); transition: var(--transition);
}
.mini-btn:active { transform: scale(0.95); opacity: 0.85; }

/* 通用文本 */
.title-lg { font-size: var(--font-display-lg); font-weight: 600; color: var(--text-1); }
.title-md { font-size: var(--font-xxl); font-weight: 600; color: var(--text-1); }
.title-sm { font-size: var(--font-lg); font-weight: 500; color: var(--text-1); }
.text-muted { color: var(--text-2); font-size: var(--font-md); }

/* 通用布局 */
.flex-row { display: flex; flex-direction: row; align-items: center; }
.flex-between { display: flex; justify-content: space-between; align-items: center; }
.flex-center { display: flex; justify-content: center; align-items: center; }
.btn-block { display: block; width: 100%; }
.safe-bottom { padding-bottom: calc(env(safe-area-inset-bottom) + 20rpx); }

/* ═══════ 骨架屏(shimmer 动画, 替代文字"加载中") ═══════ */
@keyframes skeleton-shimmer {
  0% { background-position: -468rpx 0; }
  100% { background-position: 468rpx 0; }
}
.skeleton {
  background: linear-gradient(90deg, var(--bg-segment) 25%, var(--bg-input) 50%, var(--bg-segment) 75%);
  background-size: 936rpx 100%;
  animation: skeleton-shimmer 1.4s ease infinite;
  border-radius: 8rpx;
}
/* 骨架块形状 */
.sk-line { height: 28rpx; margin-bottom: 12rpx; }
.sk-line-sm { height: 22rpx; width: 60%; margin-bottom: 12rpx; }
.sk-circle { width: 80rpx; height: 80rpx; border-radius: 50%; flex-shrink: 0; }
.sk-card { height: 200rpx; margin-bottom: 24rpx; border-radius: 20rpx; }
.sk-row { display: flex; align-items: center; margin-bottom: 24rpx; }

/* ═══════ 统一空状态(各页复用, 删冗余) ═══════ */
.empty-state {
  text-align: center;
  padding: 120rpx 48rpx;
}
.empty-icon {
  font-size: var(--font-icon-md);
  margin-bottom: 24rpx;
  opacity: 0.6;
}
.empty-text {
  font-size: var(--font-lg);
  color: var(--text-2);
}
.empty-sub {
  font-size: var(--font-base);
  color: var(--text-3);
  margin-top: 12rpx;
  line-height: 1.6;
}
.empty-btn {
  margin-top: 32rpx;
  display: inline-block;
}

/* ═══════ 统一加载提示 ═══════ */
.loading-tip {
  text-align: center;
  color: var(--text-3);
  font-size: var(--font-md);
  padding: 80rpx 0;
}

/* ═══════ 交互动效(按压反馈) ═══════ */
/* 按钮按压: opacity + 轻微缩放, 仅 transform/opacity 不触发重排 */
.btn-press { transition: opacity .15s ease, transform .15s ease; }
.btn-press:active { opacity: 0.8; transform: scale(0.97); }
.btn-press[disabled] { opacity: 1; transform: none; }

/* 卡片/列表项入口按压: 更轻的缩放 */
.card-press { transition: transform .18s ease, box-shadow .18s ease; }
.card-press:active { transform: scale(0.985); }

/* ═══════ 进场动效(淡入+上浮, 仅 opacity/transform) ═══════ */
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* 进场动画类, 动画结束后保留最终态 */
.fade-in-up {
  opacity: 0;
  animation: fadeInUp .4s ease forwards;
}
.fade-in {
  opacity: 0;
  animation: fadeIn .4s ease forwards;
}

/* 列表项 stagger 进场: 通过 inline style 设置 animation-delay */
.list-item-enter {
  opacity: 0;
  animation: fadeInUp .4s ease forwards;
}

/* ═══════ 暗色模式（旧变量兜底，与 tokens.wxss 绿色变量同步反色） ═══════ */
@media (prefers-color-scheme: dark) {
  page {
    --primary: #07C160;
    --primary-light: rgba(7,193,96,0.15);
    --primary-lighter: rgba(7,193,96,0.08);
    --primary-disabled: #2A2E36;
    --secondary: #C8CCD1;
    --success: #07C160;
    --success-light: rgba(7,193,96,0.15);
    --warning: #ff8f3c;
    --warning-light: rgba(255,143,60,0.15);
    --danger: #fa5151;
    --danger-light: rgba(250,81,81,0.15);
    --text-1: #F0F1F3;
    --text-2: #C8CCD1;
    --text-3: #9097A0;
    --bg-page: #14161A;
    --bg-card: #1E2126;
    --border: #33373F;
  }
}
