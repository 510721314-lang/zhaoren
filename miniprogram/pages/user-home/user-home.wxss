.page-user-home { min-height: 100vh; background: var(--bg-page, #F5F5F5); padding: 20rpx 24rpx 40rpx; }
/* loading-tip / empty-state 已提升为全局类(app.wxss) */

/* 资料卡 */
.profile-card {
  display: flex; align-items: center;
  background: linear-gradient(135deg, #FBF1E9 0%, #FFFFFF 50%);
  border-radius: 20rpx; padding: 36rpx 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06);
}
.p-avatar {
  width: 110rpx; height: 110rpx; border-radius: 50%; background: #E5E7EB;
  border: 3rpx solid #fff; box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.12);
}
.p-avatar-default {
  display: flex; align-items: center; justify-content: center; font-size: 56rpx;
  border: 3rpx solid #fff; box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.12);
}
.p-info { flex: 1; margin-left: 24rpx; min-width: 0; }
.p-name { font-size: 34rpx; font-weight: 600; color: var(--text-1); }
.p-badge { margin-top: 8rpx; }
.p-city { font-size: 24rpx; color: var(--text-3); margin-top: 8rpx; }

/* 统计 */
.stat-card {
  display: flex; background: #fff; border-radius: 20rpx;
  padding: 30rpx 0; margin-top: 20rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06);
}
.stat-item { flex: 1; text-align: center; }
.stat-icon { font-size: 32rpx; margin-bottom: 8rpx; }
.stat-num { font-size: 36rpx; font-weight: 700; color: var(--primary, #D4875A); }
.stat-item:last-child .stat-num { color: var(--success, #3E7C4F); }
.stat-label { font-size: 22rpx; color: var(--text-3, #9CA3AF); margin-top: 8rpx; }

/* section 标题 */
.section-title {
  display: flex; align-items: center;
  font-size: 30rpx; font-weight: 600; color: var(--text-1);
  margin: 28rpx 4rpx 16rpx;
}
.st-bar {
  width: 6rpx; height: 28rpx; border-radius: 3rpx;
  background: var(--primary, #D4875A); margin-right: 16rpx;
}

/* 动态卡片 */
.post-card {
  background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 20rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06);
  transition: var(--transition, 0.2s ease);
}
.post-card:active { transform: scale(0.99); }
.post-head { display: flex; justify-content: space-between; align-items: center; }
.post-time { font-size: 22rpx; color: var(--primary, #D4875A); }
.post-content { font-size: 28rpx; color: var(--text-1); line-height: 1.6; margin-top: 12rpx; }
.post-cover { width: 100%; height: 320rpx; border-radius: 12rpx; margin-top: 16rpx; }
.topic-row { display: flex; flex-wrap: wrap; margin: 12rpx 0; }
.topic-tag {
  font-size: 23rpx; color: var(--primary, #D4875A);
  margin-right: 22rpx;
}
.post-foot { display: flex; gap: 24rpx; margin-top: 16rpx; }
.post-meta { font-size: 22rpx; color: var(--text-3); }
