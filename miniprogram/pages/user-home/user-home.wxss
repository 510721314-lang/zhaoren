.page-user-home { min-height: 100vh; background: var(--bg-page, #F5F5F5); padding: 20rpx 24rpx 40rpx; }
/* loading-tip / empty-state 已提升为全局类(app.wxss) */

/* 资料卡 */
.profile-card {
  display: flex; align-items: center;
  background: linear-gradient(135deg, var(--banner-grad-start) 0%, var(--text-invert) 50%);
  border-radius: 20rpx; padding: 36rpx 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06);
}
.p-avatar {
  width: 110rpx; height: 110rpx; border-radius: 50%; background: var(--border-1);
  border: 3rpx solid var(--text-invert); box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.12);
}
.p-avatar-default {
  display: flex; align-items: center; justify-content: center; font-size: var(--font-2xl);
  border: 3rpx solid var(--text-invert); box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.12);
}
.p-info { flex: 1; margin-left: 24rpx; min-width: 0; }
.p-name { font-size: var(--font-xxl); font-weight: 600; color: var(--text-1); }
.p-badge { margin-top: 8rpx; }
.p-city { font-size: var(--font-base); color: var(--text-3); margin-top: 8rpx; }

/* 统计 */
.stat-card {
  display: flex; background: var(--text-invert); border-radius: 20rpx;
  padding: 30rpx 0; margin-top: 20rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06);
}
.stat-item { flex: 1; text-align: center; }
.stat-icon { font-size: var(--font-xxl); margin-bottom: 8rpx; }
.stat-num { font-size: var(--font-display); font-weight: 700; color: var(--primary, #D4875A); }
.stat-item:last-child .stat-num { color: var(--success, #3E7C4F); }
.stat-label { font-size: var(--font-sm); color: var(--text-3, #9CA3AF); margin-top: 8rpx; }

/* section 标题 */
.section-title {
  display: flex; align-items: center;
  font-size: var(--font-xl); font-weight: 600; color: var(--text-1);
  margin: 28rpx 4rpx 16rpx;
}
.st-bar {
  width: 6rpx; height: 28rpx; border-radius: 3rpx;
  background: var(--primary, #D4875A); margin-right: 16rpx;
}

/* 动态卡片 */
.post-card {
  background: var(--text-invert); border-radius: 20rpx; padding: 28rpx; margin-bottom: 20rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06);
  transition: var(--transition, 0.2s ease);
}
.post-card:active { transform: scale(0.99); }
.post-head { display: flex; justify-content: space-between; align-items: center; }
.post-time { font-size: var(--font-sm); color: var(--primary, #D4875A); }
.post-content { font-size: var(--font-lg); color: var(--text-1); line-height: 1.6; margin-top: 12rpx; }
.post-cover { width: 100%; height: 320rpx; border-radius: 12rpx; margin-top: 16rpx; }
.post-img-grid { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.post-img { width: calc((100% - 12rpx) / 2); height: 220rpx; border-radius: 12rpx; }
.topic-row { display: flex; flex-wrap: wrap; margin: 12rpx 0; }
.topic-tag {
  font-size: var(--font-sm); color: var(--primary, #D4875A);
  margin-right: 22rpx;
}
.post-foot { display: flex; gap: 24rpx; margin-top: 16rpx; }
.post-meta { font-size: var(--font-sm); color: var(--text-3); }
