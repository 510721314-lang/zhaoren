/* pages/agreement/agreement.wxss — 结构化文档排版 */
.page-agreement { min-height: 100vh; background: #fff; padding: 48rpx 40rpx; box-sizing: border-box; }
.doc { max-width: 680rpx; margin: 0 auto; }
.doc-title { font-size: 40rpx; font-weight: 700; color: var(--text-1); text-align: center; margin-bottom: 16rpx; }
.doc-meta { font-size: 22rpx; color: var(--text-3); text-align: center; margin-bottom: 32rpx; }
.doc-tip { font-size: 26rpx; color: var(--text-2); line-height: 1.7; padding: 24rpx 28rpx; background: #FFF8F2; border-radius: 12rpx; margin-bottom: 40rpx; border: 1rpx solid #F0E0D0; }

.section { margin-bottom: 40rpx; }
.sec-title { font-size: 30rpx; font-weight: 600; color: var(--text-1); margin-bottom: 16rpx; padding-left: 20rpx; border-left: 6rpx solid var(--primary); line-height: 1.4; }
.para { font-size: 26rpx; color: var(--text-2); line-height: 1.8; margin-bottom: 12rpx; }

.doc-bottom { font-size: 24rpx; color: var(--text-3); text-align: center; margin-top: 60rpx; padding-top: 24rpx; border-top: 1rpx solid var(--border); }
