.page-publish { padding: 24rpx 24rpx calc(env(safe-area-inset-bottom) + 40rpx); }

.title-sub { font-size: 24rpx; font-weight: 400; color: var(--text-3); }

/* 场景网格 */
.scene-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 16rpx; }
.scene-card {
  flex: 0 0 calc(33.333% - 11rpx);
  padding: 24rpx 12rpx; text-align: center;
  border: 2rpx solid var(--border); border-radius: 12rpx;
  background: #fff;
}
.scene-card.active { border-color: var(--primary); background: rgba(212,135,90,0.08); }
.scene-icon { font-size: 48rpx; }
.scene-name { font-size: 26rpx; color: var(--text-1); margin-top: 8rpx; }

/* 服务内容多选 chips */
.chip-list { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 16rpx; }
.chip {
  padding: 12rpx 28rpx;
  border: 2rpx solid var(--border); border-radius: 999rpx;
  font-size: 26rpx; color: var(--text-1);
  background: #fff;
}
.chip.active {
  border-color: var(--primary); background: rgba(212,135,90,0.08);
  color: var(--primary); font-weight: 500;
}

/* 表单行 */
.form-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 20rpx 0; border-bottom: 2rpx solid var(--bg-page);
}
.form-label { font-size: 28rpx; color: var(--text-2); }
.form-value { font-size: 28rpx; color: var(--text-1); max-width: 460rpx; text-align: right; }
.form-value.placeholder { color: var(--text-3); }

/* 滑条行 */
.slider-row { display: flex; justify-content: space-between; align-items: center; padding-top: 12rpx; }
.slider-value { font-size: 28rpx; color: var(--primary); font-weight: 600; }

/* 时薪与费用 */
.rate-display { font-size: 40rpx; font-weight: 600; color: var(--primary); text-align: center; margin: 16rpx 0 0; }
.rate-hint { font-size: 24rpx; color: var(--text-3); text-align: center; }
.form-hint { font-size: 22rpx; color: var(--text-3); margin-top: 12rpx; }
.fee-total {
  margin-top: 20rpx; padding: 16rpx 20rpx;
  background: var(--bg-page); border-radius: 12rpx;
  font-size: 26rpx; color: var(--text-2); text-align: center;
}
.fee-num { font-size: 32rpx; font-weight: 600; color: var(--primary); }

/* AA 档位 */
.aa-list { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 16rpx; }
.aa-item {
  padding: 12rpx 28rpx; border: 2rpx solid var(--border);
  border-radius: 30rpx; font-size: 26rpx; color: var(--text-1);
}
.aa-item.active { border-color: var(--primary); background: rgba(212,135,90,0.08); color: var(--primary); }
.aa-hint { font-size: 22rpx; color: var(--text-3); margin-top: 16rpx; }

/* AA 承诺书勾选 */
.promise-row {
  display: flex; align-items: center; flex-wrap: wrap;
  margin-top: 20rpx; padding-top: 20rpx;
  border-top: 2rpx solid var(--bg-page);
}
.promise-check {
  width: 36rpx; height: 36rpx; border-radius: 8rpx;
  border: 2rpx solid var(--primary); margin-right: 12rpx;
  color: #fff; font-size: 26rpx; line-height: 34rpx; text-align: center;
  flex-shrink: 0;
}
.promise-check.checked { background: var(--primary); }
.promise-text { font-size: 26rpx; color: var(--text-2); }
.promise-link { font-size: 26rpx; color: var(--primary); }

/* 备注 */
.remark-input {
  width: 100%; min-height: 120rpx; margin-top: 16rpx;
  padding: 16rpx; background: var(--bg-page);
  border-radius: 8rpx; font-size: 28rpx; box-sizing: border-box;
}
