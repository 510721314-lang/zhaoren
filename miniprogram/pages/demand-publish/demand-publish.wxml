<view class="page-publish">
  <!-- 场景单选(白名单) -->
  <view class="card">
    <view class="title-md">选择服务场景</view>
    <view class="scene-grid">
      <view wx:for="{{scenes}}" wx:key="code"
        class="scene-card {{selectedScene === item.code ? 'active' : ''}}"
        bindtap="onSceneTap" data-code="{{item.code}}">
        <view class="scene-icon">{{item.icon}}</view>
        <view class="scene-name">{{item.name}}</view>
      </view>
    </view>
  </view>

  <!-- 服务内容(按场景动态单选) -->
  <view wx:if="{{selectedScene}}" class="card">
    <view class="title-md">服务内容<text class="title-sub">（单选）</text></view>
    <view class="chip-list">
      <view wx:for="{{currentOptions}}" wx:key="name"
        class="chip {{item.checked ? 'active' : ''}}"
        bindtap="onOptionToggle" data-option="{{item.name}}">
        {{item.checked ? '✓ ' : ''}}{{item.name}}
      </view>
    </view>
  </view>

  <!-- 服务时间:date + time picker,默认明天 10:00 -->
  <view class="card">
    <view class="title-md">服务时间</view>
    <view class="form-row">
      <text class="form-label">开始日期</text>
      <picker mode="date" value="{{dateStr}}" start="{{minDate}}" end="{{maxDate}}" bindchange="onDateChange">
        <view class="form-value">{{dateStr || '请选择'}}</view>
      </picker>
    </view>
    <view class="form-row">
      <text class="form-label">开始时间</text>
      <picker mode="time" value="{{timeStr}}" bindchange="onTimeChange">
        <view class="form-value">{{timeStr || '请选择'}}</view>
      </picker>
    </view>
    <view class="slider-row">
      <text class="form-label">服务时长</text>
      <text class="slider-value">{{durationH}} 小时</text>
    </view>
    <slider min="1" max="12" step="1" value="{{durationH}}" bindchange="onDurationChange"
      block-size="24" activeColor="#D4875A" />
    <view class="form-hint">服务时间距发布最长 30 天</view>
  </view>

  <!-- 地址: 发布地址(GPS只读) + 履约地址(自选) -->
  <view class="card">
    <view class="title-md">地址信息</view>
    <!-- 发布地址: 发布时实际GPS定位, 不可手动修改 -->
    <view class="form-row" bindtap="onPubLocationTap">
      <text class="form-label">发布地址</text>
      <view class="form-value {{pubLocationName ? '' : 'placeholder'}}">
        {{locating ? '定位中…' : (pubLocationName || '点击获取当前位置')}}
      </view>
    </view>
    <view class="form-hint">📌 发布地址为您发布时的实际定位，自动记录不可修改；点击可重新定位</view>
    <!-- 履约地址: 用户地图自主选择 -->
    <view class="form-row" bindtap="chooseSite">
      <text class="form-label">履约地址</text>
      <view class="form-value {{siteName ? '' : 'placeholder'}}">
        {{siteName || '点击在地图上选择履约地点'}}
      </view>
    </view>
    <view class="form-hint">📍 耍伴将在此地点与您碰面，请准确选择；接单时校验耍伴与此地距离不超过 50 公里</view>
  </view>

  <!-- 时薪 + 费用自动计算 -->
  <view class="card">
    <view class="title-md">时薪设置</view>
    <view class="rate-display">¥{{rateYuan}}.00 / 小时</view>
    <slider min="{{rateMin}}" max="{{rateMax}}" step="5" value="{{rateYuan}}" bindchange="onRateChange"
      block-size="24" activeColor="#D4875A" />
    <view class="rate-hint">时薪区间 30-100 元/小时</view>
    <view class="fee-total">预计服务费：<text class="fee-num">¥{{totalYuan}}.00</text>（{{rateYuan}}元 × {{durationH}}小时）</view>
  </view>

  <!-- AA 费用档位 + 承诺书 -->
  <view class="card">
    <view class="title-md">AA 费用预估档位</view>
    <view class="aa-list">
      <view wx:for="{{aaTiers}}" wx:key="value"
        class="aa-item {{selectedAaTier === item.value ? 'active' : ''}}"
        bindtap="onAaTierTap" data-tier="{{item.value}}">
        {{item.label}}
      </view>
    </view>
    <view class="aa-hint">AA 费用平台不代收，线下各自支付</view>
    <view class="promise-row" bindtap="onPromiseCheckTap">
      <view class="promise-check {{aaPromiseChecked ? 'checked' : ''}}">{{aaPromiseChecked ? '✓' : ''}}</view>
      <text class="promise-text">我已阅读并同意</text>
      <text class="promise-link" catchtap="onPromiseTap">《线下费用自理承诺书》</text>
    </view>
  </view>

  <!-- 备注(前端预检 + 服务端 msgSecCheck 复检) -->
  <view class="card">
    <view class="title-md">备注<text class="title-sub">（选填）</text></view>
    <textarea class="remark-input" placeholder="补充说明服务要求..."
      value="{{remark}}" bindinput="onRemarkInput" maxlength="{{remarkMax}}" />
  </view>

  <!-- 提交 -->
  <view class="safe-bottom">
    <button class="btn-primary btn-block" bindtap="onSubmit" disabled="{{submitting}}">
      发布需求
    </button>
  </view>
</view>
