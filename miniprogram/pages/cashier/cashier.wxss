.page-cashier { padding: 24rpx 24rpx calc(env(safe-area-inset-bottom) + 40rpx); }

/* 模拟支付提示 */
.mock-banner {
  background: linear-gradient(135deg, var(--func-danger) 0%, var(--func-danger) 100%);
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  text-align: center;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(176,58,46,0.25);
}
.mock-title { font-size: var(--font-xxl); font-weight: 600; color: var(--text-invert); }
.mock-sub { font-size: var(--font-base); color: rgba(255,255,255,0.85); margin-top: 8rpx; }

/* 摘要 */
.summary-row {
  display: flex; justify-content: space-between; align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--bg-page);
}
.s-label { font-size: var(--font-lg); color: var(--text-2); flex-shrink: 0; margin-right: 24rpx; }
.s-value { font-size: var(--font-lg); color: var(--text-1); text-align: right; flex: 1; }

/* 费用 */
.fee-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 16rpx 0;
}
.fee-total {
  font-size: var(--font-display-lg); font-weight: 600; color: var(--primary);
  font-variant-numeric: tabular-nums;
}
.fee-note { font-size: var(--font-base); color: var(--text-3); margin-top: 8rpx; line-height: 1.5; }

/* AA 承诺书 */
.warn-text { color: var(--warning); }
.promise-text {
  font-size: var(--font-md); color: var(--text-2);
  line-height: 1.7; margin: 16rpx 0;
}
.agree-row {
  display: flex; align-items: center; margin-top: 16rpx;
  transition: var(--transition, 0.2s ease);
}
.agree-row:active { opacity: 0.7; }
.agree-check {
  width: 36rpx; height: 36rpx; border-radius: 8rpx;
  border: 2rpx solid var(--border); margin-right: 16rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: var(--font-base); color: var(--text-invert); flex-shrink: 0;
  transition: var(--transition, 0.2s ease);
}
.agree-check.checked { background: var(--primary); border-color: var(--primary); }
.agree-text { font-size: var(--font-lg); color: var(--text-1); }

/* 支付按钮 */
.pay-btn {
  font-size: var(--font-xxl); font-weight: 600;
  padding: 24rpx 40rpx;
  margin-top: 16rpx;
  font-variant-numeric: tabular-nums;
}
