.page-cashier { padding: 24rpx 24rpx calc(env(safe-area-inset-bottom) + 40rpx); }

/* 模拟支付提示 */
.mock-banner {
  background: linear-gradient(135deg, #B03A2E 0%, #963326 100%);
  border-radius: 16rpx;
  padding: 32rpx;
  text-align: center;
  margin-bottom: 24rpx;
}
.mock-title { font-size: 34rpx; font-weight: 600; color: #fff; }
.mock-sub { font-size: 24rpx; color: rgba(255,255,255,0.85); margin-top: 8rpx; }

/* 摘要 */
.summary-row {
  display: flex; justify-content: space-between; align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--bg-page);
}
.s-label { font-size: 28rpx; color: var(--text-2); flex-shrink: 0; margin-right: 24rpx; }
.s-value { font-size: 28rpx; color: var(--text-1); text-align: right; flex: 1; }

/* 费用 */
.fee-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 16rpx 0;
}
.fee-total { font-size: 44rpx; font-weight: 600; color: var(--primary); }
.fee-note { font-size: 24rpx; color: var(--text-3); margin-top: 8rpx; line-height: 1.5; }

/* AA 承诺书 */
.warn-text { color: var(--warning); }
.promise-text {
  font-size: 26rpx; color: var(--text-2);
  line-height: 1.7; margin: 16rpx 0;
}
.agree-row { display: flex; align-items: center; margin-top: 16rpx; }
.agree-check {
  width: 36rpx; height: 36rpx; border-radius: 8rpx;
  border: 2rpx solid var(--border); margin-right: 16rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; color: #fff; flex-shrink: 0;
}
.agree-check.checked { background: var(--primary); border-color: var(--primary); }
.agree-text { font-size: 28rpx; color: var(--text-1); }

/* 支付按钮 */
.pay-btn {
  font-size: 32rpx; font-weight: 600;
  padding: 24rpx 40rpx;
  margin-top: 16rpx;
}
