<view class="page-cashier" wx:if="{{loaded}}">
  <!-- 模拟支付提示(显著) -->
  <view class="mock-banner">
    <view class="mock-title">模拟支付 · 不产生真实扣款</view>
    <view class="mock-sub">测试环境,资金流程全部为模拟流水</view>
  </view>

  <!-- 订单摘要 -->
  <view class="card">
    <view class="title-md">订单摘要</view>
    <view class="summary-row">
      <text class="s-label">订单号</text>
      <text class="s-value">{{info.order_no}}</text>
    </view>
    <view class="summary-row">
      <text class="s-label">场景</text>
      <text class="s-value">{{sceneName}}</text>
    </view>
    <view class="summary-row">
      <text class="s-label">服务时间</text>
      <text class="s-value">{{startTimeText}}</text>
    </view>
    <view class="summary-row">
      <text class="s-label">时长</text>
      <text class="s-value">{{durationText}}</text>
    </view>
    <view class="summary-row">
      <text class="s-label">地点</text>
      <text class="s-value">{{locationName}}</text>
    </view>
    <view class="summary-row">
      <text class="s-label">内容</text>
      <text class="s-value">{{contentText}}</text>
    </view>
    <view class="summary-row">
      <text class="s-label">AA档位</text>
      <text class="s-value">{{aaTierText}}</text>
    </view>
  </view>

  <!-- 费用明细 -->
  <view class="card">
    <view class="title-md">费用明细</view>
    <view class="fee-row">
      <text class="s-label">服务总价</text>
      <text class="fee-total">¥ {{totalText}}</text>
    </view>
    <view class="fee-note">平台服务费测试环境由平台模拟收取,不产生真实分账。</view>
  </view>

  <!-- AA 线下费用自理承诺书(非 0-50 元档位强制) -->
  <view class="card" wx:if="{{info.need_aa_promise}}">
    <view class="title-md warn-text">线下费用自理承诺书</view>
    <view class="promise-text">
      本次服务涉及线下 AA 费用({{aaTierText}}档位),该费用不由平台代收。本人知晓并同意:服务过程中产生的 AA 费用由双方线下自行结算,平台不参与该部分资金的收取、保管与退款;如因线下费用产生争议,平台将依据订单信息与双方沟通记录协助处理,但不承担垫付与赔偿责任。
    </view>
    <view class="agree-row" bindtap="onPromiseToggle">
      <view class="agree-check {{aaPromiseChecked ? 'checked' : ''}}">
        <text wx:if="{{aaPromiseChecked}}">✓</text>
      </view>
      <text class="agree-text">我已阅读并同意《线下费用自理承诺书》</text>
    </view>
  </view>

  <!-- 支付按钮 -->
  <view class="safe-bottom">
    <button wx:if="{{paymentVisible}}" class="btn-primary btn-block pay-btn" bindtap="doPay" disabled="{{paying}}">
      模拟支付(不产生真实扣款)¥ {{totalText}}
    </button>
    <view wx:else class="pay-disabled-tip">支付功能暂未开放</view>
  </view>
</view>
