/* pages/blog-publish/blog-publish.wxss */
.page-publish { min-height: 100vh; background: var(--bg-page, #F5F5F5); padding: 20rpx 24rpx; }
.card { background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 20rpx; }

.content-input { width: 100%; min-height: 220rpx; font-size: 28rpx; line-height: 1.7; color: var(--text-1, #1F2937); box-sizing: border-box; }
.word-count { text-align: right; font-size: 22rpx; color: var(--text-3, #9CA3AF); margin-top: 12rpx; }

.card-label { font-size: 26rpx; color: var(--text-2, #4B5563); margin-bottom: 20rpx; }
.scene-pick { display: flex; flex-wrap: wrap; }
.scene-chip {
  padding: 12rpx 26rpx; margin: 0 18rpx 18rpx 0;
  font-size: 24rpx; color: var(--text-2, #4B5563); background: #F3F4F6;
  border-radius: 28rpx; position: relative;
  transition: var(--transition, 0.2s ease);
}
.scene-chip:active { transform: scale(0.95); }
.chip-on {
  background: var(--primary, #D4875A); color: #fff;
  padding-right: 50rpx;
}
.chip-on::after {
  content: '✓'; position: absolute; right: 18rpx; top: 50%;
  transform: translateY(-50%); font-size: 22rpx;
}

/* 图片九宫格 */
.img-picker { display: flex; flex-wrap: wrap; }
.picker-item { position: relative; width: 200rpx; height: 200rpx; margin: 0 18rpx 18rpx 0; }
.picker-img { width: 200rpx; height: 200rpx; border-radius: 12rpx; background: #F3F4F6; }
.up-mask {
  position: absolute; inset: 0; background: rgba(0,0,0,0.45);
  display: flex; align-items: center; justify-content: center;
  border-radius: 12rpx;
}
.up-spinner {
  width: 40rpx; height: 40rpx;
  border: 5rpx solid rgba(255,255,255,0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: pub-spin 0.8s linear infinite;
}
@keyframes pub-spin { to { transform: rotate(360deg); } }
.up-del { position: absolute; top: -14rpx; right: -14rpx; width: 40rpx; height: 40rpx; line-height: 36rpx; text-align: center; background: rgba(0,0,0,0.6); color: #fff; border-radius: 50%; font-size: 28rpx; }
.picker-add {
  width: 200rpx; height: 200rpx; border: 2rpx dashed var(--border, #D1D5DB);
  border-radius: 12rpx; display: flex; flex-direction: column;
  align-items: center; justify-content: center; color: var(--text-3, #9CA3AF);
  transition: var(--transition, 0.2s ease);
}
.picker-add:active { background: #F3F4F6; transform: scale(0.97); }
.add-plus { font-size: 56rpx; line-height: 1; }
.add-text { font-size: 22rpx; margin-top: 10rpx; }

.submit-btn { margin-top: 12rpx; }
.tip { text-align: center; font-size: 22rpx; color: var(--text-3, #9CA3AF); margin-top: 24rpx; line-height: 1.6; }
