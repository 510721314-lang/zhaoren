<view class="page">
  <!-- 角色切换 -->
  <view class="role-tabs">
    <view class="role-tab {{role === 'partner' ? 'active' : ''}}" bindtap="switchRole" data-role="partner">我接的单</view>
    <view class="role-tab {{role === 'user' ? 'active' : ''}}" bindtap="switchRole" data-role="user">我发的单</view>
  </view>

  <!-- 定位未授权引导(耍伴视角) -->
  <view wx:if="{{role === 'partner' && locationTried && !hasLocation && orders.length > 0}}" class="loc-tip" bindtap="openLocationSetting">
    <text>📡 开启定位后，可查看距履约地点的距离与出行时间</text>
    <text class="loc-tip-btn">去开启</text>
  </view>

  <!-- 订单列表 -->
  <block wx:if="{{orders.length > 0}}">
    <view class="order-card" wx:for="{{orders}}" wx:key="order_id" bindtap="goDetail" data-id="{{item.order_id}}" data-type="{{item.item_type}}">
      <view class="card-head">
        <text class="scene-tag">{{item.scene_name}}</text>
        <text class="status status-{{item.status_color}}">{{item.status_name}}</text>
      </view>

      <view class="card-body">
        <view class="row">📋 {{item.content_str}}</view>
        <view class="row">📍 {{item.location_name}}</view>
        <view class="row">🕐 {{item.time_str}} · {{item.duration_h}}小时</view>
      </view>

      <view class="card-foot">
        <text class="order-no">{{item.item_type === 'demand' ? '⏳ 等待耍伴接单，点击查看匹配进展' : item.order_no}}</text>
        <text class="price">¥{{item.total_yuan}}</text>
      </view>

      <!-- 当前位置 → 履约地点通勤(耍伴视角·待履约订单) -->
      <view wx:if="{{role === 'partner' && item.to_site}}" class="to-site">
        <view class="to-site-title">📍 距履约地点 {{item.to_site.distance_km}} 公里</view>
        <view class="commute-modes">
          <text>🚶 步行{{item.to_site.walk_min}}分</text>
          <text>🚲 骑行{{item.to_site.bike_min}}分</text>
          <text>🚌 公交{{item.to_site.bus_min}}分</text>
          <text>🚗 驾车{{item.to_site.drive_min}}分</text>
        </view>
        <view wx:if="{{item.to_site.depart_str}}" class="to-site-depart">
          🚗 建议最晚 <text>{{item.to_site.depart_str}}</text> 出发（按驾车估算，路程为直线距离请预留余量）
        </view>
      </view>

      <!-- 通勤提示(仅耍伴视角且有下一单) -->
      <view wx:if="{{role === 'partner' && item.commute}}" class="commute {{item.commute.tight ? 'tight' : ''}}">
        <view class="commute-title">
          {{item.commute.tight ? '⚠️ 时间紧张' : '➡️ 前往下一单'}} · {{item.commute.to_location}}
        </view>
        <view class="commute-detail">
          直线 {{item.commute.distance_km}} 公里 · 间隔 {{item.commute.gap_min}} 分钟
        </view>
        <view class="commute-modes">
          <text>🚶 步行{{item.commute.walk_min}}分</text>
          <text>🚲 骑行{{item.commute.bike_min}}分</text>
          <text>🚌 公交{{item.commute.bus_min}}分</text>
          <text>🚗 驾车{{item.commute.drive_min}}分</text>
        </view>
      </view>
    </view>
  </block>

  <!-- 空状态 -->
  <view wx:if="{{loaded && orders.length === 0}}" class="empty-state">
    <view class="empty-icon">📭</view>
    <view class="empty-text">{{role === 'partner' ? '还没有接到订单' : '还没有发布需求'}}</view>
    <view class="empty-sub">{{role === 'partner' ? '去接单大厅看看吧' : '发布需求后，耍伴接单进度会显示在这里'}}</view>
    <button wx:if="{{role === 'user'}}" class="btn-primary empty-btn" bindtap="goPublish">去发布需求</button>
  </view>
</view>
