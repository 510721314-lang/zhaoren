.page-apply { padding: 24rpx 24rpx calc(env(safe-area-inset-bottom) + 40rpx); }
.intro .text-muted { margin-top: 8rpx; line-height: 1.5; }

.status-banner {
  padding: 20rpx 24rpx; border-radius: 12rpx;
  font-size: var(--font-lg); text-align: center; margin-bottom: 24rpx;
}
.status-banner.warn { background: var(--brand-accent-light); color: var(--warning); }
.status-banner.danger { background: var(--func-danger-light); color: var(--func-danger); }

/* 场景列表 */
.scene-list { margin-top: 16rpx; }
.scene-block {
  border: 2rpx solid var(--border);
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}
.scene-header {
  display: flex; align-items: center;
  padding: 24rpx; background: var(--bg-page);
}
.scene-check {
  width: 36rpx; height: 36rpx; border-radius: 8rpx;
  border: 2rpx solid var(--border); margin-right: 16rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: var(--font-base); color: var(--text-invert);
}
.scene-check.checked { background: var(--primary); border-color: var(--primary); }
.scene-icon { font-size: var(--font-display); margin-right: 12rpx; }
.scene-name { font-size: var(--font-xl); color: var(--text-1); }
.option-list {
  padding: 16rpx 24rpx 16rpx 68rpx;
  border-top: 2rpx solid var(--border);
}
.option-item {
  display: flex; align-items: center;
  padding: 12rpx 0;
}
.option-check {
  width: 28rpx; height: 28rpx; border-radius: 6rpx;
  border: 2rpx solid var(--border); margin-right: 16rpx;
}
.option-check.checked { background: var(--primary); border-color: var(--primary); }

/* 单场景时薪 */
.scene-rate {
  margin-top: 16rpx; padding-top: 16rpx;
  border-top: 2rpx dashed var(--border);
}
.scene-rate-label { font-size: var(--font-md); color: var(--text-2); margin-bottom: 4rpx; }
.scene-rate-value {
  font-size: var(--font-display); font-weight: 600; color: var(--primary);
  margin: 8rpx 0;
}
.scene-rate slider { margin: 8rpx 0 0; }

/* 时薪 */
.rate-display {
  font-size: var(--font-display-xl); font-weight: 600; color: var(--primary);
  text-align: center; margin: 24rpx 0;
}
slider { margin: 16rpx 0; }

/* 协议 */
.agree-row { display: flex; align-items: center; }
.agree-check {
  width: 36rpx; height: 36rpx; border-radius: 8rpx;
  border: 2rpx solid var(--border); margin-right: 16rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: var(--font-base); color: var(--text-invert);
}
.agree-check.checked { background: var(--success); border-color: var(--success); }
.link { color: var(--primary); margin-left: 4rpx; }
