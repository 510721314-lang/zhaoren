<view class="page-match">

  <!-- 需求摘要卡 -->
  <view wx:if="{{demand}}" class="card demand-summary">
    <view class="summary-head">
      <view class="scene-tag">{{demand.scene_name}}</view>
      <view class="summary-title">需求已发布，正在为你匹配耍伴</view>
    </view>
    <view class="summary-content">{{demand.contentText}}</view>
    <view class="summary-meta">
      <view class="meta-row"><text class="meta-label">🕐</text><text class="meta-val">{{demand.timeText}} · {{demand.duration_h}}小时</text></view>
      <view class="meta-row"><text class="meta-label">📍</text><text class="meta-val">{{demand.location_name}}</text></view>
      <view class="meta-row"><text class="meta-label">💰</text><text class="meta-val">预算总价 {{demand.totalText}}</text></view>
    </view>
    <view wx:if="{{demand.aa_tier}}" class="aa-tag">AA {{demand.aa_tier}}</view>
  </view>

  <!-- 加载态 -->
  <view wx:if="{{loading}}" class="state-tip">
    <view class="state-spinner"></view>
    <view class="state-text">正在为你挑选合适的耍伴…</view>
  </view>

  <!-- 加载失败态 -->
  <view wx:elif="{{loadError}}" class="card state-card">
    <view class="state-icon">😵</view>
    <view class="state-text">{{loadError}}</view>
    <button class="btn-primary state-btn" bindtap="loadCandidates">重新加载</button>
  </view>

  <block wx:else>
    <!-- 等待接单态(广播后): 转圈 + 24h 有效 + 撤销需求 -->
    <view wx:if="{{waiting}}" class="card waiting-card">
      <view class="waiting-spinner"></view>
      <view class="waiting-title">正在等待耍伴接单…</view>
      <view class="waiting-sub">需求已广播到接单大厅，耍伴接单后将自动进入沟通</view>
      <view class="waiting-valid">⏳ 需求 24 小时内有效</view>
      <button class="btn-ghost waiting-cancel" bindtap="onCancelDemand" disabled="{{cancelling}}">撤销需求</button>
    </view>

    <!-- 候选耍伴列表 -->
    <view wx:if="{{candidates.length > 0}}" class="section-title">
      为你推荐 {{candidates.length}} 位耍伴
      <text class="section-sub">按信用分排序</text>
    </view>

    <view wx:for="{{candidates}}" wx:key="openid" class="card partner-card">
      <view class="partner-main">
        <view class="avatar-wrap">
          <image wx:if="{{item.avatar}}" class="avatar" src="{{item.avatar}}" mode="aspectFill"></image>
          <view wx:else class="avatar avatar-fallback">{{item.initial}}</view>
        </view>
        <view class="partner-info">
          <view class="partner-name-row">
            <text class="partner-name">{{item.nickname}}</text>
            <text class="level-tag">{{item.levelText}}</text>
          </view>
          <view class="partner-tags">
            <text class="tag tag-{{item.creditColor}}">信用 {{item.credit}}</text>
            <text class="tag tag-warn">{{item.rateText}}/时</text>
          </view>
          <view class="partner-orders">{{item.ordersText}}</view>
        </view>
      </view>
      <view class="partner-actions">
        <button class="btn-primary invite-btn" size="mini"
          data-openid="{{item.openid}}" data-nickname="{{item.nickname}}"
          bindtap="onInvite" disabled="{{item.invited || acting}}">
          {{item.invited ? '已邀约' : '定向邀约'}}
        </button>
        <button class="btn-ghost profile-btn" size="mini" bindtap="onViewProfile">查看主页</button>
      </view>
    </view>

    <!-- 空候选态 -->
    <view wx:if="{{candidates.length === 0 && !waiting}}" class="card empty-state">
      <view class="empty-icon">🔍</view>
      <view class="empty-text">暂未匹配到在线的合适耍伴</view>
      <view class="empty-sub">可以广场广播，让更多耍伴主动来接单</view>
    </view>

    <!-- 广播入口(未广播时) -->
    <view wx:if="{{!broadcasted}}" class="card broadcast-card">
      <view class="broadcast-title">没找到心仪的耍伴？</view>
      <view class="broadcast-sub">广场广播后，所有在线耍伴都能看到你的需求</view>
      <button class="btn-primary btn-block" bindtap="onBroadcast" disabled="{{acting}}">
        📢 广场广播，让更多耍伴看到
      </button>
    </view>

    <!-- 底部操作 -->
    <view class="foot-actions safe-bottom">
      <button class="btn-ghost foot-btn" bindtap="goOrders">查看订单</button>
      <button class="btn-primary foot-btn" bindtap="goHome">返回首页</button>
    </view>
  </block>

</view>
