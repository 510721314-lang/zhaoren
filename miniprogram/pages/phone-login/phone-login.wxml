<view class="page-login">
  <view class="tab-bar">
    <view class="tab-item {{mode==='login'?'tab-on':''}}" bindtap="switchMode" data-mode="login">登录</view>
    <view class="tab-item {{mode==='register'?'tab-on':''}}" bindtap="switchMode" data-mode="register">注册</view>
  </view>

  <view class="form-card">
    <view class="form-item">
      <view class="form-label">手机号</view>
      <input class="form-input" type="number" placeholder="请输入 11 位手机号" maxlength="11"
             value="{{phone}}" bindinput="onPhoneInput" />
    </view>
    <view class="form-item code-item">
      <view class="form-col">
        <view class="form-label">验证码</view>
        <input class="form-input" type="number" placeholder="6 位验证码" maxlength="6"
               value="{{smsCode}}" bindinput="onSmsCodeInput" />
      </view>
      <button class="code-btn {{!canSend?'code-btn-disabled':''}}" disabled="{{!canSend}}"
              bindtap="onSendCode">{{smsBtnText}}</button>
    </view>
  </view>

  <!-- 协议勾选 -->
  <view class="agreement-row">
    <view class="agreement-check {{agreed?'check-on':''}}" bindtap="toggleAgree">
      <text wx:if="{{agreed}}">✓</text>
    </view>
    <view class="agreement-text">
      我已阅读并同意
      <text class="agree-link" bindtap="goAgreement">《用户协议》</text>
      和
      <text class="agree-link" bindtap="goPrivacy">《隐私政策》</text>
    </view>
  </view>

  <button class="btn-primary btn-block submit-btn" loading="{{submitting}}" bindtap="onSubmit">
    {{mode==='login'?'登录':'完成注册并登录'}}
  </button>

  <view class="alt-entry">
    <text wx:if="{{mode==='login'}}" class="alt-link" bindtap="switchMode" data-mode="register">还没有账号？去注册</text>
    <text wx:else class="alt-link" bindtap="switchMode" data-mode="login">已有账号？去登录</text>
  </view>

  <view class="back-link" bindtap="goBack">← 返回</view>
</view>
