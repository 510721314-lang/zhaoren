.page-hall { padding: 24rpx; }

/* 空状态已提升为全局类(app.wxss .empty-state) */

/* 需求卡片 */
.demand-card {
  margin-bottom: 24rpx; padding: 28rpx;
  transition: var(--transition, 0.2s ease);
}
.demand-card:active { transform: scale(0.99); }
.demand-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.scene-tag {
  display: inline-block; padding: 6rpx 20rpx;
  background: rgba(212,135,90,0.12); color: var(--primary);
  border-radius: 20rpx; font-size: 24rpx; font-weight: 500;
}
.demand-no { font-size: 22rpx; color: var(--text-3); }

.demand-content { font-size: 30rpx; color: var(--text-1); font-weight: 500; line-height: 1.5; }
.demand-remark { font-size: 26rpx; color: var(--text-3); margin-top: 8rpx; line-height: 1.5; }

.demand-meta { margin-top: 20rpx; }
.meta-row { display: flex; align-items: center; padding: 6rpx 0; }
.meta-label { font-size: 26rpx; margin-right: 12rpx; }
.meta-val { font-size: 26rpx; color: var(--text-2); }

.aa-tag {
  display: inline-block; margin-top: 16rpx;
  padding: 4rpx 16rpx; background: var(--bg-page);
  color: var(--warning); border-radius: 8rpx; font-size: 22rpx;
}

.demand-foot { display: flex; justify-content: space-between; align-items: center; margin-top: 24rpx; }
.ago { font-size: 22rpx; color: var(--text-3); }
.take-btn { font-size: 26rpx; padding: 0 28rpx; line-height: 60rpx; }

/* 发单人模式: 发布引导卡 */
.user-hall-hero {
  padding: 48rpx 28rpx; text-align: center;
  background: linear-gradient(135deg, #FBF1E9 0%, #FFFFFF 60%);
}
.hero-title { font-size: 34rpx; font-weight: 600; color: var(--text-1); }
.hero-sub { font-size: 26rpx; color: var(--text-2); line-height: 1.6; margin: 16rpx 0 28rpx; }
.hero-btn { margin-bottom: 20rpx; }
.hero-switch {
  font-size: 24rpx; color: var(--primary);
  transition: var(--transition, 0.2s ease);
}
.hero-switch:active { opacity: 0.7; }
.hall-section {
  font-size: 28rpx; font-weight: 600; color: var(--text-1);
  margin: 8rpx 4rpx 16rpx; padding-left: 16rpx; position: relative;
}
.hall-section::before {
  content: ''; position: absolute; left: 0; top: 50%; transform: translateY(-50%);
  width: 6rpx; height: 28rpx; border-radius: 3rpx;
  background: var(--primary, #D4875A);
}
.hall-section-gap { margin-top: 32rpx; }
.take-link {
  font-size: 24rpx; color: var(--primary);
  transition: var(--transition, 0.2s ease);
}
.take-link:active { opacity: 0.7; }

/* 我接的单 */
.empty-line { font-size: 26rpx; color: var(--text-3); text-align: center; padding: 20rpx 0 28rpx; }
.myorder-card {
  padding: 24rpx 28rpx; margin-bottom: 16rpx;
  transition: var(--transition, 0.2s ease);
}
.myorder-card:active { transform: scale(0.99); }
.myorder-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.myorder-content { font-size: 28rpx; color: var(--text-1); font-weight: 500; }
.myorder-meta { display: flex; flex-direction: column; gap: 6rpx; margin-top: 12rpx; font-size: 24rpx; color: var(--text-2); }
.myorder-foot { display: flex; justify-content: space-between; align-items: center; margin-top: 14rpx; }
.mo-price { font-size: 28rpx; font-weight: 600; color: var(--primary); }
.mo-status { font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 8rpx; background: var(--bg-page); color: var(--text-3); }
.mo-status-warn { background: #F5E6D2; color: var(--warning); }
.mo-status-danger { background: #F5DAD5; color: var(--danger); }
.mo-status-success { background: #DFF0E2; color: var(--success); }
.mo-status-primary { background: rgba(212,135,90,0.12); color: var(--primary); }
.mo-status-muted { background: var(--bg-page); color: var(--text-3); }
