.page-center { padding: 24rpx 24rpx calc(env(safe-area-inset-bottom) + 40rpx); }

/* 接单开关 */
.switch-card {
  display: flex; justify-content: space-between; align-items: center;
  padding: 32rpx; border-radius: 16rpx; margin-bottom: 24rpx;
}
.switch-card.on { background: linear-gradient(135deg, #3E7C4F 0%, #356B43 100%); color: #fff; }
.switch-card.off { background: linear-gradient(135deg, #9CA3AF 0%, #6B7280 100%); color: #fff; }
.switch-status { font-size: 36rpx; font-weight: 600; }
.switch-tip { font-size: 24rpx; opacity: 0.8; margin-top: 4rpx; }

/* 统计 */
.stats-card { margin-bottom: 24rpx; }
.stats-grid { display: flex; margin-top: 16rpx; }
.stat-item { flex: 1; text-align: center; }
.stat-num { font-size: 44rpx; font-weight: 600; color: var(--primary); }
.stat-label { font-size: 22rpx; color: var(--text-2); margin-top: 4rpx; }

/* 时薪 */
.rate-display {
  font-size: 48rpx; font-weight: 600; color: var(--primary);
  text-align: center; margin: 24rpx 0;
}
.rate-display-sm {
  font-size: 32rpx; font-weight: 600; color: var(--primary);
  margin: 8rpx 0;
}

/* 场景列表(中心页) */
.scene-list-center { margin-top: 16rpx; }
.scene-row {
  border: 2rpx solid var(--border);
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}
.scene-row-header {
  display: flex; align-items: center;
  padding: 24rpx; background: var(--bg-page);
}
.scene-check {
  width: 36rpx; height: 36rpx; border-radius: 8rpx;
  border: 2rpx solid var(--border); margin-right: 16rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; color: #fff;
}
.scene-check.checked { background: var(--primary); border-color: var(--primary); }
.scene-icon { font-size: 36rpx; margin-right: 12rpx; }
.scene-name { font-size: 30rpx; color: var(--text-1); }
.scene-rate-row { padding: 16rpx 24rpx; border-top: 2rpx solid var(--border); }
.scene-rate-row slider { margin: 8rpx 0 0; }

/* 场景网格(旧,保留兼容) */
.scene-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 16rpx; }
.scene-chip {
  padding: 16rpx 24rpx; border-radius: 12rpx;
  border: 2rpx solid var(--border); background: var(--bg-page);
  display: flex; align-items: center; font-size: 26rpx;
}
.scene-chip.active { background: #F5E6DA; border-color: var(--primary); color: var(--primary); }
.chip-icon { margin-right: 8rpx; }

button.btn-block { margin-top: 16rpx; }
