/* pages/chat/chat.wxss */
.page { padding: 24rpx; min-height: 100vh; background: var(--bg-page); }

/* 会话卡片 */
.conv-card {
  display: flex; align-items: center;
  background: #fff; border-radius: 16rpx; padding: 24rpx;
  margin-bottom: 20rpx;
}
.avatar {
  width: 88rpx; height: 88rpx; border-radius: 50%;
  background: rgba(212,135,90,0.15); color: var(--primary);
  display: flex; align-items: center; justify-content: center;
  margin-right: 24rpx; flex-shrink: 0; overflow: hidden;
}
.avatar-img { width: 88rpx; height: 88rpx; border-radius: 50%; }
.avatar-text { font-size: 36rpx; font-weight: 600; }

.conv-main { flex: 1; min-width: 0; }
.conv-top {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 12rpx;
}
.conv-name { display: flex; align-items: center; min-width: 0; }
.conv-name .name {
  font-size: 30rpx; font-weight: 600; color: var(--text-1);
  max-width: 220rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.role-tag {
  font-size: 20rpx; color: var(--primary);
  background: rgba(212,135,90,0.12); border-radius: 6rpx;
  padding: 2rpx 10rpx; margin-left: 12rpx; flex-shrink: 0;
}
.scene-tag {
  font-size: 20rpx; color: var(--text-2);
  background: var(--bg-page); border-radius: 6rpx;
  padding: 2rpx 10rpx; margin-left: 8rpx; flex-shrink: 0;
}
.conv-time { font-size: 22rpx; color: #bbb; flex-shrink: 0; margin-left: 16rpx; }

.conv-bottom { display: flex; justify-content: space-between; align-items: center; }
.conv-last {
  font-size: 26rpx; color: var(--text-2);
  max-width: 480rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.unread-badge {
  min-width: 34rpx; height: 34rpx; line-height: 34rpx;
  padding: 0 8rpx; border-radius: 17rpx;
  background: #B03A2E; color: #fff;
  font-size: 20rpx; text-align: center; flex-shrink: 0; margin-left: 16rpx;
}

/* 空态 */
/* 空状态基础已提升为全局类(.empty-state), 此处仅保留页面特有按钮 */
.empty-btn {
  display: inline-block; background: var(--primary); color: #fff;
  font-size: 28rpx; border-radius: 44rpx; padding: 16rpx 64rpx;
  transition: var(--transition);
}
.empty-btn::after { border: none; }
.empty-btn:active { transform: scale(0.97); opacity: 0.9; }
.empty-link { margin-top: 32rpx; font-size: 26rpx; color: var(--text-3); }
.state-spinner {
  width: 56rpx; height: 56rpx; margin: 0 auto 24rpx;
  border: 6rpx solid rgba(212,135,90,0.2);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: chat-spin 0.8s linear infinite;
}
@keyframes chat-spin { to { transform: rotate(360deg); } }
