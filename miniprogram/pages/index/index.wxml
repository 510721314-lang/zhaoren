<view class="container">
  <!-- 顶部:问候 + 定位城市 + 装饰搜索框 -->
  <view class="home-header">
    <view class="greet-row">
      <view class="greet">{{greeting}}，需要什么帮忙？</view>
      <view class="city">📍 {{city}}</view>
    </view>
    <view class="search-box" bindtap="onSearchTap">
      <text class="search-icon">🔍</text>
      <text class="search-ph">搜索服务 / 场景</text>
    </view>
  </view>

  <!-- 场景五宫格 -->
  <view class="card">
    <view class="scene-five">
      <view wx:for="{{scenes}}" wx:key="code" class="scene-cell"
        bindtap="onSceneTap" data-code="{{item.code}}">
        <view class="scene-emoji">{{item.icon}}</view>
        <view class="scene-label">{{item.name}}</view>
      </view>
    </view>
  </view>

  <!-- 耍伴动态入口 -->
  <view class="card blog-entry" bindtap="goBlog">
    <view class="be-icon">📷</view>
    <view class="be-left">
      <view class="be-title">耍伴动态</view>
      <view class="be-sub">看看耍伴们的真实服务日常</view>
    </view>
    <view class="be-arrow">›</view>
  </view>

  <!-- 最新需求 -->
  <view wx:if="{{hasDemands}}" class="card home-block">
    <view class="hb-head">
      <text class="hb-title">📋 最新需求</text>
      <text class="hb-more" bindtap="goHall">接单大厅 ›</text>
    </view>
    <view class="hb-demand-list">
      <view wx:for="{{demands}}" wx:key="_id" class="hb-demand-item" bindtap="goHall">
        <view class="hb-demand-top">
          <text class="hb-demand-scene">{{item.scene_name}}</text>
          <text class="hb-demand-price">{{item.rate_yuan}}</text>
        </view>
        <view wx:if="{{item.hasOpts}}" class="hb-demand-opts">{{item.opts_text}}</view>
        <view class="hb-demand-meta">
          <text wx:if="{{item.location_name}}" class="hb-demand-loc">📍 {{item.location_name}}</text>
          <text class="hb-demand-time">{{item.time_text}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 活跃用户 -->
  <view wx:if="{{hasUsers}}" class="card home-block">
    <view class="hb-head">
      <text class="hb-title">👥 活跃用户</text>
    </view>
    <scroll-view scroll-x class="hb-scroll hb-avatar-row" enhanced show-scrollbar="{{false}}">
      <view wx:for="{{users}}" wx:key="openid" class="hb-user-item" bindtap="goUserHome" data-openid="{{item.openid}}">
        <image wx:if="{{item.hasAvatar}}" class="hb-user-avatar" src="{{item.avatar}}" />
        <view wx:else class="hb-user-avatar hb-avatar-default">👤</view>
        <view class="hb-user-nick">{{item.nickname}}</view>
      </view>
    </scroll-view>
  </view>

  <!-- 活跃耍伴 -->
  <view wx:if="{{hasPartners}}" class="card home-block">
    <view class="hb-head">
      <text class="hb-title">⭐ 活跃耍伴</text>
    </view>
    <scroll-view scroll-x class="hb-scroll hb-avatar-row" enhanced show-scrollbar="{{false}}">
      <view wx:for="{{partners}}" wx:key="openid" class="hb-user-item" bindtap="goPartnerHome" data-openid="{{item.openid}}">
        <image wx:if="{{item.hasAvatar}}" class="hb-user-avatar" src="{{item.avatar}}" />
        <view wx:else class="hb-user-avatar hb-avatar-default">👤</view>
        <view class="hb-user-nick">{{item.nickname}}</view>
        <view class="hb-user-score">{{item.score}}分</view>
      </view>
    </scroll-view>
  </view>

  <!-- 我的进行中订单(有 S0/S1/S2/S3 订单才显示) -->
  <view wx:if="{{hasActiveOrder}}" class="active-bar" bindtap="goActiveOrder">
    <view class="active-left">
      <view class="active-title">🔔 我的进行中订单 · {{activeCount}} 笔</view>
      <view class="active-sub">{{activeOrder.scene_name}} · {{activeOrder.time_str}} · {{activeOrder.status_name}}</view>
    </view>
    <view class="active-arrow">›</view>
  </view>

  <!-- ═══════ 首页概览: 最新动态 ═══════ -->
  <!-- 最新 BLOG(移至页面底部) -->
  <view wx:if="{{hasBlogs}}" class="card home-block">
    <view class="hb-head">
      <text class="hb-title">🔥 最新耍伴动态</text>
      <text class="hb-more" bindtap="goBlog">全部 ›</text>
    </view>
    <scroll-view scroll-x class="hb-scroll" enhanced show-scrollbar="{{false}}">
      <view wx:for="{{blogs}}" wx:key="_id" class="hb-blog-card" bindtap="goBlogDetail" data-id="{{item._id}}">
        <image wx:if="{{item.hasCover}}" class="hb-blog-cover" src="{{item.cover}}" mode="aspectFill" />
        <view wx:else class="hb-blog-cover hb-cover-empty">📷</view>
        <view class="hb-blog-body">
          <view class="hb-blog-content">{{item.content}}</view>
          <view wx:if="{{item.hasTags}}" class="hb-blog-tags">
            <text wx:for="{{item.tags}}" wx:for-item="tg" wx:key="*this" class="hb-tag">#{{tg}}</text>
          </view>
          <view class="hb-blog-meta">
            <image wx:if="{{item.hasAvatar}}" class="hb-avatar" src="{{item.author_avatar}}" />
            <view wx:else class="hb-avatar hb-avatar-default">👤</view>
            <text class="hb-nick">{{item.author_nickname}}</text>
            <text class="hb-time">{{item.time_text}}</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 安全提示卡 -->
  <view class="card safety-card">
    <view class="safety-title">🛡️ 安全提示</view>
    <view class="safety-text">请务必在公共场所履约，开启安全报备；遇到异常请使用订单页「紧急求助」。</view>
  </view>

  <!-- 测试环境声明 -->
  <view class="env-note">测试环境声明：本小程序为测试版本，所有支付均为模拟支付，不产生真实扣款。</view>

  <!-- ═══════ 搜索面板(全屏覆盖) ═══════ -->
  <view wx:if="{{showSearch}}" class="search-mask" bindtap="closeSearch">
    <view class="search-panel" catchtap="noop">
      <view class="sp-bar">
        <view class="sp-input-wrap">
          <text class="sp-icon">🔍</text>
          <input class="sp-input" focus="{{showSearch}}" value="{{keyword}}"
                 placeholder="搜索服务 / 场景，如陪诊、打卡、陪玩"
                 confirm-type="search"
                 bindinput="onSearchInput" bindconfirm="onSearchConfirm" />
          <text wx:if="{{keyword}}" class="sp-clear" bindtap="clearKeyword">✕</text>
        </view>
        <text class="sp-cancel" bindtap="closeSearch">取消</text>
      </view>

      <!-- 无关键词: 历史 + 热门服务 + 全部场景 -->
      <scroll-view wx:if="{{!keyword}}" scroll-y class="sp-body">
        <view wx:if="{{history.length}}" class="sp-sec">
          <view class="sp-sec-head">
            <text>搜索历史</text>
            <text class="sp-sec-action" bindtap="clearHistory">清空</text>
          </view>
          <view class="sp-tags">
            <view wx:for="{{history}}" wx:key="*this" class="sp-tag"
                  bindtap="onHistTap" data-kw="{{item}}">{{item}}</view>
          </view>
        </view>

        <view class="sp-sec">
          <view class="sp-sec-head"><text>热门服务</text></view>
          <view class="sp-tags">
            <view wx:for="{{hotOptions}}" wx:key="name" class="sp-tag"
                  bindtap="onOptionTap" data-name="{{item.name}}" data-scene="{{item.sceneCode}}">
              {{item.icon}} {{item.name}}
            </view>
          </view>
        </view>

        <view class="sp-sec">
          <view class="sp-sec-head"><text>全部场景</text></view>
          <view wx:for="{{sceneRows}}" wx:key="code" class="sp-row"
                bindtap="onSceneResultTap" data-code="{{item.code}}">
            <text class="sp-row-icon">{{item.icon}}</text>
            <view class="sp-row-meta">
              <view class="sp-row-title">{{item.name}}</view>
              <view class="sp-row-sub">{{item.optionsText}}</view>
            </view>
            <text class="sp-arrow">›</text>
          </view>
        </view>
      </scroll-view>

      <!-- 有关键词: 实时结果 -->
      <scroll-view wx:else scroll-y class="sp-body">
        <block wx:if="{{sceneResults.length || optionResults.length}}">
          <view wx:for="{{sceneResults}}" wx:key="code" class="sp-row"
                bindtap="onSceneResultTap" data-code="{{item.code}}">
            <text class="sp-row-icon">{{item.icon}}</text>
            <view class="sp-row-meta">
              <view class="sp-row-title">{{item.name}}</view>
              <view class="sp-row-sub">{{item.optionsText}}</view>
            </view>
            <text class="sp-arrow">›</text>
          </view>
          <view wx:for="{{optionResults}}" wx:key="key" class="sp-row"
                bindtap="onOptionTap" data-name="{{item.name}}" data-scene="{{item.sceneCode}}">
            <text class="sp-row-icon sp-row-icon-opt">🔍</text>
            <view class="sp-row-meta">
              <view class="sp-row-title">{{item.name}}</view>
              <view class="sp-row-sub">{{item.icon}} {{item.sceneName}}</view>
            </view>
            <text class="sp-arrow">›</text>
          </view>
        </block>
        <view wx:else class="sp-empty">
          <view class="sp-empty-icon">🔍</view>
          <view class="sp-empty-text">没有找到「{{keyword}}」相关服务</view>
          <view class="sp-empty-sub">换个词试试，如「陪诊」「陪玩」「打卡」</view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
