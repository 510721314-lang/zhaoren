<!-- pages/chat-detail/chat-detail.wxml - 订单会话(IM) -->
<view class="chat-page">
  <!-- 顶部订单信息条 -->
  <view class="order-bar">
    <view class="bar-line">
      <text class="scene-tag">{{sceneName}}</text>
      <text class="order-no">{{orderNo}}</text>
    </view>
    <view class="bar-tip lock" wx:if="{{!freeChat && !chatBlocked}}">🔒 四项确认完成前，仅可发送系统模板消息，禁止交换联系方式</view>
    <view class="bar-tip free" wx:elif="{{freeChat && !chatBlocked}}">✅ 已可自由沟通，消息内容经平台安全检测</view>
    <view class="bar-tip closed" wx:else>订单已取消/关闭，无法发送消息</view>
  </view>

  <!-- 消息区 -->
  <scroll-view class="msg-scroll" scroll-y scroll-into-view="{{scrollToId}}" scroll-with-animation>
    <view class="msg-list">
      <block wx:for="{{messages}}" wx:key="msg_id">
        <view class="time-divider" wx:if="{{item.show_time}}">{{item.time_str}}</view>
        <view id="{{item.anchor}}" class="msg-row {{item.is_mine ? 'mine' : 'peer'}}">
          <view class="bubble {{item.type === 'template' ? 'bubble-tpl' : ''}}">
            <view class="tpl-tag" wx:if="{{item.type === 'template'}}">系统模板</view>
            <text class="bubble-text">{{item.text}}</text>
          </view>
        </view>
      </block>
      <view class="empty-chat" wx:if="{{messages.length === 0 && !loading}}">
        <view class="empty-icon">💬</view>
        <view class="empty-hint">还没有消息，点击下方常用语开始沟通</view>
      </view>
    </view>
  </scroll-view>

  <!-- 底部输入区 -->
  <view class="composer">
    <scroll-view class="tpl-bar" scroll-x wx:if="{{!chatBlocked}}">
      <view class="tpl-chip" wx:for="{{templates}}" wx:for-item="tpl" wx:key="id" data-id="{{tpl.id}}" bindtap="sendTemplate">{{tpl.text}}</view>
    </scroll-view>
    <view class="input-row" wx:if="{{freeChat && !chatBlocked}}">
      <input class="msg-input" value="{{inputVal}}" bindinput="onInput" confirm-type="send" bindconfirm="sendText" placeholder="输入消息…" placeholder-class="input-ph" maxlength="500" />
      <view class="send-btn {{sending || !inputVal ? 'disabled' : ''}}" bindtap="sendText">发送</view>
    </view>
    <view class="locked-bar" wx:elif="{{!chatBlocked}}">🔒 完成四项确认（8/8）后开放自由聊天</view>
    <view class="locked-bar" wx:else>订单已取消/关闭</view>
  </view>
</view>
