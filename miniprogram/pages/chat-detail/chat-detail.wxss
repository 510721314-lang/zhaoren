/* pages/chat-detail/chat-detail.wxss */
.chat-page {
  display: flex; flex-direction: column;
  height: 100vh; background: var(--bg-page);
}

/* 顶部订单信息条 */
.order-bar {
  background: #fff; padding: 16rpx 24rpx;
  border-bottom: 2rpx solid var(--bg-page);
}
.bar-line { display: flex; align-items: center; margin-bottom: 8rpx; }
.scene-tag {
  background: rgba(212,135,90,0.12); color: var(--primary);
  font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 16rpx;
  margin-right: 16rpx;
}
.order-no { font-size: 22rpx; color: #bbb; }
.bar-tip { font-size: 22rpx; padding: 6rpx 0; }
.bar-tip.lock { color: #A8652A; }
.bar-tip.free { color: #3E7C4F; }
.bar-tip.closed { color: #999; }

/* 消息区 */
.msg-scroll { flex: 1; min-height: 0; }
.msg-list { padding: 24rpx 24rpx 40rpx; }

.time-divider {
  text-align: center; font-size: 22rpx; color: #bbb;
  margin: 24rpx 0 16rpx;
}

.msg-row { display: flex; margin-bottom: 24rpx; }
.msg-row.peer { justify-content: flex-start; }
.msg-row.mine { justify-content: flex-end; }

.bubble {
  max-width: 72%; padding: 18rpx 24rpx; border-radius: 20rpx;
  background: #fff; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.msg-row.mine .bubble {
  background: var(--primary); color: #fff;
  border-bottom-right-radius: 6rpx;
}
.msg-row.peer .bubble { border-bottom-left-radius: 6rpx; }
.bubble-tpl { border: 2rpx dashed rgba(212,135,90,0.4); }
.msg-row.mine .bubble-tpl { border-color: rgba(255,255,255,0.5); }

.tpl-tag {
  font-size: 18rpx; color: var(--primary);
  margin-bottom: 6rpx;
}
.msg-row.mine .tpl-tag { color: rgba(255,255,255,0.85); }
.bubble-text { font-size: 28rpx; line-height: 1.5; word-break: break-all; }

/* 空态 */
.empty-chat { text-align: center; padding-top: 120rpx; color: #bbb; }
.empty-icon { font-size: 72rpx; margin-bottom: 16rpx; }
.empty-hint { font-size: 24rpx; }

/* 底部输入区 */
.composer {
  background: #fff; border-top: 2rpx solid var(--bg-page);
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}
.tpl-bar { white-space: nowrap; margin-bottom: 16rpx; }
.tpl-chip {
  display: inline-block;
  font-size: 24rpx; color: var(--primary);
  background: rgba(212,135,90,0.1);
  border: 2rpx solid rgba(212,135,90,0.35);
  border-radius: 32rpx; padding: 10rpx 24rpx;
  margin-right: 16rpx;
}
.tpl-chip:active { background: rgba(212,135,90,0.25); }

.input-row { display: flex; align-items: center; }
.msg-input {
  flex: 1; background: var(--bg-page);
  border-radius: 36rpx; padding: 16rpx 28rpx;
  font-size: 28rpx; min-height: 64rpx;
}
.input-ph { color: #bbb; }
.send-btn {
  margin-left: 16rpx; flex-shrink: 0;
  background: var(--primary); color: #fff;
  font-size: 28rpx; border-radius: 36rpx;
  padding: 14rpx 40rpx;
}
.send-btn.disabled { opacity: 0.5; }

.locked-bar {
  text-align: center; font-size: 24rpx; color: #999;
  padding: 16rpx 0;
}
