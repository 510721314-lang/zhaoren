<view class="page-blog">
  <!-- 顶部 推荐/我的 切换 -->
  <view class="scope-bar">
    <view class="scope-item {{scope==='feed'?'scope-on':''}}" bindtap="switchScope" data-scope="feed">推荐</view>
    <view class="scope-item {{scope==='my'?'scope-on':''}}" bindtap="switchScope" data-scope="my">我的动态</view>
  </view>

  <!-- 场景筛选(仅广场) -->
  <scroll-view wx:if="{{scope==='feed'}}" class="scene-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="scene-row">
      <view wx:for="{{sceneOpts}}" wx:key="code"
            class="scene-chip {{activeScene===item.code?'chip-on':''}}"
            bindtap="switchScene" data-code="{{item.code}}">{{item.name}}</view>
    </view>
  </scroll-view>

  <!-- 话题筛选(仅广场) -->
  <scroll-view wx:if="{{scope==='feed'}}" class="scene-scroll topic-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="scene-row">
      <view wx:for="{{topicOpts}}" wx:key="val"
            class="topic-chip {{activeTopic===item.val?'topic-on':''}}"
            bindtap="switchTopic" data-val="{{item.val}}">{{item.name}}</view>
    </view>
  </scroll-view>

  <!-- 加载骨架/列表 -->
  <view class="feed-wrap">
    <block wx:if="{{loading}}">
      <view class="sk-row">
        <view class="skeleton sk-circle"></view>
        <view style="flex:1; margin-left:20rpx;">
          <view class="skeleton sk-line"></view>
          <view class="skeleton sk-line-sm"></view>
        </view>
      </view>
      <view class="skeleton sk-card"></view>
      <view class="skeleton sk-card"></view>
    </block>

    <block wx:elif="{{showEmpty}}">
      <view class="empty-state">
        <view class="empty-icon">📭</view>
        <view class="empty-text">{{scope==='my' ? '你还没有发布动态' : '还没有动态'}}</view>
        <view class="empty-sub">{{scope==='my' ? '点右下角写一条吧' : '来发布第一条吧'}}</view>
        <view class="empty-btn">
          <button class="btn-primary" hover-class="btn-press" bindtap="goPublish">写动态</button>
        </view>
      </view>
    </block>

    <block wx:else>
      <view wx:for="{{list}}" wx:key="_id" class="post-card fade-in-up" style="animation-delay:{{index * 0.04}}s;" bindtap="goDetail" data-id="{{item._id}}">
        <!-- 作者行 -->
        <view class="post-head">
          <image wx:if="{{item.hasAvatar}}" class="avatar" src="{{item.author_avatar}}" mode="aspectFill"
                 catchtap="goAuthor" data-openid="{{item.authorOpenid}}" />
          <view wx:else class="avatar avatar-default" catchtap="goAuthor" data-openid="{{item.authorOpenid}}">👤</view>
          <view class="head-mid">
            <view class="head-name">
              <text class="nick" catchtap="goAuthor" data-openid="{{item.authorOpenid}}">{{item.author_nickname}}</text>
              <text wx:if="{{item.isPartner}}" class="partner-badge">认证耍伴</text>
            </view>
            <view class="head-sub">
              <text wx:if="{{item.hasScene}}" class="scene-tag">{{item.sceneName}}</text>
              <text class="time">{{item.timeText}}</text>
            </view>
          </view>
          <text wx:if="{{item.offline}}" class="offline-flag">已下架</text>
        </view>

        <!-- 正文 -->
        <view class="post-content">{{item.content}}</view>

        <!-- 话题标签 -->
        <view wx:if="{{item.hasTags}}" class="topic-row">
          <text wx:for="{{item.tags}}" wx:for-item="tg" wx:key="*this" class="topic-tag">#{{tg}}</text>
        </view>

        <!-- 图片: 单图大图 / 多图九宫格 -->
        <view wx:if="{{item.single}}" class="img-single-wrap">
          <image class="img-single" src="{{item.images[0]}}" mode="widthFix" lazy-load
                 catchtap="previewImage" data-current="{{item.images[0]}}" data-urls="{{item.images}}" />
        </view>
        <view wx:elif="{{item.multi}}" class="img-grid img-grid-{{item.imgCount>=3 ? 3 : 2}}">
          <image wx:for="{{item.images}}" wx:for-item="img" wx:for-index="ii" wx:key="ii"
                 class="grid-img" src="{{img}}" mode="aspectFill" lazy-load
                 catchtap="previewImage" data-current="{{img}}" data-urls="{{item.images}}" />
        </view>

        <!-- 互动栏 -->
        <view class="post-foot">
          <view class="foot-item {{item.likeCls}}">♡ {{item.likeCount}}</view>
          <view class="foot-item">💬 {{item.commentCount}}</view>
        </view>
      </view>

      <!-- 加载更多 -->
      <view wx:if="{{hasMore}}" class="load-more" catchtap="loadList">加载更多</view>
      <view wx:else class="no-more">没有更多了</view>
    </block>
  </view>

  <!-- 悬浮发布按钮 -->
  <view class="fab" bindtap="goPublish">＋ 发布</view>
</view>
