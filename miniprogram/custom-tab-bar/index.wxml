<view class="tabbar">
  <view class="tabbar__tabs">
    <view
      wx:for="{{list}}"
      wx:key="pagePath"
      class="tabbar__item {{selected === index ? 'is-on' : ''}}"
      data-path="{{item.pagePath}}"
      data-index="{{index}}"
      bindtap="switchTab"
    >
      <view class="tabbar__icon">{{item.icon}}</view>
      <view class="tabbar__text">{{item.text}}</view>
    </view>
  </view>

  <view class="tabbar__pub" bindtap="goPublish">
    <view class="tabbar__pub-circle">＋</view>
    <view class="tabbar__pub-text">发布</view>
  </view>
</view>
