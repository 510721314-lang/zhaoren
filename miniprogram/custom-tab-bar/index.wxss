/* 2026-11-15: 自定义 tabBar 为独立渲染层, 取不到 tokens.wxss 里 page{} 作用域的 CSS 变量,
   var(--x) 全部解析失败(背景透明/发布钮无绿底/字色字号失效)。本文件改为字面值 + 暗色媒体查询,
   色值须与 styles/tokens.wxss 手工同步。 */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #FFFFFF;
  border-top: 1rpx solid #F0F0F0;
  z-index: 200;
}
.tabbar__tabs {
  display: flex;
  align-items: flex-start;
  height: 100rpx;
}
.tabbar__item {
  flex: 1;
  text-align: center;
  padding-top: 12rpx;
  color: #9AA0A6;
}
.tabbar__item.is-on {
  color: #07C160;
}
.tabbar__icon {
  font-size: 44rpx;
  line-height: 44rpx;
}
.tabbar__text {
  margin-top: 2rpx;
  font-size: 20rpx;
  line-height: 28rpx;
}
.tabbar__pub {
  position: absolute;
  left: 50%; /* 2026-11-21: 发布钮水平居中于「服务」(50%)正上方；bottom 抬高使圆与 tab 图标垂直分离不压字 */
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  transform: translateX(-50%);
  width: 120rpx;
  text-align: center;
}
.tabbar__pub-circle {
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: #07C160;
  color: #FFFFFF;
  font-size: 40rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 8rpx 20rpx rgba(7,193,96,0.4);
}
.tabbar__pub-text {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #07C160;
  font-weight: 600;
}

/* 暗色模式: 与 tokens.wxss 暗色变量手工同步 */
@media (prefers-color-scheme: dark) {
  .tabbar {
    background: #1E2126;
    border-top-color: #2A2E36;
  }
  .tabbar__item { color: #5A616A; }
  .tabbar__item.is-on { color: #07C160; }
  .tabbar__pub-circle {
    color: #1A1D21;
    border-color: #1E2126;
    box-shadow: 0 12rpx 28rpx rgba(7,193,96,0.3);
  }
  .tabbar__pub-text { color: #07C160; }
}
