/* styles/tokens.wxss · V15.1 全局唯一视觉数据源（SSOT）
 * 来源：design-tokens.md / home.html 风格锚点
 * 规则：页面/组件 wxss 禁止硬编码色值字号，一律引用本文件变量
 * 基准：750rpx = 375px，2rpx = 1px
 * 注意：工具类统一加 .v2 作用域，避免污染旧版橙色主题页面
 */

page {
  /* 1.1 品牌色 */
  --brand-primary: #07C160;
  --brand-primary-press: #06AD56;
  --brand-primary-light: #F0FBF4;
  --brand-accent: #ff6b35;
  --brand-accent-light: #FFF3E0;

  /* 1.2 功能色 */
  --func-danger: #fa5151;
  --func-danger-light: #FFE9EC;
  --func-warning: #ff8f3c;
  --func-warning-light: #FFF7E8;
  --func-success: #0a8f4d;
  --func-success-light: #E8F7EE;
  --func-info: #2f6fed;
  --func-info-light: #E8F1FF;
  --func-purple: #6b4fe8;
  --func-purple-light: #EDE8FF;

  /* 1.3 文字色 */
  --text-1: #222222;
  --text-2: #444444;
  --text-3: #666666;
  --text-4: #8a9099;
  --text-5: #9aa0a6;
  --text-disabled: #c0c5cc;

  /* 反色文字（深底/品牌色按钮上的白字） */
  --text-invert: #ffffff;

  /* 1.4 背景与边框 */
  --bg-page: #F6F7F9;
  --bg-card: #FFFFFF;
  --bg-input: #FAFAFB;
  --bg-segment: #F1F2F5;
  --bg-mask: rgba(0,0,0,0.45);
  --bg-night: rgba(15,20,30,0.82);
  --border-1: #e5e7eb;
  --border-2: #f0f0f0;
  --border-divider: #f5f5f5;

  /* 补充色（锚点中出现但未编号的色值，统一收口在此） */
  --border-ghost: #d9dce1;
  --btn-disabled-bg: #DCE3DA;
  --sheet-handle: #E0E0E0;
  --progress-todo: #e5e7eb;
  --text-aa: #B26A00;
  --cert-border: #7fd7a8;
  --avatar-bg: #DCE9E4;
  --cell-gray-bg: #f2f3f5;
  --banner-grad-start: #FFF3E0;
  --banner-grad-end: #FFE0B2;
  --text-banner-sub: #c68a2e;

  /* 场景底色（一期5场景，与 config/enums.js SCENES.color 同源） */
  --scene-medical-bg: #E8F1FF;
  --scene-study-bg: #EDE8FF;
  --scene-life-bg: #FFF3E0;
  --scene-travel-bg: #E0F5F4;
  --scene-online-bg: #FFE9EC;
  /* 场景深字色（与浅底配套） */
  --scene-medical-text: #2f6fed;
  --scene-study-text: #6b4fe8;
  --scene-life-text: #B26A00;
  --scene-travel-text: #0e8c84;
  --scene-online-text: #d43f4f;

  /* 2. 字体 */
  --font-xxs: 18rpx;
  --font-xs: 20rpx;
  --font-sm: 22rpx;
  --font-base: 24rpx;
  --font-md: 26rpx;
  --font-lg: 28rpx;
  --font-xl: 30rpx;
  --font-xxl: 34rpx;
  --font-display: 38rpx;
  --font-display-lg: 44rpx;
  --font-2xl: 56rpx;
  --font-display-xl: 52rpx;
  --font-display-xxl: 72rpx;
  --font-icon-md: 80rpx;
  --font-icon-lg: 96rpx;

  /* 3. 间距 */
  --sp-xs: 8rpx;
  --sp-sm: 16rpx;
  --sp-md: 20rpx;
  --sp-lg: 28rpx;
  --sp-xl: 40rpx;
  --page-pad: 20rpx;
  --card-pad: 24rpx 28rpx;
  --card-gap: 20rpx;

  /* 4. 圆角 */
  --r-sm: 16rpx;
  --r-md: 24rpx;
  --r-lg: 28rpx;
  --r-xl: 32rpx;

  /* 5. 阴影 */
  --shadow-card: 0 2rpx 12rpx rgba(0,0,0,0.04);
  --shadow-float: 0 12rpx 28rpx rgba(0,0,0,0.15);
  --shadow-pub: 0 12rpx 28rpx rgba(7,193,96,0.4);
}

/* ═══════════ V15 工具类（.v2 作用域，新页面根节点统一挂 class="v2"） ═══════════ */

.v2 { min-height: 100vh; background: var(--bg-page); color: var(--text-2); }

/* 文字 */
.v2 .text-xs { font-size: var(--font-xs); }
.v2 .text-sm { font-size: var(--font-sm); }
.v2 .text-base { font-size: var(--font-base); }
.v2 .text-md { font-size: var(--font-md); }
.v2 .text-lg { font-size: var(--font-lg); }
.v2 .text-xl { font-size: var(--font-xl); }
.v2 .text-xxl { font-size: var(--font-xxl); }
.v2 .text-1 { color: var(--text-1); }
.v2 .text-2 { color: var(--text-2); }
.v2 .text-3 { color: var(--text-3); }
.v2 .text-4 { color: var(--text-4); }
.v2 .text-5 { color: var(--text-5); }
.v2 .text-danger { color: var(--func-danger); }
.v2 .text-brand { color: var(--brand-primary); }
.v2 .text-warning { color: var(--func-warning); }
.v2 .text-info { color: var(--func-info); }
.v2 .bold { font-weight: 600; }
.v2 .bold-700 { font-weight: 700; }
.v2 .ellipsis { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

/* 卡片 */
.v2 .card {
  background: var(--bg-card);
  border-radius: var(--r-lg);
  padding: var(--card-pad);
  box-shadow: var(--shadow-card);
  margin-bottom: var(--card-gap);
}

/* 按钮 */
.v2 .btn-primary {
  background: var(--brand-primary);
  color: var(--text-invert);
  font-size: var(--font-md);
  font-weight: 600;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: var(--r-md);
  text-align: center;
  padding: 0;
}
.v2 .btn-primary.button-hover { background: var(--brand-primary-press); }
.v2 .btn-primary[disabled],
.v2 .btn-primary[disabled][button-hover] { background: var(--btn-disabled-bg); color: var(--text-invert); }
.v2 .btn-ghost {
  background: var(--bg-card);
  color: var(--text-3);
  border: 1rpx solid var(--border-ghost);
  font-size: var(--font-md);
  height: 76rpx;
  line-height: 74rpx;
  border-radius: var(--r-md);
  text-align: center;
  padding: 0;
}
.v2 .btn-danger {
  background: var(--func-danger);
  color: var(--text-invert);
  font-size: var(--font-md);
  font-weight: 600;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: var(--r-md);
  text-align: center;
  padding: 0;
}
.v2 .btn-mini {
  display: inline-block;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 32rpx;
  border-radius: 28rpx;
  background: var(--brand-primary);
  color: var(--text-invert);
  font-size: var(--font-sm);
  font-weight: 600;
}
.v2 .btn-mini.gray { background: var(--bg-segment); color: var(--text-5); }
.v2 .btn-mini[disabled] { background: var(--bg-segment); color: var(--text-5); }

/* 通用 tag（场景/公益/AA 在组件内实现，此处仅兜底） */
.v2 .tag-gongyi {
  background: var(--func-success-light);
  color: var(--func-success);
  font-weight: 600;
}
